{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR168-GFP Formula Assignment Row",
  "type": "object",
  "required": ["canonical_row_key", "row_family", "formula_id", "required_formula_set_id", "formula_ids", "formula_status", "owning_agent", "downstream_route", "no_orphan_ref"],
  "properties": {
    "canonical_row_key": {"type": "string", "minLength": 1},
    "row_family": {"type": "string", "minLength": 1},
    "formula_id": {"type": "string", "minLength": 1},
    "required_formula_set_id": {"type": "string", "minLength": 1},
    "formula_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "formula_status": {"type": "string", "not": {"enum": ["FORMULA_MISSING", "PLACEHOLDER_ONLY", "METADATA_ONLY", "TODO_FORMULA", "FORMULA_NAME_ONLY"]}},
    "owning_agent": {"type": "string", "minLength": 1},
    "downstream_route": {"type": "string", "minLength": 1},
    "no_orphan_ref": {"type": "string", "minLength": 1}
  }
}

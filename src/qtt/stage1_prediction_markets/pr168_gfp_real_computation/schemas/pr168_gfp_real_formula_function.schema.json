    "formula_expression": {"type": "string", "minLength": 3},
    "formula_source_ref": {"type": "string", "minLength": 1},
    "formula_source_class": {"type": "string", "minLength": 1},
    "computation_function_path": {"type": "string", "minLength": 1},
    "computation_function_name": {"type": "string", "minLength": 1},
    "variable_map": {"type": "object", "minProperties": 1},
    "input_schema": {"type": "object", "minProperties": 1},
    "output_schema": {"type": "object", "minProperties": 1},
    "source_truth_accepted": {"const": false}
  }
}

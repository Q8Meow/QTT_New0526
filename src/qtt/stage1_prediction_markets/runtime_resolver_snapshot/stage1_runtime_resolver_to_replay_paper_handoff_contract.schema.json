      "type": "string",
      "minLength": 1
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "handoff_state": {
      "enum": [
        "READY_FOR_CONCURRENT_REPLAY_PAPER_INPUT_LOCK_GATE_ONLY",
        "BLOCKED_FORBIDDEN_CONSUMER",
        "BLOCKED_STALE_SNAPSHOT",
        "BLOCKED_STALE_INPUT_LOCK",
        "BLOCKED_SUPERSEDED_SNAPSHOT",
        "BLOCKED_SUPERSEDED_INPUT_LOCK",
        "BLOCKED_CONFLICT_STATE",
        "BLOCKED_TARGET_MISMATCH",
        "BLOCKED_DIGEST_MISMATCH",
        "BLOCKED_SNAPSHOT_PACKET_MISSING",
        "BLOCKED_INPUT_LOCK_MISSING",
        "BLOCKED_SNAPSHOT_GATE_REPORT_MISSING",
        "BLOCKED_CONSUMER_ALLOWLIST_MISSING",
        "BLOCKED_SCHEMA_ERROR",
        "BLOCKED_REPLAY_PAPER_EXECUTION_CLAIM",
        "BLOCKED_REPLAY_PAPER_RESULT_PACKET_CLAIM",
        "BLOCKED_LIVE_ORDER_RUNTIME_CASH_PROFIT_CLAIM",
        "BLOCKED_ATOMICROWS_BUNDLE_HASH_MUTATION_CLAIM",
        "BLOCKED_BLOCKER_REDUCTION_CLAIM"
      ]
    },
    "snapshot_packet_reference": {
      "type": "object",
      "properties": {
        "snapshot_packet_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "snapshot_packet_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "freshness_state": {
          "enum": [
            "CURRENT",
            "STALE",
            "SUPERSEDED",
            "MISSING",
            "SCHEMA_ERROR"
          ]
        },
        "revalidation_state": {
          "enum": [
            "CURRENT",
            "REVALIDATION_REQUIRED",
            "SUPERSEDED",
            "MISSING",
            "SCHEMA_ERROR"
          ]
        },
        "conflict_state": {
          "enum": [
            "NO_CONFLICT",
            "CONFLICT_PRESENT",
            "MISSING",
            "SCHEMA_ERROR"
          ]
        },
        "target_match_state": {
          "enum": [
            "MATCHED",
            "TARGET_MISMATCH",
            "MISSING",
            "SCHEMA_ERROR"
          ]
        },
        "schema_state": {
          "enum": [
            "SCHEMA_VALID",
            "SCHEMA_ERROR",
            "MISSING"
          ]
        }
      },
      "required": [
        "snapshot_packet_id",
        "snapshot_packet_digest",
        "freshness_state",
        "revalidation_state",
        "conflict_state",
        "target_match_state",
        "schema_state"
      ],
      "additionalProperties": false
    },
    "snapshot_input_lock_reference": {
      "type": "object",
      "properties": {
        "input_lock_id": {
          "$ref": "#/$defs/non_empty_string"
        },

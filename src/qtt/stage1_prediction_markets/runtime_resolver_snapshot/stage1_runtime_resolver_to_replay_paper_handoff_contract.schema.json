          "$ref": "#/$defs/sha256_digest"
        },
        "target_field_acceptance_ledger_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "runtime_resolver_input_identity_gate_digest": {
          "$ref": "#/$defs/sha256_digest"
        },

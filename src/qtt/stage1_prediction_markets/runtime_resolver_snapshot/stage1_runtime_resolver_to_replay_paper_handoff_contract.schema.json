{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/src/qtt/stage1_prediction_markets/runtime_resolver_snapshot/stage1_runtime_resolver_to_replay_paper_handoff_contract.schema.json",
  "title": "Stage-1 Runtime Resolver To Concurrent Replay/Paper Handoff Static Contract Schema",
  "description": "Static handoff contract from a future green runtime resolver snapshot to the concurrent replay/paper input-lock gate only. It verifies references and matching digests without executing replay or paper, creating result packets, creating dual-result review, selecting new contracts/events/markets, mutating resolver snapshot contents, creating live reachability, creating order authority, creating runtime cash claims, mutating AtomicRows, reducing blockers, or claiming profit evidence.",
  "type": "object",
  "properties": {
    "handoff_record_type": {
      "const": "STAGE1_RUNTIME_RESOLVER_TO_CONCURRENT_REPLAY_PAPER_HANDOFF"
    },
    "handoff_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "fixture_case": {
      "$ref": "#/$defs/non_empty_string"
    },
    "record_authority_class": {
      "const": "STATIC_RUNTIME_RESOLVER_TO_REPLAY_PAPER_HANDOFF_CONTRACT_ONLY_NOT_RUNTIME_AUTHORITY"
    },
    "synthetic_data_notice": {
      "const": "SYNTHETIC_PLACEHOLDER_ONLY_NO_REAL_SOURCE_NO_REAL_ACCEPTED_FACT"
    },
    "master_plan_edition": {
      "$ref": "#/$defs/non_empty_string"
    },
    "master_plan_sha256": {
      "$ref": "#/$defs/sha256_digest"
    },
    "requested_immediate_consumer_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "requested_immediate_consumer_class": {
      "$ref": "#/$defs/non_empty_string"
    },
    "allowed_next_consumer_task_packet_id": {
      "const": "CONCURRENT_REPLAY_PAPER_INPUT_LOCK_GATE_ONLY"
    },
    "allowed_next_consumer_section_id": {
      "const": "0X.4T_INPUT_LOCK_GATE_ONLY"
    },
    "handoff_state": {
      "$ref": "#/$defs/handoff_state"
    },
    "handoff_authorization_state": {
      "$ref": "#/$defs/non_empty_string"
    },
    "runtime_resolver_snapshot_packet_reference": {
      "$ref": "#/$defs/snapshot_packet_reference"
    },
    "runtime_resolver_snapshot_input_lock_reference": {
      "$ref": "#/$defs/snapshot_input_lock_reference"
    },
    "runtime_resolver_snapshot_gate_report_reference": {
      "$ref": "#/$defs/snapshot_gate_report_reference"
    },
    "runtime_resolver_snapshot_consumer_allowlist_reference": {
      "$ref": "#/$defs/consumer_allowlist_reference"
    },
    "upstream_digest_contract": {
      "$ref": "#/$defs/upstream_digest_contract"
    },
    "matching_identity_contract": {
      "$ref": "#/$defs/matching_identity_contract"
    },
    "handoff_boundary_flags": {
      "$ref": "#/$defs/handoff_boundary_flags"
    },
    "blocker_codes": {
      "$ref": "#/$defs/blocker_codes"
    },
    "receipt_ids": {
      "$ref": "#/$defs/receipt_ids"
    },
    "no_claim_flags": {
      "$ref": "stage1_runtime_resolver_snapshot_consumer_allowlist.schema.json#/$defs/no_claim_flags"
    },
    "validation_hook_ids": {
      "$ref": "stage1_runtime_resolver_snapshot_consumer_allowlist.schema.json#/$defs/validation_hook_ids"
    }
  },
  "required": [
    "handoff_record_type",
    "handoff_id",
    "fixture_case",
    "record_authority_class",
    "synthetic_data_notice",
    "master_plan_edition",

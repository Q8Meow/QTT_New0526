        "snapshot_packet_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "snapshot_packet_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "freshness_state": {
          "enum": [
            "CURRENT",
            "STALE",
            "SUPERSEDED",
            "MISSING",
            "SCHEMA_ERROR"
          ]
        },
        "revalidation_state": {
          "enum": [
            "CURRENT",
            "REVALIDATION_REQUIRED",
            "SUPERSEDED",
            "MISSING",
            "SCHEMA_ERROR"
          ]
        },
        "schema_state": {
          "enum": [
            "SCHEMA_VALID",
            "SCHEMA_ERROR",
            "MISSING"
          ]
        }
      },
      "required": [
        "input_lock_id",
        "input_lock_digest",
        "snapshot_packet_id",
        "snapshot_packet_digest",
        "freshness_state",
        "revalidation_state",
        "schema_state"
      ],
      "additionalProperties": false
    },
    "snapshot_gate_report_reference": {
      "type": "object",
      "properties": {
        "snapshot_gate_report_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "snapshot_gate_report_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "snapshot_packet_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "snapshot_packet_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "gate_state": {
          "enum": [
            "GREEN",
            "RED",
            "MISSING",
            "SCHEMA_ERROR"
          ]
        }
      },
      "required": [
        "snapshot_gate_report_id",
        "snapshot_gate_report_digest",
        "snapshot_packet_id",
        "snapshot_packet_digest",
        "gate_state"
      ],
      "additionalProperties": false
    },
    "consumer_allowlist_reference": {
      "type": "object",
      "properties": {
        "consumer_allowlist_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "consumer_allowlist_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "snapshot_packet_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "snapshot_packet_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "allowlist_state": {
          "enum": [
            "ALLOWLISTED",
            "MISSING",
            "SCHEMA_ERROR"
          ]
        }
      },
      "required": [
        "consumer_allowlist_id",
        "consumer_allowlist_digest",
        "snapshot_packet_id",
        "snapshot_packet_digest",
        "allowlist_state"
      ],

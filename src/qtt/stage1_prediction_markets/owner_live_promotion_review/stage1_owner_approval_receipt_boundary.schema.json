{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/src/qtt/stage1_prediction_markets/owner_live_promotion_review/stage1_owner_approval_receipt_boundary.schema.json",
  "title": "Stage-1 Owner Approval Receipt Boundary Static Schema",
  "description": "Static PR45 owner approval receipt boundary. Receipt creation is blocked in PR45 and creates no live eligibility, canary eligibility, live reachability, order execution, runtime cash claim, AtomicRows bundle/hash, blocker reduction, or profit claim.",
  "type": "object",
  "properties": {
    "owner_approval_receipt_boundary_type": {
      "const": "STAGE1_OWNER_APPROVAL_RECEIPT_BOUNDARY"
    },
    "owner_approval_receipt_boundary_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "fixture_case": {
      "$ref": "#/$defs/non_empty_string"
    },
    "record_authority_class": {
      "const": "STATIC_OWNER_APPROVAL_RECEIPT_BOUNDARY_ONLY_NOT_OWNER_APPROVAL_AUTHORITY"
    },
    "synthetic_data_notice": {
      "const": "SYNTHETIC_PLACEHOLDER_ONLY_NO_REAL_SOURCE_NO_REAL_ACCEPTED_FACT"
    },
    "master_plan_edition": {
      "$ref": "#/$defs/non_empty_string"
    },
    "master_plan_sha256": {
      "$ref": "#/$defs/sha256_digest"
    },
    "owner_approval_receipt_creation_authority_state": {
      "const": "BLOCKED_STATIC_CONTRACT_ONLY"
    },
    "owner_approval_receipt_created_flag": {
      "const": false
    },
    "owner_approval_decision_created_flag": {
      "const": false
    },
    "owner_approval_receipt_required_before_live_eligibility_flag": {
      "const": true
    },
    "live_eligibility_allowed_flag": {
      "const": false
    },
    "three_venue_canary_eligibility_allowed_flag": {
      "const": false
    },
    "live_reachability_allowed_flag": {
      "const": false
    },
    "order_execution_allowed_flag": {
      "const": false
    },
    "runtime_cash_claim_allowed_flag": {
      "const": false
    },
    "profit_claim_allowed_flag": {
      "const": false
    },
    "atomicrows_bundle_hash_created_or_mutated_flag": {
      "const": false
    },
    "blocker_reduction_claim_allowed_flag": {
      "const": false
    },
    "owner_live_promotion_review_auto_approval_allowed": {
      "const": false
    },
    "owner_live_promotion_review_auto_promotion_allowed": {
      "const": false
    },
    "blocker_codes": {
      "$ref": "#/$defs/blocker_codes"
    },
    "receipt_ids": {
      "$ref": "#/$defs/receipt_ids"
    },
    "no_claim_flags": {
      "$ref": "#/$defs/no_claim_flags"
    },
    "validation_hook_ids": {
      "$ref": "#/$defs/validation_hook_ids"
    }
  },
  "required": [
    "owner_approval_receipt_boundary_type",
    "owner_approval_receipt_boundary_id",
    "fixture_case",
    "record_authority_class",
    "synthetic_data_notice",
    "master_plan_edition",
    "master_plan_sha256",
    "owner_approval_receipt_creation_authority_state",
    "owner_approval_receipt_created_flag",
    "owner_approval_decision_created_flag",
    "owner_approval_receipt_required_before_live_eligibility_flag",
    "live_eligibility_allowed_flag",
    "three_venue_canary_eligibility_allowed_flag",
    "live_reachability_allowed_flag",
    "order_execution_allowed_flag",
    "runtime_cash_claim_allowed_flag",
    "profit_claim_allowed_flag",
    "atomicrows_bundle_hash_created_or_mutated_flag",
    "blocker_reduction_claim_allowed_flag",
    "owner_live_promotion_review_auto_approval_allowed",
    "owner_live_promotion_review_auto_promotion_allowed",
    "blocker_codes",
    "receipt_ids",
    "no_claim_flags",
    "validation_hook_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blocker_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "receipt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "validation_hook_ids": {
      "type": "array",
      "prefixItems": [
        {
          "const": "STAGE1_OWNER_LIVE_PROMOTION_REVIEW_CONTRACT_STATIC_AUDIT"
        }
      ],
      "items": false
    },
    "no_claim_flags": {
      "type": "object",
      "additionalProperties": {
        "const": false
      }
    }
  }
}

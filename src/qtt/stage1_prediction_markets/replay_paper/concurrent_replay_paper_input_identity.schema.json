{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/src/qtt/stage1_prediction_markets/replay_paper/concurrent_replay_paper_input_identity.schema.json",
  "title": "Stage-1 Concurrent Replay/Paper Input Identity Static Schema",
  "description": "Static synthetic input identity contract for replay and paper lanes after a future runtime resolver snapshot handoff. It creates no real input lock, runtime resolver snapshot, replay or paper execution, result packet, dual-result review, live reachability, order authority, runtime cash claim, AtomicRows mutation, blocker reduction, or profit evidence.",
  "type": "object",
  "properties": {
    "input_identity_record_type": {
      "const": "STAGE1_CONCURRENT_REPLAY_PAPER_INPUT_IDENTITY"
    },
    "input_identity_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "fixture_case": {
      "$ref": "#/$defs/non_empty_string"
    },
    "record_authority_class": {
      "const": "STATIC_CONCURRENT_REPLAY_PAPER_INPUT_IDENTITY_CONTRACT_ONLY_NOT_RUNTIME_AUTHORITY"
    },
    "synthetic_data_notice": {
      "const": "SYNTHETIC_PLACEHOLDER_ONLY_NO_REAL_SOURCE_NO_REAL_ACCEPTED_FACT"
    },
    "master_plan_edition": {
      "$ref": "#/$defs/non_empty_string"
    },
    "master_plan_sha256": {
      "$ref": "#/$defs/sha256_digest"
    },
    "runtime_resolver_snapshot_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "runtime_resolver_snapshot_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "runtime_resolver_input_lock_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "runtime_resolver_input_lock_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "runtime_resolver_to_replay_paper_handoff_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "runtime_resolver_to_replay_paper_handoff_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "runtime_resolver_handoff_gate_report_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "runtime_resolver_handoff_gate_report_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "replay_paper_input_identity_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "candidate_contract_identity_set": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "candidate_contract_identity_set_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "venue_normalization_identity_set": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "venue_normalization_identity_set_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "source_connector_semantic_gate_receipt_refs": {
      "$ref": "#/$defs/source_connector_receipts"
    },
    "replay_lane_input_identity_ref": {
      "$ref": "#/$defs/lane_input_identity_ref"
    },
    "paper_lane_input_identity_ref": {
      "$ref": "#/$defs/lane_input_identity_ref"
    },
    "input_identity_state": {
      "enum": [
        "STATIC_INPUT_IDENTITY_VALID_FOR_GATE_ONLY",
        "BLOCKED_MISSING_RUNTIME_RESOLVER_SNAPSHOT_REFERENCE",
        "BLOCKED_MISSING_RUNTIME_RESOLVER_INPUT_LOCK_REFERENCE",
        "BLOCKED_MISSING_HANDOFF_GATE_REPORT_REFERENCE",
        "BLOCKED_INPUT_IDENTITY_MISMATCH",
        "BLOCKED_STALE_SUPERSEDED_CONFLICT_SCHEMA_OR_TARGET_MISMATCH"
      ]
    },
    "replay_lane_and_paper_lane_must_share_input_identity_flag": {
      "const": true
    },
    "replay_lane_and_paper_lane_must_remain_separate_flag": {
      "const": true
    },
    "replay_result_packet_may_not_overwrite_paper_result_packet_flag": {
      "const": true
    },
    "paper_result_packet_may_not_overwrite_replay_result_packet_flag": {
      "const": true
    },
    "combined_result_packet_allowed_flag": {
      "const": false
    },
    "lane_result_merge_allowed_flag": {
      "const": false
    },
    "mutation_allowed_flag": {
      "const": false
    },
    "live_reachability_allowed_flag": {
      "const": false
    },
    "order_execution_allowed_flag": {
      "const": false
    },
    "runtime_cash_claim_allowed_flag": {
      "const": false
    },
    "profit_claim_allowed_flag": {
      "const": false
    },
    "atomicrows_bundle_mutation_allowed_flag": {
      "const": false
    },
    "blocker_reduction_claim_allowed_flag": {
      "const": false
    },
    "blocker_codes": {
      "$ref": "#/$defs/blocker_codes"
    },
    "receipt_ids": {
      "$ref": "#/$defs/receipt_ids"
    },
    "no_claim_flags": {
      "$ref": "#/$defs/no_claim_flags"
    },
    "validation_hook_ids": {
      "$ref": "#/$defs/validation_hook_ids"
    }
  },
  "required": [
    "input_identity_record_type",
    "input_identity_id",
    "fixture_case",
    "record_authority_class",
    "synthetic_data_notice",
    "master_plan_edition",
    "master_plan_sha256",
    "runtime_resolver_snapshot_id",
    "runtime_resolver_snapshot_digest",
    "runtime_resolver_input_lock_id",
    "runtime_resolver_input_lock_digest",
    "runtime_resolver_to_replay_paper_handoff_id",
    "runtime_resolver_to_replay_paper_handoff_digest",
    "runtime_resolver_handoff_gate_report_id",
    "runtime_resolver_handoff_gate_report_digest",
    "replay_paper_input_identity_digest",
    "candidate_contract_identity_set",
    "candidate_contract_identity_set_digest",
    "venue_normalization_identity_set",
    "venue_normalization_identity_set_digest",
    "source_connector_semantic_gate_receipt_refs",
    "replay_lane_input_identity_ref",
    "paper_lane_input_identity_ref",
    "input_identity_state",
    "replay_lane_and_paper_lane_must_share_input_identity_flag",
    "replay_lane_and_paper_lane_must_remain_separate_flag",
    "replay_result_packet_may_not_overwrite_paper_result_packet_flag",
    "paper_result_packet_may_not_overwrite_replay_result_packet_flag",
    "combined_result_packet_allowed_flag",
    "lane_result_merge_allowed_flag",
    "mutation_allowed_flag",
    "live_reachability_allowed_flag",
    "order_execution_allowed_flag",
    "runtime_cash_claim_allowed_flag",
    "profit_claim_allowed_flag",
    "atomicrows_bundle_mutation_allowed_flag",
    "blocker_reduction_claim_allowed_flag",
    "blocker_codes",
    "receipt_ids",
    "no_claim_flags",
    "validation_hook_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "source_connector_receipts": {
      "type": "object",
      "properties": {
        "source_evidence_gate_receipt_ids": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "connector_semantic_gate_receipt_ids": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "required": [
        "source_evidence_gate_receipt_ids",
        "connector_semantic_gate_receipt_ids"
      ],
      "additionalProperties": false
    },
    "lane_input_identity_ref": {
      "type": "object",
      "properties": {
        "lane_type": {
          "enum": [
            "REPLAY",
            "PAPER"
          ]
        },
        "runtime_resolver_snapshot_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "runtime_resolver_snapshot_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "runtime_resolver_input_lock_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "runtime_resolver_input_lock_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "runtime_resolver_to_replay_paper_handoff_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "runtime_resolver_handoff_gate_report_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "replay_paper_input_identity_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "candidate_contract_identity_set": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "candidate_contract_identity_set_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "venue_normalization_identity_set": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "venue_normalization_identity_set_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "source_evidence_gate_receipt_ids": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "connector_semantic_gate_receipt_ids": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "required": [
        "lane_type",
        "runtime_resolver_snapshot_id",
        "runtime_resolver_snapshot_digest",
        "runtime_resolver_input_lock_id",
        "runtime_resolver_input_lock_digest",
        "runtime_resolver_to_replay_paper_handoff_id",
        "runtime_resolver_handoff_gate_report_id",
        "replay_paper_input_identity_digest",
        "candidate_contract_identity_set",
        "candidate_contract_identity_set_digest",
        "venue_normalization_identity_set",
        "venue_normalization_identity_set_digest",
        "source_evidence_gate_receipt_ids",
        "connector_semantic_gate_receipt_ids"
      ],
      "additionalProperties": false
    },
    "blocker_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "receipt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "no_claim_flags": {
      "type": "object",
      "properties": {
        "retrieves_source_evidence": {
          "const": false
        },
        "accepts_source_facts": {
          "const": false
        },
        "creates_real_accepted_source_evidence": {
          "const": false
        },
        "creates_accepted_source_packets": {
          "const": false
        },
        "populates_production_connector_semantic_values": {
          "const": false
        },
        "imports_live_clients": {
          "const": false
        },
        "creates_network_io": {
          "const": false
        },
        "creates_runtime_resolver_snapshot": {
          "const": false
        },
        "creates_replay_paper_input_lock": {
          "const": false
        },
        "executes_replay_or_paper": {
          "const": false
        },
        "creates_replay_result_packets": {
          "const": false
        },
        "creates_paper_result_packets": {
          "const": false
        },
        "creates_dual_result_review": {
          "const": false
        },
        "creates_owner_live_promotion_review": {
          "const": false
        },
        "creates_live_reachability": {
          "const": false
        },
        "creates_order_authority": {
          "const": false
        },
        "creates_runtime_cash_claim": {
          "const": false
        },
        "creates_atomicrows_bundle_or_hash": {
          "const": false
        },
        "reduces_blockers": {
          "const": false
        },
        "creates_profit_evidence": {
          "const": false
        }
      },
      "required": [
        "retrieves_source_evidence",
        "accepts_source_facts",
        "creates_real_accepted_source_evidence",
        "creates_accepted_source_packets",
        "populates_production_connector_semantic_values",
        "imports_live_clients",
        "creates_network_io",
        "creates_runtime_resolver_snapshot",
        "creates_replay_paper_input_lock",
        "executes_replay_or_paper",
        "creates_replay_result_packets",
        "creates_paper_result_packets",
        "creates_dual_result_review",
        "creates_owner_live_promotion_review",
        "creates_live_reachability",
        "creates_order_authority",
        "creates_runtime_cash_claim",
        "creates_atomicrows_bundle_or_hash",
        "reduces_blockers",
        "creates_profit_evidence"
      ],
      "additionalProperties": false
    },
    "validation_hook_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "STAGE1_CONCURRENT_REPLAY_PAPER_CONTRACT_STATIC_AUDIT"
      }
    }
  }
}

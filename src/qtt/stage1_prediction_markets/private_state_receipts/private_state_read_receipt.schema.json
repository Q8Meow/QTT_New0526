{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qtt-stage1-private-state-read-receipt-v1",
  "title": "PR130 Private-State Read Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "private_state_read_receipt_id",
    "fixture_authority_class",
    "private_state_read_receipt_state",
    "production_private_state_read_authority",
    "production_account_balance_authority",
    "production_wallet_balance_authority",
    "production_runtime_cash_receipt_authority",
    "private_state_read_request_id",
    "venue_id",
    "platform_scope",
    "account_scope_id",
    "runtime_cash_component_field_map_id",
    "observed_private_state_surface",
    "redacted_payload_digest",
    "canonicalized_redacted_payload_digest",
    "redaction_attestation_id",
    "no_secret_capture_attestation_id",
    "credential_alias_placeholder_ref",
    "credential_alias_required_future_pr",
    "credential_alias_authority_created",
    "private_state_receipt_status",
    "receipt_staleness_policy",
    "deterministic_fixture_time",
    "future_production_launch_path_preserved"

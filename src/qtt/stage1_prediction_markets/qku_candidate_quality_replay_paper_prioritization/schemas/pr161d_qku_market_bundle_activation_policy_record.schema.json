        "MARKET_BUNDLE_ACTIVE_STAGE1_AGENT_SCORING",
        "MARKET_BUNDLE_ACTIVE_RESEARCH_ONLY",
        "MARKET_BUNDLE_DORMANT_FUTURE_STAGE",

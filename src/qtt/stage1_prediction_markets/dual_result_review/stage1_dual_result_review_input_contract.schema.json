{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/src/qtt/stage1_prediction_markets/dual_result_review/stage1_dual_result_review_input_contract.schema.json",
  "title": "Stage-1 Dual Result Review Input Contract Static Schema",
  "description": "Static PR44 dual-result review input contract. It references separate synthetic PR43 replay and paper result packet boundaries and creates no review decision, owner review, live reachability, order authority, runtime cash claim, AtomicRows bundle/hash, blocker reduction, or profit evidence.",
  "type": "object",
  "properties": {
    "dual_result_review_input_contract_type": {
      "const": "STAGE1_DUAL_RESULT_REVIEW_INPUT_CONTRACT"
    },
    "dual_result_review_input_contract_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "fixture_case": {
      "$ref": "#/$defs/non_empty_string"
    },
    "record_authority_class": {
      "const": "STATIC_DUAL_RESULT_REVIEW_INPUT_CONTRACT_ONLY_NOT_REVIEW_DECISION_AUTHORITY"
    },
    "synthetic_data_notice": {
      "const": "SYNTHETIC_PLACEHOLDER_ONLY_NO_REAL_SOURCE_NO_REAL_ACCEPTED_FACT"
    },
    "master_plan_edition": {
      "$ref": "#/$defs/non_empty_string"
    },
    "master_plan_sha256": {
      "$ref": "#/$defs/sha256_digest"
    },
    "concurrent_replay_paper_execution_gate_report_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "replay_result_packet_boundary_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "paper_result_packet_boundary_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "replay_result_packet_boundary_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "paper_result_packet_boundary_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "replay_paper_input_identity_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "replay_lane_replay_paper_input_identity_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "paper_lane_replay_paper_input_identity_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "runtime_resolver_snapshot_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "replay_runtime_resolver_snapshot_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "paper_runtime_resolver_snapshot_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "runtime_resolver_snapshot_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "replay_runtime_resolver_snapshot_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "paper_runtime_resolver_snapshot_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "replay_result_boundary_state": {
      "enum": [
        "PRESENT_IMMUTABLE",
        "MISSING",
        "STALE",
        "SUPERSEDED",
        "CONFLICT",
        "SCHEMA_ERROR",
        "TARGET_MISMATCH"
      ]
    },
    "paper_result_boundary_state": {
      "enum": [
        "PRESENT_IMMUTABLE",
        "MISSING",
        "STALE",
        "SUPERSEDED",
        "CONFLICT",
        "SCHEMA_ERROR",
        "TARGET_MISMATCH"
      ]
    },
    "input_identity_match_state": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "MISSING",
        "STALE",
        "INVALID"
      ]
    },
    "runtime_resolver_snapshot_match_state": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "MISSING",
        "STALE",
        "INVALID"
      ]
    },
    "digest_presence_state": {
      "enum": [
        "PRESENT",
        "MISSING"
      ]
    },
    "conflict_state": {
      "enum": [
        "NO_CONFLICT",
        "CONFLICT_PRESENT"
      ]
    },
    "schema_state": {
      "enum": [
        "SCHEMA_VALID",
        "SCHEMA_ERROR"
      ]
    },
    "lane_match_state": {
      "enum": [
        "MATCH",
        "MISMATCH"
      ]
    },
    "target_match_state": {
      "enum": [
        "MATCH",
        "MISMATCH"
      ]
    },
    "replay_result_reference_immutable_flag": {
      "const": true
    },
    "paper_result_reference_immutable_flag": {
      "const": true
    },
    "review_decision_created_flag": {
      "const": false
    },
    "ready_for_comparison_matrix_flag": {
      "const": true
    },
    "result_merge_created_flag": {
      "const": false
    },
    "auto_promotion_allowed_flag": {
      "const": false
    },
    "owner_live_promotion_review_created_flag": {
      "const": false
    },
    "owner_approval_receipt_created_flag": {
      "const": false
    },
    "live_reachability_created_flag": {
      "const": false
    },
    "order_authority_created_flag": {
      "const": false
    },
    "runtime_cash_claim_created_flag": {
      "const": false
    },
    "atomicrows_bundle_hash_created_or_mutated_flag": {
      "const": false
    },
    "blocker_reduction_claim_created_flag": {
      "const": false
    },
    "profit_evidence_created_flag": {
      "const": false
    },
    "blocker_codes": {
      "$ref": "#/$defs/blocker_codes"
    },
    "receipt_ids": {
      "$ref": "#/$defs/receipt_ids"
    },
    "no_claim_flags": {
      "$ref": "#/$defs/no_claim_flags"
    },
    "validation_hook_ids": {
      "$ref": "#/$defs/validation_hook_ids"
    }
  },
  "required": [
    "dual_result_review_input_contract_type",
    "dual_result_review_input_contract_id",
    "fixture_case",
    "record_authority_class",
    "synthetic_data_notice",
    "master_plan_edition",
    "master_plan_sha256",
    "concurrent_replay_paper_execution_gate_report_ref",
    "replay_result_packet_boundary_ref",
    "paper_result_packet_boundary_ref",
    "replay_result_packet_boundary_digest",
    "paper_result_packet_boundary_digest",
    "replay_paper_input_identity_digest",
    "replay_lane_replay_paper_input_identity_digest",
    "paper_lane_replay_paper_input_identity_digest",
    "runtime_resolver_snapshot_id",
    "replay_runtime_resolver_snapshot_id",
    "paper_runtime_resolver_snapshot_id",
    "runtime_resolver_snapshot_digest",
    "replay_runtime_resolver_snapshot_digest",
    "paper_runtime_resolver_snapshot_digest",
    "replay_result_boundary_state",
    "paper_result_boundary_state",
    "input_identity_match_state",
    "runtime_resolver_snapshot_match_state",
    "digest_presence_state",
    "conflict_state",
    "schema_state",
    "lane_match_state",
    "target_match_state",
    "replay_result_reference_immutable_flag",
    "paper_result_reference_immutable_flag",
    "review_decision_created_flag",
    "ready_for_comparison_matrix_flag",
    "result_merge_created_flag",
    "auto_promotion_allowed_flag",
    "owner_live_promotion_review_created_flag",
    "owner_approval_receipt_created_flag",
    "live_reachability_created_flag",
    "order_authority_created_flag",
    "runtime_cash_claim_created_flag",
    "atomicrows_bundle_hash_created_or_mutated_flag",
    "blocker_reduction_claim_created_flag",
    "profit_evidence_created_flag",
    "blocker_codes",
    "receipt_ids",
    "no_claim_flags",
    "validation_hook_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blocker_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "receipt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "validation_hook_ids": {
      "type": "array",
      "prefixItems": [
        {
          "const": "STAGE1_DUAL_RESULT_REVIEW_CONTRACT_STATIC_AUDIT"
        }
      ],
      "items": false
    },
    "no_claim_flags": {
      "type": "object",
      "properties": {
        "retrieves_source_evidence": { "const": false },
        "accepts_source_facts": { "const": false },
        "creates_real_accepted_source_evidence": { "const": false },
        "creates_accepted_source_packets": { "const": false },
        "populates_production_connector_semantic_values": { "const": false },
        "imports_live_clients": { "const": false },
        "creates_network_io": { "const": false },
        "creates_runtime_resolver_snapshot": { "const": false },
        "executes_replay_or_paper": { "const": false },
        "creates_replay_result_packets": { "const": false },
        "creates_paper_result_packets": { "const": false },
        "merges_replay_paper_results": { "const": false },
        "creates_dual_result_review_decision": { "const": false },
        "creates_owner_live_promotion_review": { "const": false },
        "creates_owner_approval_receipt": { "const": false },
        "creates_live_eligibility": { "const": false },
        "creates_live_reachability": { "const": false },
        "creates_order_authority": { "const": false },
        "creates_runtime_cash_claim": { "const": false },
        "creates_atomicrows_bundle_or_hash": { "const": false },
        "reduces_blockers": { "const": false },
        "creates_profit_evidence": { "const": false }
      },
      "required": [
        "retrieves_source_evidence",
        "accepts_source_facts",
        "creates_real_accepted_source_evidence",
        "creates_accepted_source_packets",
        "populates_production_connector_semantic_values",
        "imports_live_clients",
        "creates_network_io",
        "creates_runtime_resolver_snapshot",
        "executes_replay_or_paper",
        "creates_replay_result_packets",
        "creates_paper_result_packets",
        "merges_replay_paper_results",
        "creates_dual_result_review_decision",
        "creates_owner_live_promotion_review",
        "creates_owner_approval_receipt",
        "creates_live_eligibility",
        "creates_live_reachability",
        "creates_order_authority",
        "creates_runtime_cash_claim",
        "creates_atomicrows_bundle_or_hash",
        "reduces_blockers",
        "creates_profit_evidence"
      ],
      "additionalProperties": false
    }
  }
}

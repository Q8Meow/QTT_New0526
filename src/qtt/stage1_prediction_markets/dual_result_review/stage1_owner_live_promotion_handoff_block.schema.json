{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/src/qtt/stage1_prediction_markets/dual_result_review/stage1_owner_live_promotion_handoff_block.schema.json",
  "title": "Stage-1 Owner Live Promotion Handoff Block Static Schema",
  "description": "Static PR44 no-auto-promotion boundary. A dual-result review pass may hand off only to later owner live-promotion review input, and this schema creates no owner approval receipt, owner review packet, live eligibility, live reachability, order authority, runtime cash claim, or profit claim.",
  "type": "object",
  "properties": {
    "handoff_block_type": {
      "const": "STAGE1_OWNER_LIVE_PROMOTION_HANDOFF_BLOCK"
    },
    "handoff_block_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "fixture_case": {
      "$ref": "#/$defs/non_empty_string"
    },
    "record_authority_class": {
      "const": "STATIC_OWNER_LIVE_PROMOTION_HANDOFF_BLOCK_ONLY_NOT_OWNER_REVIEW_AUTHORITY"
    },
    "synthetic_data_notice": {
      "const": "SYNTHETIC_PLACEHOLDER_ONLY_NO_REAL_SOURCE_NO_REAL_ACCEPTED_FACT"
    },
    "dual_result_review_pass_next_allowed_consumer": {
      "const": "OWNER_LIVE_PROMOTION_REVIEW_ONLY"
    },
    "dual_result_review_direct_live_consumer_allowed": {
      "const": false
    },
    "dual_result_review_direct_order_router_allowed": {
      "const": false
    },
    "dual_result_review_direct_canary_allowed": {
      "const": false
    },
    "dual_result_review_auto_promotion_allowed": {
      "const": false
    },
    "owner_review_required_before_live_eligibility": {
      "const": true
    },
    "owner_live_promotion_review_created_flag": {
      "const": false
    },
    "owner_approval_receipt_created_flag": {
      "const": false
    },
    "live_eligibility_created_flag": {
      "const": false
    },
    "live_reachability_created_flag": {
      "const": false
    },
    "order_authority_created_flag": {
      "const": false
    },
    "runtime_cash_claim_created_flag": {
      "const": false
    },
    "profit_claim_created_flag": {
      "const": false
    },
    "blocker_codes": {
      "$ref": "#/$defs/blocker_codes"
    },
    "receipt_ids": {
      "$ref": "#/$defs/receipt_ids"
    },
    "no_claim_flags": {
      "$ref": "#/$defs/no_claim_flags"
    },
    "validation_hook_ids": {
      "$ref": "#/$defs/validation_hook_ids"
    }
  },
  "required": [
    "handoff_block_type",
    "handoff_block_id",
    "fixture_case",
    "record_authority_class",
    "synthetic_data_notice",
    "dual_result_review_pass_next_allowed_consumer",
    "dual_result_review_direct_live_consumer_allowed",
    "dual_result_review_direct_order_router_allowed",
    "dual_result_review_direct_canary_allowed",
    "dual_result_review_auto_promotion_allowed",
    "owner_review_required_before_live_eligibility",
    "owner_live_promotion_review_created_flag",
    "owner_approval_receipt_created_flag",
    "live_eligibility_created_flag",
    "live_reachability_created_flag",
    "order_authority_created_flag",
    "runtime_cash_claim_created_flag",
    "profit_claim_created_flag",
    "blocker_codes",
    "receipt_ids",
    "no_claim_flags",
    "validation_hook_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "blocker_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "receipt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "validation_hook_ids": {
      "type": "array",
      "prefixItems": [
        {
          "const": "STAGE1_DUAL_RESULT_REVIEW_CONTRACT_STATIC_AUDIT"
        }
      ],
      "items": false
    },
    "no_claim_flags": {
      "type": "object",
      "additionalProperties": {
        "const": false
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/src/qtt/stage1_prediction_markets/dual_result_review/stage1_replay_paper_comparison_matrix.schema.json",
  "title": "Stage-1 Replay/Paper Comparison Matrix Static Schema",
  "description": "Static PR44 comparison matrix contract. It may compare synthetic replay and paper boundary references but must not merge result packets, create live eligibility, create owner-promotion readiness, create order authority, or claim profit.",
  "type": "object",
  "properties": {
    "comparison_matrix_type": {
      "const": "STAGE1_REPLAY_PAPER_COMPARISON_MATRIX"
    },
    "comparison_matrix_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "fixture_case": {
      "$ref": "#/$defs/non_empty_string"
    },
    "record_authority_class": {
      "const": "STATIC_REPLAY_PAPER_COMPARISON_MATRIX_ONLY_NOT_RESULT_MERGE_NOT_PROMOTION_AUTHORITY"
    },
    "synthetic_data_notice": {
      "const": "SYNTHETIC_PLACEHOLDER_ONLY_NO_REAL_SOURCE_NO_REAL_ACCEPTED_FACT"
    },
    "input_contract_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "replay_result_packet_boundary_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "paper_result_packet_boundary_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "static_fields_only_flag": {
      "const": true
    },
    "compares_synthetic_boundary_refs_only_flag": {
      "const": true
    },
    "metric_pair_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric_pair_record"
      }
    },
    "comparison_summary_state": {
      "$ref": "#/$defs/non_empty_string"
    },
    "next_required_state": {
      "const": "OWNER_LIVE_PROMOTION_REVIEW_REQUIRED"
    },
    "negative_lane_metrics_preserved_flag": {
      "const": true
    },
    "replay_result_packet_mutated_flag": {
      "const": false
    },
    "paper_result_packet_mutated_flag": {
      "const": false
    },
    "replay_paper_results_merged_flag": {
      "const": false
    },
    "combined_result_packet_created_flag": {
      "const": false
    },
    "dual_result_review_decision_created_flag": {
      "const": false
    },
    "live_eligibility_created_flag": {
      "const": false
    },
    "owner_promotion_readiness_created_flag": {
      "const": false
    },
    "owner_live_promotion_review_created_flag": {
      "const": false
    },
    "owner_approval_receipt_created_flag": {
      "const": false
    },
    "direct_live_promotion_claimed_flag": {
      "const": false
    },
    "order_authority_created_flag": {
      "const": false
    },
    "runtime_cash_claim_created_flag": {
      "const": false
    },
    "atomicrows_bundle_hash_created_or_mutated_flag": {
      "const": false
    },
    "blocker_reduction_claim_created_flag": {
      "const": false
    },
    "profit_claim_created_flag": {
      "const": false
    },
    "blocker_codes": {
      "$ref": "#/$defs/blocker_codes"
    },
    "receipt_ids": {
      "$ref": "#/$defs/receipt_ids"
    },
    "no_claim_flags": {
      "$ref": "#/$defs/no_claim_flags"
    },
    "validation_hook_ids": {
      "$ref": "#/$defs/validation_hook_ids"
    }
  },
  "required": [
    "comparison_matrix_type",
    "comparison_matrix_id",
    "fixture_case",
    "record_authority_class",
    "synthetic_data_notice",
    "input_contract_ref",
    "replay_result_packet_boundary_ref",
    "paper_result_packet_boundary_ref",
    "static_fields_only_flag",
    "compares_synthetic_boundary_refs_only_flag",
    "metric_pair_records",
    "comparison_summary_state",
    "next_required_state",
    "negative_lane_metrics_preserved_flag",
    "replay_result_packet_mutated_flag",
    "paper_result_packet_mutated_flag",
    "replay_paper_results_merged_flag",
    "combined_result_packet_created_flag",
    "dual_result_review_decision_created_flag",
    "live_eligibility_created_flag",
    "owner_promotion_readiness_created_flag",
    "owner_live_promotion_review_created_flag",
    "owner_approval_receipt_created_flag",
    "direct_live_promotion_claimed_flag",
    "order_authority_created_flag",
    "runtime_cash_claim_created_flag",
    "atomicrows_bundle_hash_created_or_mutated_flag",
    "blocker_reduction_claim_created_flag",
    "profit_claim_created_flag",
    "blocker_codes",
    "receipt_ids",
    "no_claim_flags",
    "validation_hook_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "metric_pair_record": {
      "type": "object",
      "properties": {
        "metric_pair_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "replay_metric_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "paper_metric_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "metric_merge_allowed_flag": {
          "const": false
        },
        "metric_average_for_promotion_allowed_flag": {
          "const": false
        },
        "negative_lane_metric_drop_allowed_flag": {
          "const": false
        },
        "static_comparison_only_flag": {
          "const": true
        }
      },
      "required": [
        "metric_pair_id",
        "replay_metric_ref",
        "paper_metric_ref",
        "metric_merge_allowed_flag",
        "metric_average_for_promotion_allowed_flag",
        "negative_lane_metric_drop_allowed_flag",
        "static_comparison_only_flag"
      ],
      "additionalProperties": false
    },
    "blocker_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "receipt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "validation_hook_ids": {
      "type": "array",
      "prefixItems": [
        {
          "const": "STAGE1_DUAL_RESULT_REVIEW_CONTRACT_STATIC_AUDIT"
        }
      ],
      "items": false
    },
    "no_claim_flags": {
      "type": "object",
      "additionalProperties": {
        "const": false
      }
    }
  }
}

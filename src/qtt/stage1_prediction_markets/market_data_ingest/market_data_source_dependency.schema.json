      "properties": {
        "schema_version": {"const": "PIT_MARKET_DATA_SOURCE_DEPENDENCY_V2"},
        "record_type": {"const": "PIT_MARKET_DATA_SOURCE_DEPENDENCY"}
      },
      "allOf": [
        {
          "if": {"properties": {"access_class": {"const": "AUTHENTICATED_PUBLIC_MARKET_DATA_READ"}}, "required": ["access_class"]},
          "then": {"properties": {"credential_alias_required": {"const": true}}},
          "else": {"properties": {"credential_alias_required": {"const": false}}}
        },
        {
          "if": {"properties": {"profile_id": {"const": "GEMINI_TITAN_DIRECT"}}, "required": ["profile_id"]},
          "then": {
            "properties": {
              "access_class": {"const": "PUBLIC_UNAUTHENTICATED_READ"},
              "event_kind": {"enum": ["CATALOG", "LIFECYCLE", "BOOK_SNAPSHOT", "BOOK_DELTA", "BBO", "TRADE", "SETTLEMENT", "SOURCE_STATUS"]},
              "host": {"enum": ["https://api.gemini.com", "wss://ws.gemini.com?snapshot=-1"]},
              "wire_dialect": {"const": "GEMINI_TITAN_DIFFERENTIAL_DEPTH_V1"}
            }
          }
        },
        {
          "if": {"properties": {"profile_id": {"const": "POLYMARKET_US_RETAIL_DIRECT"}}, "required": ["profile_id"]},
          "then": {
            "properties": {
              "event_kind": {"enum": ["CATALOG", "LIFECYCLE", "BOOK_REPLACEMENT", "BBO", "TRADE", "SETTLEMENT", "HEARTBEAT", "SOURCE_STATUS"]},
              "host": {"enum": ["https://gateway.polymarket.us", "wss://api.polymarket.us/v1/ws/markets"]},
              "wire_dialect": {"const": "CAMEL_CASE_STRING_ENUM_THEN_ONE_EXPLICIT_PRE_DATA_ERROR_FALLBACK_TO_SNAKE_CASE_NUMERIC_ENUM"}
            }
          }
        },
        {
          "if": {"properties": {"profile_id": {"const": "KALSHI_US_DCM_DIRECT"}}, "required": ["profile_id"]},
          "then": {
            "properties": {
              "event_kind": {"enum": ["CATALOG", "LIFECYCLE", "BOOK_SNAPSHOT", "BOOK_DELTA", "TRADE", "SETTLEMENT", "HEARTBEAT", "SOURCE_STATUS"]},
              "host": {"enum": ["https://external-api.kalshi.com/trade-api/v2", "wss://external-api-ws.kalshi.com/trade-api/ws/v2"]},
              "wire_dialect": {"const": "KALSHI_TRADE_API_WS_V2_FIXED_POINT"}
            }
          }
        },
        {
          "if": {"properties": {"event_kind": {"const": "BOOK_SNAPSHOT"}}, "required": ["event_kind"]},
          "then": {"properties": {"depth_class": {"const": "COMPLETE_PROVIDER_SNAPSHOT"}}}
        },
        {
          "if": {"properties": {"event_kind": {"const": "BOOK_DELTA"}}, "required": ["event_kind"]},
          "then": {"properties": {"depth_class": {"const": "INCREMENTAL_FROM_COMPLETE_ANCHOR"}}}
        },
        {
          "if": {"properties": {"event_kind": {"const": "BBO"}}, "required": ["event_kind"]},
          "then": {"properties": {"depth_class": {"const": "BBO_ONLY"}}}
        },
        {
          "if": {"properties": {"event_kind": {"const": "BOOK_REPLACEMENT"}, "read_action": {"const": "GET"}}, "required": ["event_kind", "read_action"]},
          "then": {"properties": {"depth_class": {"const": "COMPLETE_PROVIDER_SNAPSHOT"}}}
        },
        {
          "if": {"properties": {"event_kind": {"const": "BOOK_REPLACEMENT"}, "read_action": {"const": "WEBSOCKET_SUBSCRIBE"}}, "required": ["event_kind", "read_action"]},
          "then": {"properties": {"depth_class": {"const": "PROVIDER_PUBLISHED_TOP_LEVELS_CURRENT_STATE_FRAME"}}}
        }
      ],

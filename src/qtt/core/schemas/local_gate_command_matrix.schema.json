{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/src/qtt/core/schemas/local_gate_command_matrix.schema.json",
  "title": "Local Gate Command Matrix Static Schema",
  "description": "Deterministic local command matrix. This schema creates no source fact acceptance, connector semantics, runtime resolver snapshot, replay or paper execution, live reachability, runtime cash, AtomicRows bundle, blocker reduction, trading authority, or profit evidence.",
  "type": "object",
  "properties": {
    "matrix_type": {
      "const": "LOCAL_GATE_COMMAND_MATRIX"
    },
    "matrix_version": {
      "const": "PR37_LOCAL_GATE_COMMAND_MATRIX_V1"
    },
    "status": {
      "const": "PASS"
    },
    "metadata": {
      "$ref": "#/$defs/static_metadata"
    },
    "command_order_locked": {
      "const": true
    },
    "manual_skip_forbidden": {
      "const": true
    },
    "failure_blocks_pr_handoff": {
      "const": true
    },
    "local_gate_output_authority": {
      "$ref": "#/$defs/local_gate_output_authority"
    },
    "pytest_policy": {
      "$ref": "#/$defs/pytest_policy"
    },
    "commands": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "validation_hook_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "LOCAL_GATE_COMMAND_MATRIX_STATIC_AUDIT"
      }
    }
  },
  "required": [
    "matrix_type",
    "matrix_version",
    "status",
    "metadata",
    "command_order_locked",
    "manual_skip_forbidden",
    "failure_blocks_pr_handoff",
    "local_gate_output_authority",
    "pytest_policy",
    "commands",
    "validation_hook_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "static_metadata": {
      "type": "object",
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "generated_at_utc": {
          "const": "STATIC_DETERMINISTIC_NO_WALL_CLOCK"
        },
        "authority_class": {
          "const": "STATIC_REPORT_ONLY_NOT_TRADING_AUTHORITY"
        },
        "creates_source_fact_acceptance": {
          "const": false
        },
        "creates_connector_semantics": {
          "const": false
        },
        "creates_runtime_resolver_snapshot": {
          "const": false
        },
        "executes_replay_or_paper": {
          "const": false
        },
        "creates_live_reachability": {
          "const": false
        },
        "creates_runtime_cash_or_usable_cash": {
          "const": false
        },
        "creates_atomicrows_bundle_or_4183_rows": {
          "const": false
        },
        "reduces_blockers": {
          "const": false
        },
        "creates_profit_evidence": {
          "const": false
        }
      },
      "required": [
        "generated_by",
        "generated_at_utc",
        "authority_class",
        "creates_source_fact_acceptance",
        "creates_connector_semantics",
        "creates_runtime_resolver_snapshot",
        "executes_replay_or_paper",
        "creates_live_reachability",
        "creates_runtime_cash_or_usable_cash",
        "creates_atomicrows_bundle_or_4183_rows",
        "reduces_blockers",
        "creates_profit_evidence"
      ],
      "additionalProperties": false
    },
    "local_gate_output_authority": {
      "type": "object",
      "properties": {
        "local_gate_output_creates_source_fact_acceptance": {
          "const": false
        },
        "local_gate_output_creates_connector_semantics": {
          "const": false
        },
        "local_gate_output_creates_runtime_resolver_snapshot": {
          "const": false
        },
        "local_gate_output_executes_replay_or_paper": {
          "const": false
        },
        "local_gate_output_creates_live_reachability": {
          "const": false
        },
        "local_gate_output_creates_runtime_cash_or_usable_cash": {
          "const": false
        },
        "local_gate_output_creates_atomicrows_bundle_or_4183_rows": {
          "const": false
        },
        "local_gate_output_reduces_blockers": {
          "const": false
        },
        "local_gate_output_creates_profit_evidence": {
          "const": false
        }
      },
      "required": [
        "local_gate_output_creates_source_fact_acceptance",
        "local_gate_output_creates_connector_semantics",
        "local_gate_output_creates_runtime_resolver_snapshot",
        "local_gate_output_executes_replay_or_paper",
        "local_gate_output_creates_live_reachability",
        "local_gate_output_creates_runtime_cash_or_usable_cash",
        "local_gate_output_creates_atomicrows_bundle_or_4183_rows",
        "local_gate_output_reduces_blockers",
        "local_gate_output_creates_profit_evidence"
      ],
      "additionalProperties": false
    },
    "pytest_policy": {
      "type": "object",
      "properties": {
        "bare_pytest_is_canonical_when_full_validation_required": {
          "const": false
        },
        "canonical_full_validation_command": {
          "const": ".\\.venv\\Scripts\\python.exe tools\\run_validation_gates.py"
        },
        "pytest_only_helper_when_needed": {
          "const": ".\\.venv\\Scripts\\python.exe tools\\run_pytest_fresh_basetemp.py -q"
        }
      },
      "required": [
        "bare_pytest_is_canonical_when_full_validation_required",
        "canonical_full_validation_command",
        "pytest_only_helper_when_needed"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "command_id": {
          "enum": [
            "full_validation_gates",
            "compileall_tools_tests",
            "git_diff_check",
            "atomicrows_bundle_absence_check",
            "atomicrows_bundle_sha_absence_check"
          ]
        },
        "command": {
          "type": "string"
        },
        "shell": {
          "const": "powershell"
        },
        "required": {
          "const": true
        },
        "manual_skip_allowed": {
          "const": false
        },
        "failure_blocks_pr_handoff": {
          "const": true
        },
        "creates_source_fact_acceptance": {
          "const": false
        },
        "creates_connector_semantics": {
          "const": false
        },
        "creates_runtime_resolver_snapshot": {
          "const": false
        },
        "executes_replay_or_paper": {
          "const": false
        },
        "creates_live_reachability": {
          "const": false
        },
        "creates_runtime_cash_or_usable_cash": {
          "const": false
        },
        "creates_atomicrows_bundle_or_4183_rows": {
          "const": false
        },
        "reduces_blockers": {
          "const": false
        },
        "creates_profit_evidence": {
          "const": false
        }
      },
      "required": [
        "order",
        "command_id",
        "command",
        "shell",
        "required",
        "manual_skip_allowed",
        "failure_blocks_pr_handoff",
        "creates_source_fact_acceptance",
        "creates_connector_semantics",
        "creates_runtime_resolver_snapshot",
        "executes_replay_or_paper",
        "creates_live_reachability",
        "creates_runtime_cash_or_usable_cash",
        "creates_atomicrows_bundle_or_4183_rows",
        "reduces_blockers",
        "creates_profit_evidence"
      ],
      "additionalProperties": false
    }
  }
}

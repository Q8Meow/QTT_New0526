{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/src/qtt/core/schemas/qtt_test_gate_report.schema.json",
  "title": "QTT Cumulative Test Gate Static Report Schema",
  "description": "Static cumulative test-gate report. This schema creates no source fact acceptance, connector semantics, runtime resolver snapshot, replay or paper execution, live reachability, runtime cash, AtomicRows bundle, blocker reduction, trading authority, or profit evidence.",
  "type": "object",
  "properties": {
    "report_type": {
      "const": "QTT_CUMULATIVE_TEST_GATE_REPORT"
    },
    "report_version": {
      "const": "PR46_QTT_CUMULATIVE_TEST_GATE_REPORT_V1"
    },
    "phase": {
      "const": "first-coding-runbook"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "strict_no_claim": {
      "type": "boolean"
    },
    "metadata": {
      "$ref": "#/$defs/static_metadata"
    },
    "prior_gate_receipts": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {
        "$ref": "#/$defs/prior_gate_receipt"
      }
    },
    "gate_checks": {
      "$ref": "#/$defs/gate_checks"
    },
    "filesystem_claim_checks": {
      "$ref": "#/$defs/filesystem_claim_checks"
    },
    "no_claim_flags": {
      "$ref": "#/$defs/no_claim_flags"
    },
    "validation_hook_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "QTT_CUMULATIVE_TEST_GATE_STATIC_AUDIT"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "report_type",
    "report_version",
    "phase",
    "status",
    "strict_no_claim",
    "metadata",
    "prior_gate_receipts",
    "gate_checks",
    "filesystem_claim_checks",
    "no_claim_flags",
    "validation_hook_ids",
    "findings"
  ],
  "additionalProperties": false,
  "$defs": {
    "static_metadata": {
      "type": "object",
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "generated_at_utc": {
          "const": "STATIC_DETERMINISTIC_NO_WALL_CLOCK"
        },
        "authority_class": {
          "const": "STATIC_REPORT_ONLY_NOT_TRADING_AUTHORITY"
        },
        "creates_source_fact_acceptance": {
          "const": false
        },
        "creates_connector_semantics": {
          "const": false
        },
        "creates_runtime_resolver_snapshot": {
          "const": false
        },
        "executes_replay_or_paper": {
          "const": false
        },
        "creates_live_reachability": {
          "const": false
        },
        "creates_runtime_cash_or_usable_cash": {
          "const": false
        },
        "creates_atomicrows_bundle_or_4183_rows": {
          "const": false
        },
        "reduces_blockers": {
          "const": false
        },
        "creates_profit_evidence": {
          "const": false
        }
      },
      "required": [
        "generated_by",
        "generated_at_utc",
        "authority_class",
        "creates_source_fact_acceptance",
        "creates_connector_semantics",
        "creates_runtime_resolver_snapshot",
        "executes_replay_or_paper",
        "creates_live_reachability",
        "creates_runtime_cash_or_usable_cash",
        "creates_atomicrows_bundle_or_4183_rows",
        "reduces_blockers",
        "creates_profit_evidence"
      ],
      "additionalProperties": false
    },
    "prior_gate_receipt": {
      "type": "object",
      "properties": {
        "receipt_id": {
          "enum": [
            "owner_start_receipt_present_or_reported_missing",
            "master_plan_placement_receipt_present",
            "master_plan_hash_receipt_present_or_reported_missing",
            "section_manifest_receipt_present",
            "traceability_gate_receipt_present",
            "atomicrows_schema_checker_blocker_report_receipt_present",
            "generated_derivative_gate_receipt_present",
            "source_evidence_gate_confirmation_receipt_present",
            "stage1_packet_schema_gate_receipt_present",
            "venue_neutral_prediction_adapter_gate_receipt_present",
            "connector_scaffold_source_required_gate_receipt_present",
            "stage1_runtime_scaffold_gate_receipt_present",
            "source_fact_binding_connector_semantic_readiness_gate_receipt_present",
            "accepted_source_evidence_consumer_contract_gate_receipt_present",
            "connector_semantic_binding_ledger_contract_gate_receipt_present",
            "runtime_resolver_snapshot_contract_gate_receipt_present",
            "runtime_resolver_to_replay_paper_handoff_gate_receipt_present",
            "concurrent_replay_paper_contract_gate_receipt_present",
            "dual_result_review_contract_gate_receipt_present",
            "owner_live_promotion_review_contract_gate_receipt_present",
            "three_venue_canary_eligibility_contract_gate_receipt_present"
          ]
        },
        "description": {
          "type": "string"
        },
        "required": {
          "const": true
        },
        "satisfied": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PRESENT",
            "REQUIRED_PRIOR_GATE_CONFIRMED_BY_VALIDATION_MARKER",
            "REQUIRED_PRIOR_GATE_REPORT_NOT_CREATED_STATIC_BOOTSTRAP",
            "MISSING_BLOCKED"
          ]
        },
        "receipt_source": {
          "enum": [
            "GENERATED_REPORT_FILE",
            "STATIC_VALIDATION_MARKER",
            "STATIC_BOOTSTRAP_MISSING_REPORT"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "creates_source_fact_acceptance": {
          "const": false
        },
        "creates_connector_semantics": {
          "const": false
        },
        "creates_runtime_resolver_snapshot": {
          "const": false
        },
        "executes_replay_or_paper": {
          "const": false
        },
        "creates_live_reachability": {
          "const": false
        },
        "creates_runtime_cash_or_usable_cash": {
          "const": false
        },
        "creates_atomicrows_bundle_or_4183_rows": {
          "const": false
        },
        "reduces_blockers": {
          "const": false
        },
        "creates_profit_evidence": {
          "const": false
        }
      },
      "required": [
        "receipt_id",
        "description",
        "required",
        "satisfied",
        "status",
        "receipt_source",
        "paths",
        "validation_marker",
        "creates_source_fact_acceptance",
        "creates_connector_semantics",
        "creates_runtime_resolver_snapshot",
        "executes_replay_or_paper",
        "creates_live_reachability",
        "creates_runtime_cash_or_usable_cash",
        "creates_atomicrows_bundle_or_4183_rows",
        "reduces_blockers",
        "creates_profit_evidence"
      ],
      "additionalProperties": false
    },
    "gate_checks": {
      "type": "object",
      "properties": {
        "owner_start_receipt_present_or_reported_missing": {
          "type": "boolean"
        },
        "master_plan_placement_receipt_present": {
          "type": "boolean"
        },
        "master_plan_hash_receipt_present_or_reported_missing": {
          "type": "boolean"
        },
        "section_manifest_receipt_present": {
          "type": "boolean"
        },
        "traceability_gate_receipt_present": {
          "type": "boolean"
        },
        "atomicrows_schema_checker_blocker_report_receipt_present": {
          "type": "boolean"
        },
        "generated_derivative_gate_receipt_present": {
          "type": "boolean"
        },
        "source_evidence_gate_confirmation_receipt_present": {
          "type": "boolean"
        },
        "stage1_packet_schema_gate_receipt_present": {
          "type": "boolean"
        },
        "venue_neutral_prediction_adapter_gate_receipt_present": {
          "type": "boolean"
        },
        "connector_scaffold_source_required_gate_receipt_present": {
          "type": "boolean"
        },
        "stage1_runtime_scaffold_gate_receipt_present": {
          "type": "boolean"
        },
        "source_fact_binding_connector_semantic_readiness_gate_receipt_present": {
          "type": "boolean"
        },
        "accepted_source_evidence_consumer_contract_gate_receipt_present": {
          "type": "boolean"
        },
        "connector_semantic_binding_ledger_contract_gate_receipt_present": {
          "type": "boolean"
        },
        "runtime_resolver_snapshot_contract_gate_receipt_present": {
          "type": "boolean"
        },
        "runtime_resolver_to_replay_paper_handoff_gate_receipt_present": {
          "type": "boolean"
        },
        "concurrent_replay_paper_contract_gate_receipt_present": {
          "type": "boolean"
        },
        "dual_result_review_contract_gate_receipt_present": {
          "type": "boolean"
        },
        "owner_live_promotion_review_contract_gate_receipt_present": {
          "type": "boolean"
        },
        "three_venue_canary_eligibility_contract_gate_receipt_present": {
          "type": "boolean"
        },
        "no_stale_generated_derivative_completion_claim": {
          "type": "boolean"
        },
        "no_hidden_zip_authority": {
          "type": "boolean"
        },
        "no_source_dependent_connector_semantic_values": {
          "type": "boolean"
        },
        "no_replay_paper_result_claims": {
          "type": "boolean"
        },
        "no_live_reachability_claims": {
          "type": "boolean"
        },
        "no_atomicrows_completion_claim": {
          "type": "boolean"
        },
        "no_blocker_reduction_claim": {
          "type": "boolean"
        },
        "no_profit_claim": {
          "type": "boolean"
        }
      },
      "required": [
        "owner_start_receipt_present_or_reported_missing",
        "master_plan_placement_receipt_present",
        "master_plan_hash_receipt_present_or_reported_missing",
        "section_manifest_receipt_present",
        "traceability_gate_receipt_present",
        "atomicrows_schema_checker_blocker_report_receipt_present",
        "generated_derivative_gate_receipt_present",
        "source_evidence_gate_confirmation_receipt_present",
        "stage1_packet_schema_gate_receipt_present",
        "venue_neutral_prediction_adapter_gate_receipt_present",
        "connector_scaffold_source_required_gate_receipt_present",
        "stage1_runtime_scaffold_gate_receipt_present",
        "source_fact_binding_connector_semantic_readiness_gate_receipt_present",
        "accepted_source_evidence_consumer_contract_gate_receipt_present",
        "connector_semantic_binding_ledger_contract_gate_receipt_present",
        "runtime_resolver_snapshot_contract_gate_receipt_present",
        "runtime_resolver_to_replay_paper_handoff_gate_receipt_present",
        "concurrent_replay_paper_contract_gate_receipt_present",
        "dual_result_review_contract_gate_receipt_present",
        "owner_live_promotion_review_contract_gate_receipt_present",
        "three_venue_canary_eligibility_contract_gate_receipt_present",
        "no_stale_generated_derivative_completion_claim",
        "no_hidden_zip_authority",
        "no_source_dependent_connector_semantic_values",
        "no_replay_paper_result_claims",
        "no_live_reachability_claims",
        "no_atomicrows_completion_claim",
        "no_blocker_reduction_claim",
        "no_profit_claim"
      ],
      "additionalProperties": false
    },
    "filesystem_claim_checks": {
      "type": "object",
      "properties": {
        "canonical_atomicrows_bundle_path": {
          "const": "docs/master_plan/atomic_rows/AtomicRows.bundle.jsonl"
        },
        "canonical_atomicrows_bundle_present": {
          "type": "boolean"
        },
        "canonical_atomicrows_bundle_sha_path": {
          "const": "docs/master_plan/atomic_rows/AtomicRows.bundle.sha256"
        },
        "canonical_atomicrows_bundle_sha_present": {
          "type": "boolean"
        },
        "hidden_zip_authority_present": {
          "type": "boolean"
        },
        "hidden_zip_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "direct_main_bypass_claim_present": {
          "const": false
        }
      },
      "required": [
        "canonical_atomicrows_bundle_path",
        "canonical_atomicrows_bundle_present",
        "canonical_atomicrows_bundle_sha_path",
        "canonical_atomicrows_bundle_sha_present",
        "hidden_zip_authority_present",
        "hidden_zip_paths",
        "direct_main_bypass_claim_present"
      ],
      "additionalProperties": false
    },
    "no_claim_flags": {
      "type": "object",
      "properties": {
        "stale_generated_derivative_completion_claim": {
          "const": false
        },
        "hidden_zip_authority_claim": {
          "const": false
        },
        "direct_main_bypass_claim": {
          "const": false
        },
        "source_dependent_connector_semantic_values_claim": {
          "const": false
        },
        "replay_paper_result_claim": {
          "const": false
        },
        "live_reachability_claim": {
          "const": false
        },
        "atomicrows_completion_claim": {
          "const": false
        },
        "atomicrows_invention_claim": {
          "const": false
        },
        "blocker_reduction_claim": {
          "const": false
        },
        "profit_claim": {
          "const": false
        }
      },
      "required": [
        "stale_generated_derivative_completion_claim",
        "hidden_zip_authority_claim",
        "direct_main_bypass_claim",
        "source_dependent_connector_semantic_values_claim",
        "replay_paper_result_claim",
        "live_reachability_claim",
        "atomicrows_completion_claim",
        "atomicrows_invention_claim",
        "blocker_reduction_claim",
        "profit_claim"
      ],
      "additionalProperties": false
    }
  }
}


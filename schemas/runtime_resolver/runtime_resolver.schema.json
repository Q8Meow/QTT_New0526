  "properties": {
    "mode": {
      "const": "SOURCE_REQUIRED"
    },
    "execution": {
      "const": "DISABLED"
    },
    "schema_authority_class": {
      "const": "STATIC_SCHEMA_CONTRACT_ONLY_NOT_RUNTIME_RESOLVER_AUTHORITY"
    },
    "surface_kind": {
      "const": "RUNTIME_RESOLVER_SOURCE_REQUIRED"
    },
    "resolver_execution_allowed": {
      "const": false
    },
    "candidate_resolution_allowed": {
      "const": false
    },
    "cross_platform_selection_allowed": {
      "const": false
    },
    "market_selection_allowed": {
      "const": false
    },
    "selected_candidate_allowed": {
      "const": false
    },
    "connector_binding_allowed": {
      "const": false
    },
    "source_retrieval_allowed": {
      "const": false
    },
    "source_acceptance_execution_allowed": {
      "const": false
    },
    "private_state_fetch_allowed": {
      "const": false
    },
    "runtime_cash_fetch_allowed": {
      "const": false
    },
    "live_venue_access_allowed": {
      "const": false
    },
    "api_key_use_allowed": {
      "const": false
    },
    "order_execution_allowed": {
      "const": false
    },
    "profit_claim_allowed": {
      "const": false
    },
    "accepted_source_evidence_required_before_resolution": {
      "const": true
    },
    "owner_approval_required_before_live_use": {
      "const": true
    }
  },
  "required": [
    "mode",
    "execution",
    "schema_authority_class",
    "surface_kind",
    "resolver_execution_allowed",
    "candidate_resolution_allowed",
    "cross_platform_selection_allowed",
    "market_selection_allowed",
    "selected_candidate_allowed",
    "connector_binding_allowed",
    "source_retrieval_allowed",
    "source_acceptance_execution_allowed",
    "private_state_fetch_allowed",
    "runtime_cash_fetch_allowed",
    "live_venue_access_allowed",
    "api_key_use_allowed",
    "order_execution_allowed",
    "profit_claim_allowed",
    "accepted_source_evidence_required_before_resolution",
    "owner_approval_required_before_live_use"

{
  "$schema": "json-schema-draft-2020-12",
  "$id": "qtt-local-schemas-dual-result-review-for-parameter-stacks",
  "title": "QTT Dual-Result Review For Parameter Stacks",
  "description": "Static deterministic PR #91 dual-result review packet contract for parameter stacks. This schema permits synthetic schema-validation fixtures only. It requires replay and paper result-shaped references to remain separate, tied to the same shared input identity, and non-evidentiary. It forbids replay execution, paper execution, real replay/paper result packet creation, result merge, owner approval, owner live-promotion review creation, canary eligibility, live promotion, executable order intent, order authority, live routing, connector binding, source retrieval or acceptance, runtime cash/private-state receipts, optimizer execution, quantum backend/simulator execution, profit evidence, advantage claims, and AtomicRows bundle/hash creation.",
  "type": "object",
  "required": [
    "dual_result_review_gate_registry_id",
    "dual_result_review_parameter_stack_packet_contract_id",
    "semantic_task_id",
    "roadmap_pr_label",
    "github_pr_number_policy",
    "gate_scope",
    "policy_version",
    "static_only_flag",
    "metadata_only_flag",
    "synthetic_fixture_only_flag",
    "review_contract_only_flag",
    "review_scope",
    "review_authority_class",
    "upstream_replay_paper_competition_packet_ref",
    "stage1_concurrent_replay_paper_contract_ref",
    "stage1_dual_result_review_contract_ref",
    "upstream_dependencies",
    "future_consumers",
    "required_stack_roles",
    "review_inputs",
    "review_outputs",
    "review_policy",
    "blocked_review_policy",
    "master_plan_principles_consumed",
    "reason_codes",
    "required_no_authority_flags",
    "stage1_prediction_market_contexts",
    "final_ready"
  ],
  "properties": {
    "dual_result_review_gate_registry_id": {
      "const": "QTT_DUAL_RESULT_REVIEW_FOR_PARAMETER_STACKS_GATE"
    },
    "dual_result_review_parameter_stack_packet_contract_id": {
      "const": "QTT_DUAL_RESULT_REVIEW_FOR_PARAMETER_STACKS_V1"
    },
    "semantic_task_id": {
      "const": "ROADMAP-DUAL-RESULT-REVIEW-FOR-PARAMETER-STACKS"
    },
    "roadmap_pr_label": { "const": "PR #91" },
    "github_pr_number_policy": { "const": "may differ" },
    "gate_scope": {
      "const": "STATIC_DUAL_RESULT_REVIEW_FOR_PARAMETER_STACKS_ONLY"
    },
    "policy_version": { "const": "v1" },
    "static_only_flag": { "const": true },
    "metadata_only_flag": { "const": true },
    "synthetic_fixture_only_flag": { "const": true },
    "review_contract_only_flag": { "const": true },
    "review_scope": { "const": "STATIC_ONLY" },
    "review_authority_class": {
      "const": "STATIC_DUAL_RESULT_REVIEW_NOT_REPLAY_EXECUTION_NOT_PAPER_EXECUTION_NOT_LIVE_PROMOTION_NOT_ORDER_AUTHORITY"
    },
    "upstream_replay_paper_competition_packet_ref": { "$ref": "#/$defs/source_ref" },
    "stage1_concurrent_replay_paper_contract_ref": { "$ref": "#/$defs/source_ref" },
    "stage1_dual_result_review_contract_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "future_consumers": {
      "type": "array",
      "items": { "$ref": "#/$defs/future_consumer" }
    },
    "required_stack_roles": {
      "type": "array",
      "items": {
        "enum": [
          "SIGNAL",
          "SCORING",
          "NORMALIZATION",
          "RISK",
          "EXECUTION",
          "CAPITAL",
          "LATENCY",
          "ERROR_GUARD",
          "QUANTUM_ADVISORY"
        ]
      }
    },
    "review_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "review_outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "review_policy": {
      "type": "object",
      "required": [
        "review_policy_id",
        "review_contract_version",
        "stable_sort_required",
        "random_identity_allowed",
        "wall_clock_identity_allowed",
        "review_items_derive_only_from_pr90_competition_packet",
        "selected_stack_lineage_to_pr90_pr89_pr88_pr87_required",
        "replay_result_packet_ref_required_for_schema_fixture",
        "paper_result_packet_ref_required_for_schema_fixture",
        "replay_and_paper_result_refs_must_be_distinct",
        "shared_input_identity_match_required",
        "runtime_resolver_snapshot_match_required",
        "input_lock_match_required",
        "owner_policy_snapshot_match_required",
        "synthetic_result_fixtures_are_not_evidence",
        "comparison_metric_values_real_allowed",
        "result_merge_allowed",
        "result_overwrite_allowed",
        "result_collapse_allowed",
        "pass_route_next_required_state",
        "pr92_owner_live_promotion_review_created",
        "owner_approval_created",
        "live_promotion_created",
        "order_submission_allowed",
        "live_routing_allowed",
        "connector_binding_allowed",
        "quantum_candidates_require_classical_comparator_or_fallback",
        "deterministic_review_chain"
      ],
      "properties": {
        "review_policy_id": {
          "const": "DUAL_RESULT_REVIEW_FOR_PARAMETER_STACKS_POLICY_V1"
        },
        "review_contract_version": { "const": "v1" },
        "stable_sort_required": { "const": true },
        "random_identity_allowed": { "const": false },
        "wall_clock_identity_allowed": { "const": false },
        "review_items_derive_only_from_pr90_competition_packet": { "const": true },
        "selected_stack_lineage_to_pr90_pr89_pr88_pr87_required": { "const": true },
        "replay_result_packet_ref_required_for_schema_fixture": { "const": true },
        "paper_result_packet_ref_required_for_schema_fixture": { "const": true },
        "replay_and_paper_result_refs_must_be_distinct": { "const": true },
        "shared_input_identity_match_required": { "const": true },
        "runtime_resolver_snapshot_match_required": { "const": true },
        "input_lock_match_required": { "const": true },
        "owner_policy_snapshot_match_required": { "const": true },
        "synthetic_result_fixtures_are_not_evidence": { "const": true },
        "comparison_metric_values_real_allowed": { "const": false },
        "result_merge_allowed": { "const": false },
        "result_overwrite_allowed": { "const": false },
        "result_collapse_allowed": { "const": false },
        "pass_route_next_required_state": {
          "const": "OWNER_LIVE_PROMOTION_REVIEW_REQUIRED"
        },
        "pr92_owner_live_promotion_review_created": { "const": false },
        "owner_approval_created": { "const": false },
        "live_promotion_created": { "const": false },
        "order_submission_allowed": { "const": false },
        "live_routing_allowed": { "const": false },
        "connector_binding_allowed": { "const": false },
        "quantum_candidates_require_classical_comparator_or_fallback": { "const": true },
        "deterministic_review_chain": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "blocked_review_policy": {
      "type": "object",
      "required": [
        "blocked_review_policy_id",
        "blocked_or_rejected_items_remain_traceable",
        "blocked_items_enter_active_review_status",
        "blocked_items_retain_reason_codes",
        "blocked_reason_code_order"
      ],
      "properties": {
        "blocked_review_policy_id": {
          "const": "DUAL_RESULT_REVIEW_FOR_PARAMETER_STACKS_BLOCKED_POLICY_V1"
        },
        "blocked_or_rejected_items_remain_traceable": { "const": true },
        "blocked_items_enter_active_review_status": { "const": false },
        "blocked_items_retain_reason_codes": { "const": true },
        "blocked_reason_code_order": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "master_plan_principles_consumed": {
      "type": "array",
      "items": { "$ref": "#/$defs/master_plan_principle" }
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_no_authority_flags": { "$ref": "#/$defs/no_authority_flags" },
    "stage1_prediction_market_contexts": {
      "type": "array",
      "items": { "enum": ["KALSHI", "POLYMARKET", "FORECASTEX_IBKR"] }
    },
    "final_ready": { "const": false }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": [
        "artifact_id",
        "report_path",
        "validator_path",
        "validation_marker"
      ],
      "properties": {
        "artifact_id": { "type": "string" },
        "schema_path": { "type": "string" },
        "registry_path": { "type": "string" },
        "report_path": { "type": "string" },
        "validator_path": { "type": "string" },
        "validation_marker": { "type": "string" },
        "packet_schema_id": { "type": "string" },
        "contract_id": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "artifact_id",
        "delivery_label",
        "title",
        "report_path",
        "validator_path",
        "validation_marker"
      ],
      "properties": {
        "artifact_id": { "type": "string" },
        "delivery_label": { "type": "string" },
        "title": { "type": "string" },
        "schema_path": { "type": "string" },
        "registry_path": { "type": "string" },
        "report_path": { "type": "string" },
        "validator_path": { "type": "string" },
        "validation_marker": { "type": "string" }
      }
    },
    "future_consumer": {
      "type": "object",
      "required": [
        "consumer_id",
        "delivery_label",
        "title",
        "consumer_scope",
        "pr91_creates_consumer_execution"
      ],
      "properties": {
        "consumer_id": { "type": "string" },
        "delivery_label": { "type": "string" },
        "title": { "type": "string" },
        "consumer_scope": { "type": "string" },
        "pr91_creates_consumer_execution": { "const": false }
      }
    },
    "master_plan_principle": {
      "type": "object",
      "required": [
        "principle_id",
        "master_plan_locator",
        "principle_text"
      ],
      "properties": {
        "principle_id": { "type": "string" },
        "master_plan_locator": { "type": "string" },
        "principle_text": { "type": "string" }
      }
    },
    "no_authority_flags": {
      "type": "object",
      "additionalProperties": { "const": false }
    }
  }
}

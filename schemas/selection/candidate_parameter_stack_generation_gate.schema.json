{
  "$schema": "json-schema-draft-2020-12",
  "$id": "qtt-local-schemas-candidate-parameter-stack-generation-gate",
  "title": "QTT Candidate Parameter Stack Generation Gate",
  "description": "Static deterministic candidate parameter-stack generation contract. This schema permits fixture-only candidate packet generation and forbids final selection, replay/paper execution, live/order authority, source retrieval or acceptance, connector binding, runtime cash/private-state authority, classical or quantum optimizer execution, quantum backend/simulator execution, profit evidence, quantum advantage claims, latency/execution superiority claims, and AtomicRows bundle/hash creation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_registry_id",
    "candidate_generation_gate_id",
    "semantic_task_id",
    "roadmap_pr_label",
    "github_pr_number_policy",
    "gate_scope",
    "policy_version",
    "static_only_flag",
    "metadata_only_flag",
    "synthetic_fixture_only_flag",
    "candidate_generation_contract_only_flag",
    "generation_scope",
    "generation_authority_class",
    "routed_selection_universe_source",
    "selection_universe_source",
    "quantum_applicability_source",
    "owner_quantum_priority_source",
    "scoring_policy_source",
    "scoring_ranking_gate_source",
    "optimizer_arbitration_source",
    "upstream_dependencies",
    "future_consumers",
    "required_stack_roles",
    "generation_inputs",
    "generation_outputs",
    "generation_policy",
    "blocked_candidate_policy",
    "master_plan_principles_consumed",
    "reason_codes",
    "required_no_authority_flags",
    "stage1_prediction_market_contexts",
    "final_ready"
  ],
  "properties": {
    "gate_registry_id": { "const": "QTT_CANDIDATE_PARAMETER_STACK_GENERATION_GATE" },
    "candidate_generation_gate_id": { "const": "QTT_CANDIDATE_PARAMETER_STACK_GENERATION_GATE_V1" },
    "semantic_task_id": { "const": "ROADMAP-CANDIDATE-PARAMETER-STACK-GENERATION-GATE" },
    "roadmap_pr_label": { "const": "PR #87" },
    "github_pr_number_policy": { "const": "may differ" },
    "gate_scope": { "const": "STATIC_CANDIDATE_PARAMETER_STACK_GENERATION_GATE_ONLY" },
    "policy_version": { "const": "v1" },
    "static_only_flag": { "const": true },
    "metadata_only_flag": { "const": true },
    "synthetic_fixture_only_flag": { "const": true },
    "candidate_generation_contract_only_flag": { "const": true },
    "generation_scope": { "const": "STATIC_ONLY" },
    "generation_authority_class": { "const": "STATIC_CANDIDATE_GENERATION_GATE_NOT_SELECTION_NOT_EXECUTION" },
    "routed_selection_universe_source": { "$ref": "#/$defs/source_ref" },
    "selection_universe_source": { "$ref": "#/$defs/source_ref" },
    "quantum_applicability_source": { "$ref": "#/$defs/source_ref" },
    "owner_quantum_priority_source": { "$ref": "#/$defs/source_ref" },
    "scoring_policy_source": { "$ref": "#/$defs/source_ref" },
    "scoring_ranking_gate_source": { "$ref": "#/$defs/source_ref" },
    "optimizer_arbitration_source": { "$ref": "#/$defs/source_ref" },
    "upstream_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "future_consumers": {
      "type": "array",
      "items": { "$ref": "#/$defs/future_consumer" }
    },
    "required_stack_roles": {
      "type": "array",
      "items": {
        "enum": [
          "SIGNAL",
          "SCORING",
          "NORMALIZATION",
          "RISK",
          "EXECUTION",
          "CAPITAL",
          "LATENCY",
          "ERROR_GUARD",
          "QUANTUM_ADVISORY"
        ]
      }
    },
    "generation_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "generation_outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "generation_policy": { "$ref": "#/$defs/generation_policy" },
    "blocked_candidate_policy": { "$ref": "#/$defs/blocked_candidate_policy" },
    "master_plan_principles_consumed": {
      "type": "array",
      "items": { "$ref": "#/$defs/master_plan_principle" }
    },
    "reason_codes": {
      "type": "array",
      "items": { "$ref": "#/$defs/reason_code" }
    },
    "required_no_authority_flags": { "$ref": "#/$defs/no_authority_flags" },
    "stage1_prediction_market_contexts": {
      "type": "array",
      "items": { "enum": ["KALSHI", "POLYMARKET", "FORECASTEX_IBKR"] }
    },
    "final_ready": { "const": false }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "registry_path",
        "report_path",
        "validator_path",
        "validation_marker"
      ],
      "properties": {
        "artifact_id": { "type": "string" },
        "registry_path": { "type": "string" },
        "report_path": { "type": "string" },
        "validator_path": { "type": "string" },
        "validation_marker": { "type": "string" },
        "schema_path": { "type": "string" },
        "classification_registry_id": { "type": "string" },
        "policy_source_id": { "type": "string" },
        "policy_registry_id": { "type": "string" },
        "ranking_gate_id": { "type": "string" },
        "optimizer_arbitration_gate_id": { "type": "string" },
        "routing_gate_id": { "type": "string" },
        "selection_universe_registry_id": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "delivery_label",
        "title",
        "registry_path",
        "report_path",
        "validator_path",
        "validation_marker"
      ],
      "properties": {
        "artifact_id": { "type": "string" },
        "delivery_label": { "type": "string" },
        "title": { "type": "string" },
        "registry_path": { "type": "string" },
        "report_path": { "type": "string" },
        "validator_path": { "type": "string" },
        "validation_marker": { "type": "string" }
      }
    },
    "future_consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "delivery_label",
        "title",
        "consumer_scope",
        "pr87_creates_consumer_execution"
      ],
      "properties": {
        "consumer_id": { "type": "string" },
        "delivery_label": { "type": "string" },
        "title": { "type": "string" },
        "consumer_scope": { "type": "string" },
        "pr87_creates_consumer_execution": { "const": false }
      }
    },
    "generation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_policy_id",
        "generation_contract_version",
        "minimum_valid_candidate_stack_count",
        "maximum_total_candidate_stack_count",
        "stable_sort_required",
        "random_generation_allowed",
        "wall_clock_identity_allowed",
        "selected_stack_id_emitted",
        "final_selection_created",
        "candidate_status_order",
        "deterministic_sort_key_order",
        "owner_override_can_force_internal_inclusion_order",
        "owner_quantum_priority_can_affect_static_generation_order",
        "quantum_candidates_require_classical_comparator_or_fallback",
        "replay_paper_competition_required_for_active_candidates"
      ],
      "properties": {
        "generation_policy_id": { "const": "CANDIDATE_PARAMETER_STACK_GENERATION_POLICY_V1" },
        "generation_contract_version": { "const": "v1" },
        "minimum_valid_candidate_stack_count": { "const": 2 },
        "maximum_total_candidate_stack_count": { "const": 8 },
        "stable_sort_required": { "const": true },
        "random_generation_allowed": { "const": false },
        "wall_clock_identity_allowed": { "const": false },
        "selected_stack_id_emitted": { "const": false },
        "final_selection_created": { "const": false },
        "candidate_status_order": {
          "type": "array",
          "items": { "enum": ["ACTIVE_CANDIDATE_STACK", "BLOCKED_CANDIDATE_STACK"] }
        },
        "deterministic_sort_key_order": {
          "type": "array",
          "items": { "type": "string" }
        },
        "owner_override_can_force_internal_inclusion_order": { "const": true },
        "owner_quantum_priority_can_affect_static_generation_order": { "const": true },
        "quantum_candidates_require_classical_comparator_or_fallback": { "const": true },
        "replay_paper_competition_required_for_active_candidates": { "const": true }
      }
    },
    "blocked_candidate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_candidate_policy_id",
        "blocked_candidates_remain_traceable",
        "blocked_candidates_enter_active_candidate_status",
        "blocked_candidates_retain_reason_codes",
        "blocked_reason_code_order"
      ],
      "properties": {
        "blocked_candidate_policy_id": { "const": "CANDIDATE_PARAMETER_STACK_GENERATION_BLOCKED_POLICY_V1" },
        "blocked_candidates_remain_traceable": { "const": true },
        "blocked_candidates_enter_active_candidate_status": { "const": false },
        "blocked_candidates_retain_reason_codes": { "const": true },
        "blocked_reason_code_order": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason_code" }
        }
      }
    },
    "master_plan_principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principle_id",
        "master_plan_locator",
        "principle_text"
      ],
      "properties": {
        "principle_id": { "type": "string" },
        "master_plan_locator": { "type": "string" },
        "principle_text": { "type": "string" }
      }
    },
    "candidate_generation_packet": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "candidate_generation_packet_id",
        "schema_version",
        "roadmap_pr_label",
        "semantic_task_id",
        "github_pr_number_policy",
        "generation_scope",
        "generation_authority_class",
        "routed_selection_universe_ref",
        "selection_universe_fingerprint_or_static_ref",
        "upstream_quantum_applicability_ref",
        "upstream_owner_quantum_priority_ref",
        "upstream_scoring_policy_ref",
        "upstream_scoring_ranking_gate_ref",
        "upstream_optimizer_arbitration_ref",
        "source_dependency_state",
        "candidate_stack_generation_count",
        "replay_paper_competition_required_flag",
        "owner_review_required_flag",
        "not_final_selection_flag",
        "no_order_authority_flag",
        "no_runtime_execution_flag",
        "no_quantum_backend_execution_flag",
        "no_profit_evidence_flag",
        "candidate_stacks"
      ],
      "properties": {
        "candidate_generation_packet_id": { "type": "string" },
        "schema_version": { "const": "v1" },
        "roadmap_pr_label": { "const": "PR #87" },
        "semantic_task_id": { "const": "ROADMAP-CANDIDATE-PARAMETER-STACK-GENERATION-GATE" },
        "github_pr_number_policy": { "const": "may differ" },
        "generation_scope": { "const": "STATIC_ONLY" },
        "generation_authority_class": { "const": "STATIC_CANDIDATE_GENERATION_GATE_NOT_SELECTION_NOT_EXECUTION" },
        "routed_selection_universe_ref": { "type": "string" },
        "selection_universe_fingerprint_or_static_ref": { "type": "string" },
        "upstream_quantum_applicability_ref": { "type": "string" },
        "upstream_owner_quantum_priority_ref": { "type": "string" },
        "upstream_scoring_policy_ref": { "type": "string" },
        "upstream_scoring_ranking_gate_ref": { "type": "string" },
        "upstream_optimizer_arbitration_ref": { "type": "string" },
        "source_dependency_state": { "type": "string" },
        "candidate_stack_generation_count": { "type": "integer", "minimum": 0 },
        "replay_paper_competition_required_flag": { "const": true },
        "owner_review_required_flag": { "type": "boolean" },
        "not_final_selection_flag": { "const": true },
        "no_order_authority_flag": { "const": true },
        "no_runtime_execution_flag": { "const": true },
        "no_quantum_backend_execution_flag": { "const": true },
        "no_profit_evidence_flag": { "const": true },
        "candidate_stacks": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate_stack_descriptor" }
        }
      }
    },
    "candidate_stack_descriptor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "candidate_stack_id",
        "candidate_index",
        "deterministic_generation_key",
        "candidate_authority_class",
        "venue_scope",
        "market_type",
        "strategy_class",
        "edge_type",
        "latency_sensitivity_class",
        "capital_intensity_class",
        "source_dependency_state",
        "signal_family_ids",
        "scoring_family_ids",
        "normalization_family_ids",
        "risk_family_ids",
        "execution_family_ids",
        "capital_family_ids",
        "latency_family_ids",
        "error_guard_family_ids",
        "quantum_advisory_family_ids",
        "quantum_applicability_summary",
        "owner_quantum_priority_summary",
        "classical_comparator_required_flag",
        "classical_comparator_ref",
        "quantum_candidate_type",
        "scoring_policy_refs",
        "ranking_contract_ref",
        "optimizer_arbitration_policy_ref",
        "role_completion_state",
        "compatibility_state",
        "blocker_state",
        "blocked_row_ids_and_reasons",
        "generation_reason_codes",
        "candidate_status",
        "no_final_selection_flag",
        "no_live_order_authority_flag",
        "no_runtime_cash_receipt_flag",
        "no_backend_execution_flag"
      ],
      "properties": {
        "candidate_stack_id": { "type": "string" },
        "candidate_index": { "type": "integer", "minimum": 1 },
        "deterministic_generation_key": { "type": "string" },
        "candidate_authority_class": { "const": "STATIC_CANDIDATE_STACK_DESCRIPTOR_NOT_SELECTION_NOT_EXECUTION" },
        "candidate_status": { "enum": ["ACTIVE_CANDIDATE_STACK", "BLOCKED_CANDIDATE_STACK"] },
        "no_final_selection_flag": { "const": true },
        "no_live_order_authority_flag": { "const": true },
        "no_runtime_cash_receipt_flag": { "const": true },
        "no_backend_execution_flag": { "const": true },
        "blocked_row_ids_and_reasons": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "reason_code": {
      "enum": [
        "CANDIDATE_GENERATION_ALLOWED_STATIC_FIXTURE_ONLY",
        "CANDIDATE_GENERATION_ALLOWED_ROUTED_SELECTION_UNIVERSE_METADATA",
        "CANDIDATE_GENERATION_ALLOWED_SELECTION_UNIVERSE_METADATA",
        "CANDIDATE_GENERATION_ALLOWED_PR82_QUANTUM_APPLICABILITY_METADATA",
        "CANDIDATE_GENERATION_ALLOWED_PR83_OWNER_QUANTUM_PRIORITY_POLICY",
        "CANDIDATE_GENERATION_ALLOWED_PR84_SCORING_POLICY",
        "CANDIDATE_GENERATION_ALLOWED_PR85_RANKING_CONTRACT",
        "CANDIDATE_GENERATION_ALLOWED_PR86_OPTIMIZER_ARBITRATION_METADATA",

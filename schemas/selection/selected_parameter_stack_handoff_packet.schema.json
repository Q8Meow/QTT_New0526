{
  "$schema": "json-schema-draft-2020-12",
  "$id": "qtt-local-schemas-selected-parameter-stack-handoff-packet",
  "title": "QTT Selected Parameter Stack Handoff Packet",
  "description": "Static deterministic selected parameter-stack handoff packet contract. This schema permits fixture-only handoff packaging from the PR #88 trade-context parameter-stack selection packet and forbids executable order intent, order submission, live routing, connector binding, source retrieval or acceptance, runtime cash/private-state receipts, replay/paper execution or results, classical or quantum optimizer execution, quantum backend/simulator execution, owner approval, live promotion, profit evidence, advantage claims, and AtomicRows bundle/hash creation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_registry_id",
    "selected_parameter_stack_handoff_packet_contract_id",
    "semantic_task_id",
    "roadmap_pr_label",
    "github_pr_number_policy",
    "gate_scope",
    "policy_version",
    "static_only_flag",
    "metadata_only_flag",
    "synthetic_fixture_only_flag",
    "handoff_contract_only_flag",
    "handoff_scope",
    "handoff_authority_class",
    "upstream_edge_parameter_stack_selection_packet_ref",
    "upstream_trade_context_packet_ref",
    "upstream_selection_universe_registry_ref",
    "upstream_selection_universe_consumer_gate_ref",
    "upstream_trade_context_routing_gate_ref",
    "upstream_quantum_applicability_ref",
    "upstream_owner_quantum_priority_ref",
    "upstream_scoring_policy_ref",
    "upstream_scoring_ranking_gate_ref",
    "upstream_optimizer_arbitration_ref",
    "upstream_candidate_generation_gate_ref",
    "upstream_trade_context_selection_gate_ref",
    "upstream_dependencies",
    "future_consumers",
    "required_stack_roles",
    "handoff_inputs",
    "handoff_outputs",
    "handoff_policy",
    "blocked_handoff_policy",
    "master_plan_principles_consumed",
    "reason_codes",
    "required_no_authority_flags",
    "stage1_prediction_market_contexts",
    "final_ready"
  ],
  "properties": {
    "handoff_registry_id": { "const": "QTT_SELECTED_PARAMETER_STACK_HANDOFF_PACKET" },
    "selected_parameter_stack_handoff_packet_contract_id": { "const": "QTT_SELECTED_PARAMETER_STACK_HANDOFF_PACKET_V1" },
    "semantic_task_id": { "const": "ROADMAP-SELECTED-PARAMETER-STACK-HANDOFF-PACKET" },
    "roadmap_pr_label": { "const": "PR #89" },
    "github_pr_number_policy": { "const": "may differ" },
    "gate_scope": { "const": "STATIC_SELECTED_PARAMETER_STACK_HANDOFF_PACKET_ONLY" },
    "policy_version": { "const": "v1" },
    "static_only_flag": { "const": true },
    "metadata_only_flag": { "const": true },
    "synthetic_fixture_only_flag": { "const": true },
    "handoff_contract_only_flag": { "const": true },
    "handoff_scope": { "const": "STATIC_ONLY" },
    "handoff_authority_class": {
      "const": "STATIC_SELECTED_PARAMETER_STACK_HANDOFF_NOT_ORDER_INTENT_NOT_EXECUTION"
    },
    "upstream_edge_parameter_stack_selection_packet_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_trade_context_packet_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_selection_universe_registry_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_selection_universe_consumer_gate_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_trade_context_routing_gate_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_quantum_applicability_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_owner_quantum_priority_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_scoring_policy_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_scoring_ranking_gate_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_optimizer_arbitration_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_candidate_generation_gate_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_trade_context_selection_gate_ref": { "$ref": "#/$defs/source_ref" },
    "upstream_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "future_consumers": {
      "type": "array",
      "items": { "$ref": "#/$defs/future_consumer" }
    },
    "required_stack_roles": {
      "type": "array",
      "items": {
        "enum": [
          "SIGNAL",
          "SCORING",
          "NORMALIZATION",
          "RISK",
          "EXECUTION",
          "CAPITAL",
          "LATENCY",
          "ERROR_GUARD",
          "QUANTUM_ADVISORY"
        ]
      }
    },
    "handoff_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "handoff_outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "handoff_policy": { "$ref": "#/$defs/handoff_policy" },
    "blocked_handoff_policy": { "$ref": "#/$defs/blocked_handoff_policy" },
    "master_plan_principles_consumed": {
      "type": "array",
      "items": { "$ref": "#/$defs/master_plan_principle" }
    },
    "reason_codes": {
      "type": "array",
      "items": { "$ref": "#/$defs/reason_code" }
    },
    "required_no_authority_flags": { "$ref": "#/$defs/no_authority_flags" },
    "stage1_prediction_market_contexts": {
      "type": "array",
      "items": { "enum": ["KALSHI", "POLYMARKET", "FORECASTEX_IBKR"] }
    },
    "final_ready": { "const": false }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "registry_path",
        "report_path",
        "validator_path",
        "validation_marker"
      ],
      "properties": {
        "artifact_id": { "type": "string" },
        "schema_path": { "type": "string" },
        "registry_path": { "type": "string" },
        "report_path": { "type": "string" },
        "validator_path": { "type": "string" },
        "validation_marker": { "type": "string" },
        "packet_schema_id": { "type": "string" },
        "routing_gate_id": { "type": "string" },
        "selection_universe_registry_id": { "type": "string" },
        "selection_universe_consumer_gate_id": { "type": "string" },
        "classification_registry_id": { "type": "string" },
        "policy_source_id": { "type": "string" },
        "policy_registry_id": { "type": "string" },
        "ranking_gate_id": { "type": "string" },
        "optimizer_arbitration_gate_id": { "type": "string" },
        "candidate_generation_gate_id": { "type": "string" },
        "trade_context_parameter_stack_selection_gate_id": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "delivery_label",
        "title",
        "registry_path",
        "report_path",
        "validator_path",
        "validation_marker"
      ],
      "properties": {
        "artifact_id": { "type": "string" },
        "delivery_label": { "type": "string" },
        "title": { "type": "string" },
        "registry_path": { "type": "string" },
        "report_path": { "type": "string" },
        "validator_path": { "type": "string" },
        "validation_marker": { "type": "string" }
      }
    },
    "future_consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "delivery_label",
        "title",
        "consumer_scope",
        "pr89_creates_consumer_execution"
      ],
      "properties": {
        "consumer_id": { "type": "string" },
        "delivery_label": { "type": "string" },
        "title": { "type": "string" },
        "consumer_scope": { "type": "string" },
        "pr89_creates_consumer_execution": { "const": false }
      }
    },
    "handoff_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_policy_id",
        "handoff_contract_version",
        "stable_sort_required",
        "random_identity_allowed",
        "wall_clock_identity_allowed",
        "selected_handoff_item_count_for_valid_fixture",
        "replay_paper_competition_required_for_selected_handoff",
        "replay_paper_input_lock_required_for_selected_handoff",
        "pr90_competition_gate_required_for_selected_handoff",
        "owner_review_required_for_selected_handoff",
        "order_intent_surface_authority",
        "order_submission_allowed",
        "live_routing_allowed",
        "connector_binding_allowed",
        "quantum_candidates_require_classical_comparator_or_fallback",
        "deterministic_tie_break_chain"
      ],
      "properties": {
        "handoff_policy_id": { "const": "SELECTED_PARAMETER_STACK_HANDOFF_POLICY_V1" },
        "handoff_contract_version": { "const": "v1" },
        "stable_sort_required": { "const": true },
        "random_identity_allowed": { "const": false },
        "wall_clock_identity_allowed": { "const": false },
        "selected_handoff_item_count_for_valid_fixture": { "const": 1 },
        "replay_paper_competition_required_for_selected_handoff": { "const": true },
        "replay_paper_input_lock_required_for_selected_handoff": { "const": true },
        "pr90_competition_gate_required_for_selected_handoff": { "const": true },
        "owner_review_required_for_selected_handoff": { "const": true },
        "order_intent_surface_authority": { "const": "NON_AUTHORITATIVE_STATIC_PREVIEW_ONLY" },
        "order_submission_allowed": { "const": false },
        "live_routing_allowed": { "const": false },
        "connector_binding_allowed": { "const": false },
        "quantum_candidates_require_classical_comparator_or_fallback": { "const": true },
        "deterministic_tie_break_chain": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "blocked_handoff_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_handoff_policy_id",
        "blocked_or_rejected_candidates_remain_traceable",
        "blocked_candidates_enter_active_handoff_status",
        "blocked_candidates_retain_reason_codes",
        "blocked_reason_code_order"
      ],
      "properties": {
        "blocked_handoff_policy_id": { "const": "SELECTED_PARAMETER_STACK_HANDOFF_BLOCKED_POLICY_V1" },
        "blocked_or_rejected_candidates_remain_traceable": { "const": true },
        "blocked_candidates_enter_active_handoff_status": { "const": false },
        "blocked_candidates_retain_reason_codes": { "const": true },
        "blocked_reason_code_order": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason_code" }
        }
      }
    },
    "master_plan_principle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principle_id", "master_plan_locator", "principle_text"],
      "properties": {
        "principle_id": { "type": "string" },
        "master_plan_locator": { "type": "string" },
        "principle_text": { "type": "string" }
      }
    },
    "reason_code": { "type": "string" },
    "no_authority_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_intent_authority_created",
        "order_submission_allowed_flag",
        "live_routing_allowed_flag",
        "connector_binding_allowed_flag",
        "source_retrieval_created_flag",
        "source_acceptance_created_flag",
        "connector_semantic_binding_created_flag",
        "runtime_cash_receipt_created_flag",
        "replay_execution_created_flag",
        "paper_execution_created_flag",
        "replay_result_packet_created_flag",
        "paper_result_packet_created_flag",
        "classical_optimizer_execution_created_flag",
        "quantum_optimizer_execution_created_flag",
        "optimizer_execution_created_flag",
        "quantum_backend_execution_created_flag",
        "quantum_simulator_execution_created_flag",
        "owner_approval_created_flag",
        "live_trade_authority_created_flag",
        "live_promotion_created_flag",
        "profit_evidence_created_flag",
        "quantum_advantage_claim_created_flag",
        "latency_superiority_claim_created_flag",
        "execution_superiority_claim_created_flag",
        "random_identity_used",
        "wall_clock_identity_used",
        "atomicrows_bundle_jsonl_created",
        "atomicrows_bundle_sha256_created"
      ],
      "properties": {
        "order_intent_authority_created": { "const": false },
        "order_submission_allowed_flag": { "const": false },
        "live_routing_allowed_flag": { "const": false },
        "connector_binding_allowed_flag": { "const": false },
        "source_retrieval_created_flag": { "const": false },
        "source_acceptance_created_flag": { "const": false },
        "connector_semantic_binding_created_flag": { "const": false },
        "runtime_cash_receipt_created_flag": { "const": false },
        "replay_execution_created_flag": { "const": false },
        "paper_execution_created_flag": { "const": false },
        "replay_result_packet_created_flag": { "const": false },
        "paper_result_packet_created_flag": { "const": false },
        "classical_optimizer_execution_created_flag": { "const": false },
        "quantum_optimizer_execution_created_flag": { "const": false },
        "optimizer_execution_created_flag": { "const": false },
        "quantum_backend_execution_created_flag": { "const": false },
        "quantum_simulator_execution_created_flag": { "const": false },
        "owner_approval_created_flag": { "const": false },
        "live_trade_authority_created_flag": { "const": false },
        "live_promotion_created_flag": { "const": false },
        "profit_evidence_created_flag": { "const": false },
        "quantum_advantage_claim_created_flag": { "const": false },
        "latency_superiority_claim_created_flag": { "const": false },
        "execution_superiority_claim_created_flag": { "const": false },
        "random_identity_used": { "const": false },
        "wall_clock_identity_used": { "const": false },
        "atomicrows_bundle_jsonl_created": { "const": false },
        "atomicrows_bundle_sha256_created": { "const": false }
      }
    }
  }
}

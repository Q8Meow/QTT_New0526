{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/schemas/source_fact_binding_readiness/stage1_connector_semantic_readiness_gate_report.schema.json",
  "title": "Stage-1 Connector Semantic Readiness Gate Report Static Schema",
  "description": "Static pre-acceptance readiness gate report. It represents source-fact binding readiness receipts and connector semantic readiness receipts without accepting source facts, populating connector semantic values, creating runtime resolver snapshots, creating live reachability, creating order authority, creating AtomicRows authority, reducing blockers, or creating profit evidence.",
  "type": "object",
  "properties": {
    "report_type": {
      "const": "STAGE1_CONNECTOR_SEMANTIC_READINESS_GATE_REPORT"
    },
    "report_version": {
      "const": "PR38_STAGE1_CONNECTOR_SEMANTIC_READINESS_GATE_REPORT_V1"
    },
    "task_packet_type": {
      "const": "SOURCE_FACT_BINDING_CONNECTOR_SEMANTIC_READINESS_TASK_PACKET"
    },
    "report_authority_class": {
      "const": "STATIC_PRE_ACCEPTANCE_READINESS_REPORT_ONLY_NOT_SOURCE_FACT_NOT_CONNECTOR_VALUE_AUTHORITY"
    },
    "mode": {
      "const": "SOURCE_REQUIRED"
    },
    "execution": {
      "const": "DISABLED"
    },
    "status": {
      "const": "BLOCKED"
    },
    "gate_state": {
      "const": "BLOCKED_PENDING_ACCEPTED_SOURCE_PACKET"
    },
    "generated_at_utc": {
      "const": "STATIC_DETERMINISTIC_NO_WALL_CLOCK"
    },
    "authority_boundary_statement": {
      "const": "This readiness report creates no official source fact, no connector semantic value, no runtime resolver snapshot, no live reachability, no order authority, no AtomicRows authority, no blocker reduction, and no profit evidence."
    },
    "required_typed_artifacts_represented": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "enum": [
          "SOURCE_FACT_BINDING_CONNECTOR_SEMANTIC_READINESS_TASK_PACKET",
          "SOURCE_FACT_BINDING_CONNECTOR_SEMANTIC_READINESS_RECEIPT",
          "SOURCE_FACT_BINDING_CONNECTOR_SEMANTIC_READINESS_BLOCK_RECEIPT",
          "STAGE1_SOURCE_FACT_BINDING_READINESS_RECEIPT",
          "STAGE1_CONNECTOR_SEMANTIC_READINESS_GATE_RECEIPT",
          "STAGE1_SOURCE_TO_CONNECTOR_FIELD_BINDING_MATRIX",
          "STAGE1_CONNECTOR_SEMANTIC_TARGET_FIELD_MATRIX",
          "STAGE1_CONNECTOR_SEMANTIC_READINESS_GATE_REPORT",
          "SOURCE_FACT_BINDING_NO_FACT_ACCEPTANCE_RECEIPT",
          "CONNECTOR_SEMANTIC_READINESS_NO_VALUE_POPULATION_RECEIPT",
          "CONNECTOR_SEMANTIC_ACCEPTED_PACKET_REQUIRED_RECEIPT"
        ]
      }
    },
    "artifact_refs": {
      "$ref": "#/$defs/artifact_refs"
    },
    "source_fact_binding_readiness_report": {
      "$ref": "#/$defs/source_fact_binding_readiness_report"
    },
    "connector_semantic_readiness_summary": {
      "$ref": "#/$defs/connector_semantic_readiness_summary"
    },
    "receipt_ids_emitted": {
      "type": "array",
      "minItems": 7,
      "items": {
        "enum": [
          "SOURCE_FACT_BINDING_CONNECTOR_SEMANTIC_READINESS_RECEIPT",
          "SOURCE_FACT_BINDING_CONNECTOR_SEMANTIC_READINESS_BLOCK_RECEIPT",
          "STAGE1_SOURCE_FACT_BINDING_READINESS_RECEIPT",
          "STAGE1_CONNECTOR_SEMANTIC_READINESS_GATE_RECEIPT",
          "SOURCE_FACT_BINDING_NO_FACT_ACCEPTANCE_RECEIPT",
          "CONNECTOR_SEMANTIC_READINESS_NO_VALUE_POPULATION_RECEIPT",
          "CONNECTOR_SEMANTIC_ACCEPTED_PACKET_REQUIRED_RECEIPT"
        ]
      }
    },
    "atomicrows_authority_state": {
      "$ref": "#/$defs/atomicrows_authority_state"
    },
    "forbidden_action_flags": {
      "$ref": "#/$defs/forbidden_action_flags"
    },
    "no_claim_flags": {
      "$ref": "#/$defs/no_claim_flags"
    },
    "validation_hook_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "SOURCE_FACT_BINDING_CONNECTOR_SEMANTIC_READINESS_STATIC_AUDIT"
      }
    }
  },
  "required": [
    "report_type",
    "report_version",
    "task_packet_type",
    "report_authority_class",
    "mode",
    "execution",
    "status",
    "gate_state",
    "generated_at_utc",
    "authority_boundary_statement",
    "required_typed_artifacts_represented",
    "artifact_refs",
    "source_fact_binding_readiness_report",
    "connector_semantic_readiness_summary",
    "receipt_ids_emitted",
    "atomicrows_authority_state",
    "forbidden_action_flags",
    "no_claim_flags",
    "validation_hook_ids"
  ],
  "additionalProperties": false,

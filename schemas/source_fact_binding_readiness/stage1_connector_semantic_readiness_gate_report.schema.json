        },
        "semantic_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "semantic_surface_ready_for_accepted_packet_count": {
          "const": 0
        },
        "semantic_surface_blocked_packet_missing_count": {
          "type": "integer",
          "minimum": 1
        },
        "accepted_source_fact_created_count": {
          "const": 0
        },
        "connector_semantic_value_populated_count": {
          "const": 0
        },
        "runtime_resolver_snapshot_violation_count": {
          "const": 0
        },
        "replay_paper_execution_violation_count": {
          "const": 0
        },
        "live_reachability_violation_count": {
          "const": 0
        },
        "atomicrows_mutation_violation_count": {
          "const": 0
        },
        "blocker_reduction_or_profit_claim_violation_count": {
          "const": 0
        }
      },
      "required": [
        "venue_ids_checked",
        "semantic_surface_count",
        "semantic_surface_ready_for_accepted_packet_count",
        "semantic_surface_blocked_packet_missing_count",
        "accepted_source_fact_created_count",
        "connector_semantic_value_populated_count",
        "runtime_resolver_snapshot_violation_count",
        "replay_paper_execution_violation_count",
        "live_reachability_violation_count",
        "atomicrows_mutation_violation_count",
        "blocker_reduction_or_profit_claim_violation_count"
      ],
      "additionalProperties": false
    },
    "atomicrows_authority_state": {
      "type": "object",
      "properties": {
        "canonical_bundle_path": {
          "const": "docs/master_plan/atomic_rows/AtomicRows.bundle.jsonl"

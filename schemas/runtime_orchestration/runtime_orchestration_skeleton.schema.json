        "no_claim_flags"
      ],
      "additionalProperties": false
    },
    "state_placeholder": {
      "type": "object",
      "properties": {
        "state_id": {
          "enum": [
            "RUNTIME_ORCHESTRATION_DISABLED",
            "SOURCE_REQUIRED_BLOCKED",
            "OWNER_APPROVAL_BLOCKED"
          ]
        },
        "state_status": {
          "const": "SCAFFOLD_ONLY_NOT_EXECUTABLE"
        },
        "state_execution_allowed": {
          "const": false
        },
        "entry_action_allowed": {
          "const": false
        },
        "exit_action_allowed": {
          "const": false

        "synthetic_records_only": {
          "const": true
        },
        "accepted_source_evidence_required_before_runtime_use": {
          "const": true
        },
        "accepted_source_evidence_present": {
          "const": false
        },
        "external_fact_acceptance_allowed": {
          "const": false
        },
        "source_retrieval_allowed": {
          "const": false
        },
        "source_acceptance_allowed": {
          "const": false
        },
        "connector_binding_allowed": {
          "const": false

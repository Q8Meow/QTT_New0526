        "initial_state": {
          "const": "RUNTIME_ORCHESTRATION_DISABLED"
        },
        "terminal_state": {
          "const": "RUNTIME_ORCHESTRATION_DISABLED"
        },
        "transition_execution_allowed": {
          "const": false
        },
        "runtime_execution_allowed": {
          "const": false
        },
        "live_transition_allowed": {
          "const": false
        },
        "order_transition_allowed": {
          "const": false
        },
        "state_placeholders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state_placeholder"
          }
        },
        "runtime_authority_scope_flags": {
          "$ref": "#/$defs/runtime_authority_scope_flags"
        },
        "runtime_forbidden_action_flags": {
          "$ref": "#/$defs/runtime_forbidden_action_flags"
        },
        "no_claim_flags": {

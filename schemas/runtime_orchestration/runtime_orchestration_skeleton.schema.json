    "receipt_envelope_placeholder": {
      "type": "object",
      "description": "Synthetic receipt-envelope placeholder only. It is not a runtime result, runtime resolver snapshot, replay result, paper result, cash receipt, or order receipt.",
      "properties": {
        "receipt_envelope_type": {
          "const": "RUNTIME_ORCHESTRATION_RECEIPT_ENVELOPE_PLACEHOLDER"
        },
        "receipt_id": {
          "$ref": "#/$defs/record_id"
        },
        "receipt_state": {
          "const": "PLACEHOLDER_ONLY_NOT_CREATED"
        },
        "mode": {
          "const": "SOURCE_REQUIRED"
        },
        "execution": {
          "const": "DISABLED"
        },
        "scaffold_state": {
          "const": "SCAFFOLD_ONLY"
        },
        "contains_runtime_result": {
          "const": false
        },
        "contains_runtime_resolver_snapshot": {
          "const": false
        },
        "contains_replay_result_packet": {
          "const": false
        },
        "contains_paper_result_packet": {
          "const": false
        },
        "contains_runtime_cash_receipt": {
          "const": false
        },
        "contains_order_receipt": {
          "const": false
        },
        "contains_accepted_source_fact": {
          "const": false

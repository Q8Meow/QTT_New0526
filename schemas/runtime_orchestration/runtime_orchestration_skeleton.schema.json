    "runtime_orchestration_skeleton": {
      "type": "object",
      "description": "Non-live runtime orchestration scaffold. It records only synthetic receipt-envelope, state-machine, and gate placeholders.",
      "properties": {
        "skeleton_type": {
          "const": "RUNTIME_ORCHESTRATION_SKELETON_STATIC_SCAFFOLD"
        },
        "skeleton_id": {
          "$ref": "#/$defs/record_id"
        },
        "skeleton_authority_class": {
          "const": "STATIC_RUNTIME_ORCHESTRATION_SKELETON_NOT_RUNTIME_AUTHORITY"
        },
        "mode": {
          "const": "SOURCE_REQUIRED"
        },
        "execution": {
          "const": "DISABLED"
        },
        "scaffold_state": {
          "const": "SCAFFOLD_ONLY"
        },
        "deterministic_output": {
          "const": true
        },
        "runtime_authority_scope_flags": {
          "$ref": "#/$defs/runtime_authority_scope_flags"
        },
        "runtime_forbidden_action_flags": {
          "$ref": "#/$defs/runtime_forbidden_action_flags"
        },
        "receipt_envelopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/receipt_envelope_placeholder"
          }
        },
        "state_machine_placeholders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state_machine_placeholder"
          }
        },
        "gate_placeholders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate_placeholder"
          }
        },
        "validation_hook_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "no_claim_flags": {
          "$ref": "#/$defs/no_claim_flags"
        }

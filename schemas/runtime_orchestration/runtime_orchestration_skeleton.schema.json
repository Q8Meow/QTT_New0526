{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/schemas/runtime_orchestration/runtime_orchestration_skeleton.schema.json",
  "title": "Static Runtime Orchestration Skeleton Schema",
  "description": "Static/offline runtime orchestration skeleton scaffold. This schema creates no runtime execution, live path, source retrieval, accepted external fact, connector semantic binding, private-state fetch, runtime resolver snapshot, replay execution, paper execution, runtime cash receipt, order execution, AtomicRows bundle/hash, SHA/freeze authority, or profit claim.",
  "type": "object",
  "properties": {
    "mode": {
      "const": "SOURCE_REQUIRED"
    },
    "execution": {
      "const": "DISABLED"
    },
    "schema_authority_class": {
      "const": "STATIC_SCHEMA_CONTRACT_ONLY_NOT_RUNTIME_ORCHESTRATION_AUTHORITY"
    },
    "surface_kind": {
      "const": "RUNTIME_ORCHESTRATION_SKELETON_STATIC_SCAFFOLD"
    },
    "surface_version": {
      "const": "PR22_RUNTIME_ORCHESTRATION_SKELETON_SCHEMA_V1"
    },
    "deterministic_output": {
      "const": true
    },
    "example_authority_class": {
      "const": "SYNTHETIC_NON_AUTHORITATIVE_EXAMPLE_NOT_SOURCE_FACT"
    },
    "no_claim_flags": {
      "$ref": "#/$defs/no_claim_flags"
    },
    "runtime_orchestration_skeleton": {
      "$ref": "#/$defs/runtime_orchestration_skeleton"
    }
  },
  "required": [
    "mode",
    "execution",
    "schema_authority_class",
    "surface_kind",
    "surface_version",
    "deterministic_output",
    "no_claim_flags",
    "runtime_orchestration_skeleton"
  ],
  "additionalProperties": false,
  "$defs": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z0-9_:-]+$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "synthetic_reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^SYNTHETIC_"
    },
    "source_required_reference": {
      "const": "SOURCE_REQUIRED_NO_ACCEPTED_SOURCE_EVIDENCE"
    },
    "no_claim_flags": {
      "type": "object",
      "properties": {
        "external_fact_authority": {
          "const": false
        },
        "source_retrieval_authority": {
          "const": false
        },
        "source_acceptance_execution_authority": {
          "const": false
        },
        "accepted_packet_creation_authority": {
          "const": false
        },
        "connector_binding_authority": {
          "const": false
        },
        "connector_semantic_value_authority": {

      "required": [
        "skeleton_type",
        "skeleton_id",
        "skeleton_authority_class",
        "mode",
        "execution",
        "scaffold_state",
        "deterministic_output",
        "runtime_authority_scope_flags",
        "runtime_forbidden_action_flags",
        "receipt_envelopes",
        "state_machine_placeholders",
        "gate_placeholders",
        "validation_hook_ids",
        "no_claim_flags"
      ],
      "additionalProperties": false
    }

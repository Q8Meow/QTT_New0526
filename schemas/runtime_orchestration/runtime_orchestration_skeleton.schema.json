        "order_transition_allowed",
        "state_placeholders",
        "runtime_authority_scope_flags",
        "runtime_forbidden_action_flags",
        "no_claim_flags"
      ],
      "additionalProperties": false
    },
    "gate_placeholder": {
      "type": "object",
      "description": "Synthetic gate placeholder only. It cannot evaluate, open runtime, open live use, or open order authority.",
      "properties": {
        "gate_type": {
          "const": "RUNTIME_ORCHESTRATION_GATE_PLACEHOLDER"
        },
        "gate_id": {
          "$ref": "#/$defs/record_id"
        },
        "gate_state": {

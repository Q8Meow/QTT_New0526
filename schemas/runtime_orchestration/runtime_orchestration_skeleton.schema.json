        "accepted_source_packet_creation_enabled": {
          "const": false
        },
        "connector_binding_enabled": {
          "const": false
        },
        "semantic_value_population_enabled": {
          "const": false
        },
        "runtime_enabled": {
          "const": false
        },
        "runtime_execution_enabled": {
          "const": false
        },
        "runtime_trading_enabled": {
          "const": false
        },
        "runtime_resolver_snapshot_creation_enabled": {

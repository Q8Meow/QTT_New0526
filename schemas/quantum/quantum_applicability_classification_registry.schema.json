        "QUANTUM_INSPIRED",
        "QUBO_COMPATIBLE",
        "ISING_COMPATIBLE",
        "QAOA_COMPATIBLE",
        "VQE_COMPATIBLE",
        "ANNEALING_COMPATIBLE",
        "QUANTUM_PORTFOLIO_OPTIMIZATION_COMPATIBLE",
        "CLASSICAL_ONLY"
      ]

    "owner_override_basis": {
      "enum": [
        "NONE",
        "OWNER_APPROVED",
        "OWNER_APPROVED_OVERRIDE",
        "OWNER_GLOBAL_OVERRIDE",
        "OWNER_OVERRIDE_SATISFIED",
        "AGENT_ASSIGNMENT_OWNER_APPROVED",
        "OWNER_APPROVED_NOT_EXTERNALLY_VERIFIED",

        "family_id": { "type": "string" },
        "family_type": { "type": "string" },
        "family_registry_source": { "type": "string" },
        "source_registry": { "type": "string" },
        "applicability_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/classification_label" }
        },
        "primary_quantum_applicability_class": { "$ref": "#/$defs/primary_class" },
        "classical_comparator_required": { "type": "boolean" },
        "classical_only_comparator_valid": { "type": "boolean" },
        "owner_override_basis": { "$ref": "#/$defs/owner_override_basis" },
        "owner_override_applied": { "type": "boolean" },
        "owner_override_external_fact_fabrication_created": { "const": false },
        "metadata_only_flag": { "const": true },
        "fixture_only": { "type": "boolean" },
        "future_owner_quantum_priority_policy_required": { "const": true },
        "future_scoring_policy_required": { "const": true },
        "future_optimizer_arbitration_required": { "const": true },
        "reason_codes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason_code" }

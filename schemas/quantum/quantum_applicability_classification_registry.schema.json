    "primary_class": {
      "enum": [
        "TRUE_QUANTUM",
        "HYBRID_CLASSICAL_QUANTUM",
        "QUANTUM_INSPIRED",
        "CLASSICAL_ONLY"
      ]
    },
    "reason_code": {
      "enum": [
        "QUANTUM_APPLICABILITY_ALLOWED_METADATA_ONLY",
        "QUANTUM_APPLICABILITY_ALLOWED_CLASSICAL_COMPARATOR",

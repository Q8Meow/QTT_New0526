    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "registry_path",
        "report_path",
        "validator_path",
        "validation_marker"
      ],
      "properties": {
        "artifact_id": { "type": "string" },
        "registry_path": { "type": "string" },
        "report_path": { "type": "string" },
        "validator_path": { "type": "string" },
        "validation_marker": { "type": "string" }
      }
    },
    "family_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "family_type",
        "family_registry_source",
        "source_registry",
        "applicability_labels",
        "primary_quantum_applicability_class",
        "classical_comparator_required",
        "classical_only_comparator_valid",
        "owner_override_basis",
        "owner_override_applied",

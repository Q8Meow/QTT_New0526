{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/schemas/replay_paper_review/replay_paper_execution_graph.schema.json",
  "title": "Static Replay/Paper Execution Graph Schema",
  "description": "Static/offline replay/paper execution graph scaffold. This schema creates no runtime execution, live path, source retrieval, accepted external fact, connector semantic binding, private-state fetch, runtime resolver snapshot, replay execution, paper execution, replay result packet, paper result packet, dual-result review, live eligibility, runtime cash receipt, order execution, AtomicRows bundle/hash, SHA/freeze authority, or profit claim.",
  "type": "object",
  "properties": {
    "mode": {
      "const": "SOURCE_REQUIRED"
    },
    "execution": {
      "const": "DISABLED"
    },
    "schema_authority_class": {
      "const": "STATIC_SCHEMA_CONTRACT_ONLY_NOT_REPLAY_PAPER_EXECUTION_AUTHORITY"
    },
    "surface_kind": {
      "const": "REPLAY_PAPER_EXECUTION_GRAPH_STATIC_SCAFFOLD"
    },
    "surface_version": {
      "const": "PR23_REPLAY_PAPER_EXECUTION_GRAPH_SCHEMA_V1"
    },
    "deterministic_output": {
      "const": true
    },
    "example_authority_class": {
      "const": "SYNTHETIC_NON_AUTHORITATIVE_EXAMPLE_NOT_SOURCE_FACT"
    },
    "no_claim_flags": {
      "$ref": "#/$defs/no_claim_flags"
    },
    "replay_paper_execution_graph": {
      "$ref": "#/$defs/replay_paper_execution_graph"
    }
  },
  "required": [
    "mode",
    "execution",
    "schema_authority_class",
    "surface_kind",
    "surface_version",
    "deterministic_output",
    "no_claim_flags",
    "replay_paper_execution_graph"
  ],
  "additionalProperties": false,

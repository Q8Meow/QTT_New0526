      "minLength": 1
    },
    "synthetic_reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^SYNTHETIC_"
    },
    "source_required_reference": {
      "const": "SOURCE_REQUIRED_NO_ACCEPTED_SOURCE_EVIDENCE"

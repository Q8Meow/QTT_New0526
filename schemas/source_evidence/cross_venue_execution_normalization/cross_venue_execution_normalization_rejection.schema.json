  "required": [
    "cross_venue_execution_normalization_rejection_id",
    "cross_venue_normalization_validation_receipt_id",
    "fixture_authority_class",
    "normalization_state",
    "rejection_reason_code",
    "production_cross_venue_normalization_authority",
    "production_arbitrage_comparability_authority",
    "future_production_launch_path_preserved"
  ],
  "properties": {
    "fixture_authority_class": { "const": "TEST_FIXTURE_NOT_EXTERNAL_FACT" },
    "production_cross_venue_normalization_authority": { "const": false },
    "production_arbitrage_comparability_authority": { "const": false },
    "future_production_launch_path_preserved": { "const": true }
  }
}

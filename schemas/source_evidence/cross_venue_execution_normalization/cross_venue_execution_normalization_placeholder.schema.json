  "$id": "qtt-source-evidence-cross-venue-execution-normalization-placeholder-v1",
  "title": "Cross-Venue Execution Normalization Placeholder",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "placeholder_normalization_record_type",
    "placeholder_normalization_id",
    "normalization_dimension",
    "venue_ids_in_scope",
    "accepted_source_evidence_required_flag",
    "runtime_receipt_required_flag",
    "production_value_populated",
    "fixture_authority_class",
    "production_cross_venue_normalization_authority",
    "production_arbitrage_comparability_authority",
    "future_pr_required_for_production_population"
  ],
  "properties": {
    "fixture_authority_class": { "const": "TEST_FIXTURE_NOT_EXTERNAL_FACT" },
    "accepted_source_evidence_required_flag": { "const": true },
    "production_value_populated": { "const": false },
    "production_cross_venue_normalization_authority": { "const": false },
    "production_arbitrage_comparability_authority": { "const": false }
  }

    "order_execution_allowed_flag": { "const": false },
    "order_routing_authority_allowed_flag": { "const": false },
    "network_io_allowed_flag": { "const": false },
    "runtime_cash_receipt_allowed_flag": { "const": false },
    "private_state_fetch_allowed_flag": { "const": false },
    "replay_paper_execution_allowed_flag": { "const": false },
    "runtime_resolver_snapshot_creation_allowed_flag": { "const": false }

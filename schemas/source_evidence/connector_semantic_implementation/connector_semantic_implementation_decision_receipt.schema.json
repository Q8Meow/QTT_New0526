{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/schemas/source_evidence/connector_semantic_implementation/connector_semantic_implementation_decision_receipt.schema.json",
  "title": "Connector Semantic Implementation Decision Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation_decision_receipt_id",
    "fixture_authority_class",
    "source_connector_binding_ledger_record_id",
    "accepted_source_evidence_packet_id",
    "source_change_snapshot_id",
    "venue_id",
    "target_field_path",
    "semantic_surface_id",
    "canonical_connector_namespace",
    "implementation_gate_state",
    "implementation_decision_state",
    "implementation_manifest_state",
    "connector_binding_revalidation_state",
    "source_change_snapshot_state",
    "decision_reason_code",
    "deterministic_fixture_time",
    "production_connector_semantic_implementation_authority",
    "production_connector_use_allowed_flag",
    "network_io_allowed_flag",
    "order_execution_allowed_flag",
    "production_reachability_allowed_flag",
    "runtime_resolver_snapshot_creation_allowed_flag",
    "replay_paper_execution_allowed_flag",
    "future_production_launch_path_preserved",
    "accepted_source_fixture_authority_class"
  ],
  "properties": {
    "implementation_decision_receipt_id": { "type": "string" },
    "fixture_authority_class": { "const": "TEST_FIXTURE_NOT_EXTERNAL_FACT" },
    "source_connector_binding_ledger_record_id": { "type": "string" },
    "accepted_source_evidence_packet_id": { "type": "string" },
    "source_change_snapshot_id": { "type": "string" },
    "venue_id": { "type": "string" },
    "target_field_path": { "type": "string" },
    "semantic_surface_id": { "type": "string" },
    "canonical_connector_namespace": { "type": "string" },
    "implementation_gate_state": { "$ref": "#/$defs/implementationGateState" },
    "implementation_decision_state": {
      "enum": [
        "IMPLEMENTATION_ELIGIBLE_FOR_PR126_FIXTURE_SCOPE_MANIFEST",
        "IMPLEMENTATION_REJECTED_FOR_PR126_FIXTURE_SCOPE_MANIFEST"
      ]
    },
    "implementation_manifest_state": {
      "enum": [
        "PR126_FIXTURE_SCOPE_MANIFEST_READY",
        "PR126_FIXTURE_SCOPE_MANIFEST_NOT_CREATED"
      ]
    },
    "connector_binding_revalidation_state": { "type": "string" },
    "source_change_snapshot_state": { "type": "string" },
    "decision_reason_code": { "type": "string" },
    "deterministic_fixture_time": { "const": "2026-05-19T00:00:00Z" },
    "production_connector_semantic_implementation_authority": { "const": false },
    "production_connector_use_allowed_flag": { "const": false },
    "network_io_allowed_flag": { "const": false },
    "order_execution_allowed_flag": { "const": false },
    "production_reachability_allowed_flag": { "const": false },
    "runtime_resolver_snapshot_creation_allowed_flag": { "const": false },
    "replay_paper_execution_allowed_flag": { "const": false },
    "future_production_launch_path_preserved": { "const": true },
    "accepted_source_fixture_authority_class": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "implementationGateState": {
      "enum": [
        "READY_FOR_PR126_FIXTURE_SCOPE_IMPLEMENTATION",
        "REJECTED_MISSING_ACCEPTED_SOURCE_EVIDENCE",
        "REJECTED_STALE_ACCEPTED_PACKET",
        "REJECTED_SUPERSEDED_ACCEPTED_PACKET",
        "REJECTED_REVALIDATION_REQUIRED",
        "REJECTED_CONNECTOR_BLOCKING_MATERIALITY",
        "REJECTED_LIVE_TRADING_BLOCKING_MATERIALITY",
        "REJECTED_MISSING_UNIT_SCALE_SCOPE",
        "REJECTED_CANONICALIZATION_FAILURE",
        "REJECTED_SCOPE_OR_VENUE_MISMATCH"
      ]
    }
  }
}

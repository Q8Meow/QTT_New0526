{
  "$id": "https://qtt.local/schemas/source_evidence/acceptance/accepted_source_evidence_ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted Source-Evidence Ledger Schema",
  "description": "PR123 / Roadmap PR106 target-field scoped accepted source-evidence ledger schema. Ledger rows are non-live evidence records and cannot directly unlock connector semantics, runtime live use, order authority, profit evidence, or quantum execution.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accepted_ledger_record_id": { "$ref": "#/$defs/non_empty_string" },
    "accepted_source_evidence_packet_id": { "$ref": "#/$defs/non_empty_string" },
    "candidate_source_evidence_packet_id": { "$ref": "#/$defs/non_empty_string" },
    "acceptance_decision_packet_id": { "$ref": "#/$defs/non_empty_string" },
    "retrieval_manifest_id": { "$ref": "#/$defs/non_empty_string" },
    "source_target_id": { "$ref": "#/$defs/non_empty_string" },
    "retrieval_target_id": { "$ref": "#/$defs/non_empty_string" },
    "venue_id": { "$ref": "#/$defs/venue_id" },
    "platform_scope": { "$ref": "#/$defs/platform_scope" },
    "target_field_path": { "$ref": "#/$defs/target_field_path" },
    "applicability_scope": { "type": "object" },
    "accepted_value_type": { "$ref": "#/$defs/non_empty_string" },
    "accepted_value_label": { "$ref": "#/$defs/non_empty_string" },
    "accepted_value_locator": { "$ref": "#/$defs/non_empty_string" },
    "quote_span_locator": { "type": ["object", "null"] },
    "machine_field_locator": { "type": ["object", "null"] },
    "canonicalized_content_digest": { "$ref": "#/$defs/sha256" },
    "canonical_text_digest_sha256": { "$ref": "#/$defs/sha256" },
    "source_digest_sha256": { "$ref": "#/$defs/sha256" },
    "source_class": { "$ref": "#/$defs/source_authority_class" },
    "source_authority_class": { "$ref": "#/$defs/source_authority_class" },
    "source_locator": { "$ref": "#/$defs/non_empty_string" },
    "source_locator_type": { "$ref": "#/$defs/non_empty_string" },
    "source_locator_status": { "$ref": "#/$defs/non_empty_string" },
    "redaction_state": { "$ref": "#/$defs/non_empty_string" },
    "conflict_state": { "$ref": "#/$defs/non_empty_string" },
    "conflict_resolution_state": { "$ref": "#/$defs/non_empty_string" },
    "revalidation_state": { "$ref": "#/$defs/non_empty_string" },
    "source_change_materiality_class": { "$ref": "#/$defs/non_empty_string" },
    "accepted_at_utc": { "$ref": "#/$defs/non_empty_string" },
    "accepted_by_tool": { "const": "tools/source_evidence_acceptance_executor.py" },
    "receipt_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/non_empty_string" } },
    "acceptance_authority_state": { "const": "TARGET_FIELD_ACCEPTED_SOURCE_EVIDENCE_NONLIVE_ONLY" },
    "acceptance_decision_receipt_ref": { "$ref": "#/$defs/non_empty_string" },
    "connector_semantic_unlock_candidate_flag": { "type": "boolean" },
    "connector_semantic_unlock_allowed_flag": { "const": false },
    "runtime_live_use_allowed_flag": { "const": false },
    "order_authority_allowed_flag": { "const": false },
    "profit_evidence_allowed_flag": { "const": false },
    "quantum_backend_execution_allowed_flag": { "const": false },
    "production_external_fact_authority": { "type": "boolean" }
  },
  "required": [
    "accepted_ledger_record_id",
    "accepted_source_evidence_packet_id",
    "candidate_source_evidence_packet_id",
    "acceptance_decision_packet_id",
    "retrieval_manifest_id",
    "source_target_id",
    "retrieval_target_id",
    "venue_id",
    "platform_scope",
    "target_field_path",
    "applicability_scope",
    "accepted_value_type",
    "accepted_value_label",
    "accepted_value_locator",
    "quote_span_locator",
    "machine_field_locator",
    "canonicalized_content_digest",
    "canonical_text_digest_sha256",
    "source_digest_sha256",
    "source_class",
    "source_authority_class",
    "source_locator",
    "source_locator_type",
    "source_locator_status",
    "redaction_state",
    "conflict_state",
    "conflict_resolution_state",
    "revalidation_state",
    "source_change_materiality_class",
    "accepted_at_utc",
    "accepted_by_tool",
    "receipt_ids",
    "acceptance_authority_state",
    "acceptance_decision_receipt_ref",
    "connector_semantic_unlock_candidate_flag",
    "connector_semantic_unlock_allowed_flag",
    "runtime_live_use_allowed_flag",
    "order_authority_allowed_flag",
    "profit_evidence_allowed_flag",
    "quantum_backend_execution_allowed_flag",
    "production_external_fact_authority"
  ],
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_field_path": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$", "not": { "pattern": "\\*" } },
    "venue_id": { "enum": ["PREDICTION_MARKETS_GENERAL", "KALSHI", "POLYMARKET", "FORECASTEX_IBKR"] },
    "platform_scope": { "enum": ["PREDICTION_MARKETS_GENERAL", "KALSHI", "POLYMARKET", "FORECASTEX_IBKR"] },
    "source_authority_class": { "enum": ["OFFICIAL_VENUE_DOCS", "OFFICIAL_API_DOCS", "OFFICIAL_SDK_DOCS", "OFFICIAL_RULEBOOKS", "OFFICIAL_FEE_TICK_SETTLEMENT_DOCS", "OFFICIAL_PROVIDER_DOCS", "TEST_FIXTURE_NOT_EXTERNAL_FACT"] }
  }
}

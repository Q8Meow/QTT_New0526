{
  "$id": "https://qtt.local/schemas/source_evidence/acceptance/accepted_source_evidence_packet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted Source-Evidence Packet Schema",
  "description": "PR123 / Roadmap PR106 accepted source-evidence packet schema. Accepted packets are target-field scoped evidence records only; they do not populate connector semantics, create live reachability, execute orders, create runtime cash claims, reduce blockers, create replay/paper results, or claim profit, latency, execution, or quantum advantage.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accepted_packet_record_type": { "const": "ACCEPTED_SOURCE_EVIDENCE_PACKET" },
    "accepted_source_evidence_packet_id": { "$ref": "#/$defs/non_empty_string" },
    "accepted_source_evidence_packet_version": { "const": "PR106_ACCEPTED_SOURCE_EVIDENCE_PACKET_V1" },
    "master_plan_edition": { "$ref": "#/$defs/non_empty_string" },
    "candidate_source_evidence_packet_id": { "$ref": "#/$defs/non_empty_string" },
    "acceptance_decision_packet_id": { "$ref": "#/$defs/non_empty_string" },
    "retrieval_manifest_id": { "$ref": "#/$defs/non_empty_string" },
    "source_target_id": { "$ref": "#/$defs/non_empty_string" },
    "retrieval_target_id": { "$ref": "#/$defs/non_empty_string" },
    "venue_id": { "$ref": "#/$defs/venue_id" },
    "platform_scope": { "$ref": "#/$defs/platform_scope" },
    "source_locator": { "$ref": "#/$defs/non_empty_string" },
    "source_locator_type": { "$ref": "#/$defs/source_locator_type" },
    "source_locator_status": { "$ref": "#/$defs/non_empty_string" },
    "source_authority_class": { "$ref": "#/$defs/source_authority_class" },
    "source_access_method": { "$ref": "#/$defs/non_empty_string" },
    "source_retrieval_method": { "$ref": "#/$defs/non_empty_string" },
    "source_retrieved_at_utc": { "$ref": "#/$defs/non_empty_string" },
    "raw_capture_digest_sha256": { "$ref": "#/$defs/sha256" },
    "canonical_text_digest_sha256": { "$ref": "#/$defs/sha256" },
    "source_digest_sha256": { "$ref": "#/$defs/sha256" },
    "quote_span_locator_or_machine_field_locator": { "$ref": "#/$defs/locator_kind" },
    "exact_quote_or_machine_field_locator": { "type": "object" },
    "extracted_fact_payload": {},
    "extracted_fact_type": { "$ref": "#/$defs/extracted_fact_type" },
    "extracted_fact": {},
    "accepted_value_label": { "$ref": "#/$defs/non_empty_string" },
    "target_section_id": { "$ref": "#/$defs/non_empty_string" },
    "target_field_paths_authorized": { "$ref": "#/$defs/target_field_paths" },
    "target_field_path": { "$ref": "#/$defs/target_field_path" },
    "applicability_scope": { "$ref": "#/$defs/applicability_scope" },
    "conflict_check_id": { "$ref": "#/$defs/non_empty_string" },
    "conflict_resolution_state": { "$ref": "#/$defs/conflict_resolution_state" },
    "conflict_state": { "$ref": "#/$defs/conflict_state" },
    "revalidation_trigger": { "$ref": "#/$defs/revalidation_trigger" },
    "revalidation_trigger_id": { "$ref": "#/$defs/non_empty_string" },
    "revalidation_due_at_or_event": { "$ref": "#/$defs/non_empty_string" },
    "revalidation_due_condition": { "$ref": "#/$defs/revalidation_due_condition" },
    "supersedes_packet_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/non_empty_string" } },
    "accepted_at_utc": { "$ref": "#/$defs/non_empty_string" },
    "accepted_by_tool": { "const": "tools/source_evidence_acceptance_executor.py" },
    "receipt_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/non_empty_string" } },
    "production_external_fact_authority": { "type": "boolean" },
    "no_connector_semantic_population_flag": { "const": true },
    "no_live_reachability_flag": { "const": true },
    "no_order_execution_flag": { "const": true },
    "no_runtime_cash_claim_flag": { "const": true },
    "no_blocker_reduction_or_profit_claim_flag": { "const": true },
    "no_claim_flags": { "$ref": "#/$defs/no_claim_flags" }
  },
  "required": [
    "accepted_packet_record_type",
    "accepted_source_evidence_packet_id",
    "accepted_source_evidence_packet_version",
    "master_plan_edition",
    "candidate_source_evidence_packet_id",
    "acceptance_decision_packet_id",
    "retrieval_manifest_id",
    "source_target_id",
    "retrieval_target_id",
    "venue_id",
    "platform_scope",
    "source_locator",
    "source_locator_type",
    "source_locator_status",
    "source_authority_class",
    "source_access_method",
    "source_retrieval_method",
    "source_retrieved_at_utc",
    "raw_capture_digest_sha256",
    "canonical_text_digest_sha256",
    "source_digest_sha256",
    "quote_span_locator_or_machine_field_locator",
    "exact_quote_or_machine_field_locator",
    "extracted_fact_payload",
    "extracted_fact_type",
    "extracted_fact",
    "accepted_value_label",
    "target_section_id",
    "target_field_paths_authorized",
    "target_field_path",
    "applicability_scope",
    "conflict_check_id",
    "conflict_resolution_state",
    "conflict_state",
    "revalidation_trigger",
    "revalidation_trigger_id",
    "revalidation_due_at_or_event",
    "revalidation_due_condition",
    "supersedes_packet_ids",
    "accepted_at_utc",
    "accepted_by_tool",
    "receipt_ids",
    "production_external_fact_authority",
    "no_connector_semantic_population_flag",
    "no_live_reachability_flag",
    "no_order_execution_flag",
    "no_runtime_cash_claim_flag",
    "no_blocker_reduction_or_profit_claim_flag",
    "no_claim_flags"
  ],
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_field_path": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$", "not": { "pattern": "\\*" } },
    "target_field_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/target_field_path" } },
    "venue_id": { "enum": ["PREDICTION_MARKETS_GENERAL", "KALSHI", "POLYMARKET", "FORECASTEX_IBKR"] },
    "platform_scope": { "enum": ["PREDICTION_MARKETS_GENERAL", "KALSHI", "POLYMARKET", "FORECASTEX_IBKR"] },
    "source_locator_type": { "enum": ["OFFICIAL_URL", "OFFICIAL_DOC_PATH", "OFFICIAL_MACHINE_PAYLOAD_PATH", "OWNER_UPLOADED_PRIVATE_DOC_LOCATOR", "PLACEHOLDER_NOT_FACTUAL_URL", "FIXTURE_ONLY"] },
    "source_authority_class": { "enum": ["OFFICIAL_VENUE_DOCS", "OFFICIAL_API_DOCS", "OFFICIAL_SDK_DOCS", "OFFICIAL_RULEBOOKS", "OFFICIAL_FEE_TICK_SETTLEMENT_DOCS", "OFFICIAL_PROVIDER_DOCS", "TEST_FIXTURE_NOT_EXTERNAL_FACT"] },
    "locator_kind": { "enum": ["QUOTE_SPAN_LOCATOR", "MACHINE_FIELD_LOCATOR"] },
    "extracted_fact_type": { "enum": ["STRING", "NUMBER", "BOOLEAN", "OBJECT", "ARRAY", "ENUM", "NO_VALUE_REASON"] },
    "conflict_state": { "enum": ["NO_CONFLICT", "ACCEPTABLE_DUPLICATE", "OWNER_REVIEWED_EXACT_EVIDENCE"] },
    "conflict_resolution_state": { "enum": ["NO_CONFLICT", "NO_PRIOR_PACKET_FOR_TARGET_FIELD", "ACCEPTABLE_DUPLICATE", "OWNER_REVIEWED_EXACT_EVIDENCE"] },
    "revalidation_trigger": { "enum": ["TIME_BASED", "EVENT_BASED", "TIME_OR_EVENT_BASED"] },
    "revalidation_due_condition": { "enum": ["NOT_DUE_CURRENT", "EVENT_TRIGGERED_IMMEDIATE_WHEN_SOURCE_CHANGES"] },
    "applicability_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_id": { "$ref": "#/$defs/non_empty_string" },
        "venue_id": { "$ref": "#/$defs/venue_id" },
        "platform_scope": { "$ref": "#/$defs/platform_scope" },
        "target_field_paths": { "$ref": "#/$defs/target_field_paths" },
        "wildcard_scope_allowed": { "const": false },
        "cross_venue_scope_allowed": { "const": false }
      },
      "required": ["scope_id", "venue_id", "platform_scope", "target_field_paths", "wildcard_scope_allowed", "cross_venue_scope_allowed"]
    },
    "no_claim_flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connector_semantic_binding_created": { "const": false },
        "connector_semantic_value_populated": { "const": false },
        "runtime_resolver_snapshot_created": { "const": false },
        "runtime_live_authority_created": { "const": false },
        "order_authority_created": { "const": false },
        "runtime_cash_receipt_created": { "const": false },
        "replay_paper_result_created": { "const": false },
        "profit_evidence_created": { "const": false },
        "latency_superiority_claim_created": { "const": false },
        "execution_superiority_claim_created": { "const": false },
        "quantum_backend_execution_created": { "const": false },
        "quantum_simulator_execution_created": { "const": false },
        "optimizer_execution_created": { "const": false },
        "quantum_advantage_claim_created": { "const": false },
        "atomicrows_bundle_created": { "const": false },
        "atomicrows_sha_created": { "const": false }
      },
      "required": [
        "connector_semantic_binding_created",
        "connector_semantic_value_populated",
        "runtime_resolver_snapshot_created",
        "runtime_live_authority_created",
        "order_authority_created",
        "runtime_cash_receipt_created",
        "replay_paper_result_created",
        "profit_evidence_created",
        "latency_superiority_claim_created",
        "execution_superiority_claim_created",
        "quantum_backend_execution_created",
        "quantum_simulator_execution_created",
        "optimizer_execution_created",
        "quantum_advantage_claim_created",
        "atomicrows_bundle_created",
        "atomicrows_sha_created"
      ]
    }
  }
}

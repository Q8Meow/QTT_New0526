{
  "$id": "https://qtt.local/schemas/source_evidence/acceptance/acceptance_decision_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-Evidence Acceptance Decision Receipt Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "acceptance_decision_receipt_record_type": { "const": "SOURCE_EVIDENCE_ACCEPTANCE_DECISION_RECEIPT" },
    "acceptance_decision_packet_id": { "$ref": "#/$defs/non_empty_string" },
    "decision": { "enum": ["ACCEPTED", "REJECTED"] },
    "candidate_source_evidence_packet_id": { "$ref": "#/$defs/non_empty_string" },
    "accepted_source_evidence_packet_id": { "type": ["string", "null"] },
    "accepted_ledger_record_id": { "type": ["string", "null"] },
    "target_field_path": { "$ref": "#/$defs/non_empty_string" },
    "rejection_codes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/non_empty_string" } },
    "validation_failure_messages": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "conflict_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "revalidation_status_ref": { "$ref": "#/$defs/non_empty_string" },
    "reject_receipt_ref": { "type": ["string", "null"] },
    "decided_at_utc": { "$ref": "#/$defs/non_empty_string" },
    "decided_by_tool": { "const": "tools/source_evidence_acceptance_executor.py" },
    "production_external_fact_authority": { "type": "boolean" },
    "connector_semantic_binding_created_count": { "const": 0 },
    "runtime_live_authority_created": { "const": false },
    "order_authority_created": { "const": false },
    "profit_evidence_created": { "const": false },
    "quantum_backend_execution_count": { "const": 0 }
  },
  "required": [
    "acceptance_decision_receipt_record_type",
    "acceptance_decision_packet_id",
    "decision",
    "candidate_source_evidence_packet_id",
    "accepted_source_evidence_packet_id",
    "accepted_ledger_record_id",
    "target_field_path",
    "rejection_codes",
    "validation_failure_messages",
    "conflict_report_ref",
    "revalidation_status_ref",
    "reject_receipt_ref",
    "decided_at_utc",
    "decided_by_tool",
    "production_external_fact_authority",
    "connector_semantic_binding_created_count",
    "runtime_live_authority_created",
    "order_authority_created",
    "profit_evidence_created",
    "quantum_backend_execution_count"
  ],
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 }
  }
}

{
  "$id": "https://qtt.local/schemas/source_evidence/retrieval/source_retrieval_target.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Candidate/control-plane source retrieval target schema. It defines target readiness only and creates no accepted facts, connector semantics, runtime/live/order authority, profit evidence, or quantum execution.",
  "properties": {
    "accepted_fact_authority_flag": {
      "const": false
    },
    "allowed_next_states": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "block_code": {
      "$ref": "#/$defs/non_empty_string"
    },
    "block_reason": {
      "$ref": "#/$defs/non_empty_string"
    },
    "candidate_receipt_allowed_flag": {
      "type": "boolean"
    },
    "capture_requirement": {
      "$ref": "#/$defs/non_empty_string"
    },
    "connector_semantic_unlock_allowed_flag": {
      "const": false
    },
    "connector_unlock_state": {
      "$ref": "#/$defs/non_empty_string"
    },
    "digest_requirement": {
      "$ref": "#/$defs/non_empty_string"
    },
    "locator_requirement": {
      "$ref": "#/$defs/non_empty_string"
    },
    "market_scope_class": {
      "$ref": "#/$defs/non_empty_string"
    },
    "order_authority_allowed_flag": {
      "const": false
    },
    "owner_review_required_flag": {
      "type": "boolean"
    },
    "platform_scope": {
      "$ref": "#/$defs/non_empty_string"
    },
    "profit_evidence_allowed_flag": {
      "const": false
    },
    "quantum_backend_execution_allowed_flag": {
      "const": false
    },
    "quantum_execution_state": {
      "$ref": "#/$defs/non_empty_string"
    },
    "redaction_requirement": {
      "$ref": "#/$defs/non_empty_string"
    },
    "retrieval_target_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "revalidation_requirement": {
      "$ref": "#/$defs/non_empty_string"
    },
    "runtime_live_use_allowed_flag": {
      "const": false
    },
    "runtime_live_use_state": {
      "$ref": "#/$defs/non_empty_string"
    },
    "semantic_family": {
      "$ref": "#/$defs/non_empty_string"
    },
    "source_authority_state": {
      "$ref": "#/$defs/non_empty_string"
    },
    "source_change_materiality_default": {
      "$ref": "#/$defs/non_empty_string"
    },
    "source_class": {
      "$ref": "#/$defs/non_empty_string"
    },
    "source_locator": {
      "type": "object"
    },
    "source_target_type": {
      "$ref": "#/$defs/non_empty_string"
    },
    "target_field_path": {
      "$ref": "#/$defs/target_field_path"
    },
    "venue_id": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "required": [
    "retrieval_target_id",
    "platform_scope",
    "venue_id",
    "market_scope_class",
    "source_class",
    "source_target_type",
    "source_locator",
    "target_field_path",
    "semantic_family",
    "capture_requirement",
    "locator_requirement",
    "digest_requirement",
    "redaction_requirement",
    "revalidation_requirement",
    "source_change_materiality_default",
    "source_authority_state",
    "connector_unlock_state",
    "runtime_live_use_state",
    "quantum_execution_state",
    "allowed_next_states",
    "block_code",
    "block_reason",
    "owner_review_required_flag",
    "candidate_receipt_allowed_flag",
    "accepted_fact_authority_flag",
    "connector_semantic_unlock_allowed_flag",
    "runtime_live_use_allowed_flag",
    "order_authority_allowed_flag",
    "profit_evidence_allowed_flag",
    "quantum_backend_execution_allowed_flag"
  ],
  "title": "Source Retrieval Target Schema",
  "type": "object",
  "$defs": {
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "non_empty_string_array": {
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "target_field_path": {
      "minLength": 1,
      "not": {
        "pattern": "\\*"
      },
      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
      "type": "string"
    }
  }
}

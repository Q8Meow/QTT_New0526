{
  "$id": "https://qtt.local/schemas/source_evidence/retrieval/quote_span_locator.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Text quote/span locator for later acceptance review. This locator is not an accepted fact and does not unlock connector semantics.",
  "properties": {
    "canonicalization_policy_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "end_offset": {
      "minimum": 0,
      "type": "integer"
    },
    "line_end": {
      "minimum": 1,
      "type": "integer"
    },
    "line_start": {
      "minimum": 1,
      "type": "integer"
    },
    "quote_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "quote_span_locator_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "start_offset": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "quote_span_locator_id",
    "canonicalization_policy_id",
    "line_start",
    "line_end",
    "start_offset",
    "end_offset",
    "quote_digest_sha256"
  ],
  "title": "Quote Span Locator Schema",
  "type": "object",
  "$defs": {
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  }
}

    "semantic_task_id",
    "roadmap_pr_label",
    "roadmap_delivery_label",
    "authority_class",
    "static_tooling_only_flag",
    "deterministic_builder_framework_created_flag",
    "bundle_materialization_attempted_flag",
    "bundle_materialization_allowed_flag",
    "bundle_file_created_flag",
    "bundle_jsonl_path",
    "bundle_sha_created_flag",
    "bundle_sha_path",
    "sha_authority_created_flag",

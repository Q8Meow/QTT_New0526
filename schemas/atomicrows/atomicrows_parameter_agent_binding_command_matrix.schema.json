    "command_text": {
      "enum": [
        ".\\.venv\\Scripts\\python.exe tools\\validate_qtt_owner_global_override_authority.py --mode dev --repo-root . --out docs\\master_plan\\generated\\QTTOwnerGlobalOverrideAuthority.report.json",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qtt-local-schemas-atomicrows-materialized-bundle-row",
  "title": "AtomicRows Materialized Bundle Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_row_id",
    "bundle_row_version",
    "bundle_materialized",
    "bundle_materialization_authority_class",
    "current_expected_boundary_state",
    "transition_from_state",
    "transition_to_state",
    "exact_row_id",
    "row_index",
    "family_id",
    "family_name",
    "family_row_index",
    "source_file",
    "source_record_digest",
    "source_record_stable_identity",
    "source_record",
    "source_row_class",
    "source_subfamily_id",
    "source_quantum_metadata_class",
    "d2_e0_agent_family_eligibility",
    "d2_e0_scoring_ranking_readiness",
    "eligible_future_score_components",
    "blocked_future_score_components",
    "eligible_future_stack_roles",
    "blocked_future_stack_roles",
    "trade_context_applicability_metadata",
    "platform_applicability_metadata_only",
    "market_type_applicability_metadata_only",
    "strategy_fit_metadata_only",
    "latency_fit_metadata_only",
    "risk_fit_metadata_only",
    "capital_fit_metadata_only",
    "source_currentness_dependency_class",
    "runtime_readiness_dependency_class",
    "replay_paper_dependency_class",
    "quantum_applicability_metadata_class",
    "owner_priority_applicability_metadata_only",
    "candidate_stack_generation_eligible_future_only",
    "ranking_contract_input_eligible_future_only",
    "selection_contract_input_eligible_future_only",
    "optimizer_arbitration_input_eligible_future_only",
    "replay_paper_competition_input_eligible_future_only",
    "quantum_metadata_policy",
    "owner_override_policy",
    "runtime_live_authority_boundary",
    "source_connector_authority_boundary",
    "execution_authority_boundary",
    "evidence_authority_boundary",
    "future_handoff_metadata",
    "d2_e0_authority_boundaries",
    "validation_reason_codes"
  ],
  "properties": {
    "bundle_row_id": {
      "type": "string",
      "pattern": "^AR_BUNDLE_ROW_[0-9]{4}$"
    },
    "bundle_row_version": { "const": "v1" },
    "bundle_materialized": { "const": true },
    "bundle_materialization_authority_class": {
      "const": "STATIC_ATOMICROWS_BUNDLE_FILE_MATERIALIZATION_ONLY_NOT_SHA_NOT_FREEZE_NOT_FINAL_READINESS_NOT_RUNTIME_NOT_LIVE_NOT_SCORING_EXECUTION_NOT_SELECTION"
    },
    "current_expected_boundary_state": { "const": "POST_MATERIALIZATION_PRE_SHA" },
    "transition_from_state": { "const": "PRE_MATERIALIZATION" },
    "transition_to_state": { "const": "POST_MATERIALIZATION_PRE_SHA" },
    "exact_row_id": {
      "type": "string",
      "pattern": "^AR_EXACT_[0-9]{3}_[A-Z0-9_]+_[0-9]{6}$"
    },
    "row_index": { "type": "integer", "minimum": 1, "maximum": 4183 },
    "family_id": { "type": "string" },
    "family_name": { "type": "string" },
    "family_row_index": { "type": "integer", "minimum": 1 },
    "source_file": { "type": "string" },
    "source_record_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_record_stable_identity": { "type": "string" },
    "source_record": { "type": "object" },
    "source_row_class": { "type": "string" },
    "source_subfamily_id": { "type": "string" },
    "source_quantum_metadata_class": { "type": "string" },
    "d2_e0_agent_family_eligibility": {
      "type": "object",
      "required": [
        "agent_family_eligibility_decision",
        "agent_family_eligibility_reason_codes",
        "allowed_agent_family_classes",
        "blocked_agent_family_classes",
        "allowed_static_actions",
        "blocked_authority_classes"
      ]
    },
    "d2_e0_scoring_ranking_readiness": {
      "type": "object",
      "required": [
        "scoring_readiness_decision",
        "scoring_readiness_reason_codes",
        "eligible_future_score_components",
        "blocked_future_score_components",
        "eligible_future_stack_roles",
        "blocked_future_stack_roles",
        "candidate_stack_generation_eligible_future_only",
        "ranking_contract_input_eligible_future_only",
        "selection_contract_input_eligible_future_only",
        "optimizer_arbitration_input_eligible_future_only",
        "replay_paper_competition_input_eligible_future_only"
      ]
    },
    "eligible_future_score_components": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "blocked_future_score_components": {
      "type": "array",
      "items": { "type": "string" }
    },
    "eligible_future_stack_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "blocked_future_stack_roles": {
      "type": "array",
      "items": { "type": "object" }
    },
    "trade_context_applicability_metadata": { "type": "object" },
    "platform_applicability_metadata_only": { "type": "string" },
    "market_type_applicability_metadata_only": { "type": "string" },
    "strategy_fit_metadata_only": { "type": "string" },
    "latency_fit_metadata_only": { "type": "string" },
    "risk_fit_metadata_only": { "type": "string" },
    "capital_fit_metadata_only": { "type": "string" },
    "source_currentness_dependency_class": { "type": "string" },
    "runtime_readiness_dependency_class": { "type": "string" },
    "replay_paper_dependency_class": { "type": "string" },
    "quantum_applicability_metadata_class": { "type": "string" },
    "owner_priority_applicability_metadata_only": { "type": "string" },
    "candidate_stack_generation_eligible_future_only": { "type": "boolean" },
    "ranking_contract_input_eligible_future_only": { "type": "boolean" },
    "selection_contract_input_eligible_future_only": { "type": "boolean" },
    "optimizer_arbitration_input_eligible_future_only": { "type": "boolean" },
    "replay_paper_competition_input_eligible_future_only": { "type": "boolean" },
    "quantum_metadata_policy": {
      "type": "object",
      "required": [
        "quantum_forward_family",
        "quantum_metadata_only",
        "quantum_backend_authority_allowed",
        "quantum_simulator_authority_allowed",
        "quantum_provider_authority_allowed",
        "quantum_advantage_claim_allowed",
        "quantum_live_order_authority_allowed"
      ],
      "properties": {
        "quantum_backend_authority_allowed": { "const": false },
        "quantum_simulator_authority_allowed": { "const": false },
        "quantum_provider_authority_allowed": { "const": false },
        "quantum_advantage_claim_allowed": { "const": false },
        "quantum_live_order_authority_allowed": { "const": false }
      }
    },
    "owner_override_policy": { "type": "object" },
    "runtime_live_authority_boundary": { "$ref": "#/$defs/bool_boundary" },
    "source_connector_authority_boundary": { "$ref": "#/$defs/bool_boundary" },
    "execution_authority_boundary": { "$ref": "#/$defs/bool_boundary" },
    "evidence_authority_boundary": { "$ref": "#/$defs/bool_boundary" },
    "future_handoff_metadata": {
      "type": "object",
      "required": [
        "future_sha_freeze_state_centralization_required",
        "future_final_readiness_state_centralization_required",
        "future_runtime_live_state_centralization_required",
        "future_profit_evidence_state_centralization_required",
        "future_quantum_execution_state_centralization_required"
      ]
    },
    "d2_e0_authority_boundaries": { "$ref": "#/$defs/bool_boundary" },
    "validation_reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "bool_boundary": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}

        "quantum_simulator_allowed": { "const": false },
        "quantum_provider_call_allowed": { "const": false },
        "optimizer_execution_allowed": { "const": false }
      }
    },
    "owner_authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_global_internal_workflow_authority_preserved",
        "owner_approval_may_approve_future_internal_workflow_movement",
        "owner_approval_does_not_create_sha_freeze_truth",
        "owner_approval_cannot_fabricate"
      ],
      "properties": {
        "owner_global_internal_workflow_authority_preserved": { "const": true },
        "owner_approval_may_approve_future_internal_workflow_movement": {
          "const": true
        },
        "owner_approval_does_not_create_sha_freeze_truth": { "const": true },
        "owner_approval_cannot_fabricate": {

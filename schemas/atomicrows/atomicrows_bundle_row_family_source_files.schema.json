        "algorithm_family_refs",
        "agent_role_refs",
        "parameter_stack_role_refs",
        "stack_role_refs",
        "selection_universe_refs",
        "scoring_policy_refs",
        "quantum_metadata_refs",
        "quantum_applicability_refs",
        "source_evidence_requirement_class",
        "connector_semantic_requirement_class",
        "replay_paper_requirement_class",
        "live_order_requirement_class",

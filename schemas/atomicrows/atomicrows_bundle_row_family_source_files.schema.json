        "quantum_relevance_class": { "$ref": "#/$defs/quantum_relevance_class" },
        "source_evidence_requirement_class": { "$ref": "#/$defs/requirement_class" },
        "connector_semantic_requirement_class": { "$ref": "#/$defs/requirement_class" },
        "replay_paper_requirement_class": { "$ref": "#/$defs/requirement_class" },

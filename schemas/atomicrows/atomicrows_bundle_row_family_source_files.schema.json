        "source_file_lifecycle_status": { "const": "STATIC_SOURCE_BLUEPRINTS_OWNER_REVIEW_REQUIRED" },
        "source_file_path": { "type": "string" },
        "source_file_created_by_pr98_flag": { "const": true },
        "repository_source_file_only_flag": { "const": true },
        "external_source_retrieval_created_flag": { "const": false },

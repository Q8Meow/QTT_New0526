    "final_readiness_created_flag": { "const": false },
    "external_source_retrieval_created_flag": { "const": false },
    "source_acceptance_created_flag": { "const": false },
    "connector_semantic_created_flag": { "const": false },
    "runtime_live_authority_created_flag": { "const": false },
    "quantum_backend_execution_created_flag": { "const": false },

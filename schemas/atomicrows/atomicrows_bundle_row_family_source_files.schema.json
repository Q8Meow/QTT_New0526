        "planned_downstream_source_file_path": { "type": "string" },
        "actual_created_source_file_path": { "type": "string" },
        "source_file_id": { "type": "string" },
        "source_file_exists_flag": { "const": true },
        "family_source_status": { "const": "SOURCE_BLUEPRINTS_CREATED_OWNER_REVIEW_REQUIRED" },
        "row_count_policy": { "const": "OWNER_REVIEW_REQUIRED" },
        "exact_row_count_authority": { "const": "EXACT_PER_FAMILY_COUNTS_NOT_AUTHORIZED_BY_PR97" },
        "owner_approval_state": { "const": "OWNER_REVIEW_REQUIRED_BEFORE_ROW_MATERIALIZATION_AND_BUILDER" },

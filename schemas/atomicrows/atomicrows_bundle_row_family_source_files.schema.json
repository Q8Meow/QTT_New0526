    "source_file_set_id": { "const": "ATOMICROWS_BUNDLE_ROW_FAMILY_SOURCE_FILE_SET" },
    "source_file_set_version": { "const": "v1" },
    "semantic_task_id": { "const": "ROADMAP-ATOMICROWS-ROW-FAMILY-SOURCES" },
    "roadmap_pr_label": { "const": "PR_98" },
    "roadmap_delivery_label": { "const": "PR #98" },
    "authority_class": {
      "const": "STATIC_ATOMICROWS_ROW_FAMILY_SOURCE_FILES_ONLY_NOT_BUNDLE_NOT_HASH_NOT_FREEZE_NOT_RUNTIME_AUTHORITY"

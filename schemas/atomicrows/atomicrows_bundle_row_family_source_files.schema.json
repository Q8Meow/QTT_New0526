    "target_total_row_count_planning_authority_only_flag": { "const": true },
    "source_files_created_flag": { "const": true },
    "final_bundle_created_flag": { "const": false },
    "bundle_jsonl_created_flag": { "const": false },
    "bundle_sha_created_flag": { "const": false },
    "hash_created_flag": { "const": false },
    "sha_authority_created_flag": { "const": false },
    "freeze_authority_created_flag": { "const": false },

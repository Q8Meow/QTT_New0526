      "properties": {
        "manifest_id": { "const": "ATOMICROWS_ROW_FAMILY_SOURCE_MANIFEST" },
        "manifest_version": { "const": "v1" },
        "purpose": { "type": "string" },
        "stable_ordering_policy": { "const": "CANONICAL_ORDER_ASCENDING" },
        "row_family_source_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/manifest_entry" },
          "minItems": 1
        }
      }
    },
    "manifest_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_entry_id",
        "row_family_id",
        "row_family_class",
        "canonical_order",
        "planned_downstream_source_file_path",
        "actual_created_source_file_path",
        "source_file_id",
        "source_file_exists_flag",
        "family_source_status",
        "row_count_policy",
        "exact_row_count_authority",
        "owner_approval_state",
        "downstream_builder_readiness_state",
        "blocked_effects"

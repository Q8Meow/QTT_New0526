        "algorithm_family_refs": { "$ref": "#/$defs/string_array" },
        "agent_role_refs": { "$ref": "#/$defs/string_array" },
        "parameter_stack_role_refs": { "$ref": "#/$defs/string_array" },
        "stack_role_refs": { "$ref": "#/$defs/string_array" },
        "selection_universe_refs": { "$ref": "#/$defs/string_array" },
        "scoring_policy_refs": { "$ref": "#/$defs/string_array" },

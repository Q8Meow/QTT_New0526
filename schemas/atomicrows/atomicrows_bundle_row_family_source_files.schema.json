        "blocked_effects": { "$ref": "#/$defs/string_array" }
      }
    },
    "validation_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_id",
        "matrix_version",
        "stable_ordering_policy",
        "validations"
      ],
      "properties": {
        "matrix_id": { "const": "ATOMICROWS_ROW_FAMILY_SOURCE_VALIDATION_MATRIX" },
        "matrix_version": { "const": "v1" },
        "stable_ordering_policy": { "const": "CANONICAL_ORDER_ASCENDING" },
        "validations": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_entry" },
          "minItems": 1
        }
      }
    },
    "validation_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_id",
        "validation_class",
        "canonical_order",
        "fail_closed_reason_code",
        "blocks_bundle_build_flag",
        "blocks_hash_or_freeze_flag",
        "blocks_live_or_runtime_use_flag"
      ],
      "properties": {
        "validation_id": { "type": "string" },
        "validation_class": { "type": "string" },
        "canonical_order": { "type": "integer" },
        "fail_closed_reason_code": { "type": "string" },

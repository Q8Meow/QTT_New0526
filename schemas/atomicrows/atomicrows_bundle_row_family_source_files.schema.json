        "metadata_only_flag",
        "quantum_backend_execution_created_flag",
        "quantum_advantage_evidence_created_flag",
        "allowed_static_metadata_refs",
        "forbidden_quantum_execution_effects"
      ],
      "properties": {
        "plan_id": { "const": "ATOMICROWS_ROW_FAMILY_QUANTUM_METADATA_SOURCE_PLAN" },
        "metadata_only_flag": { "const": true },
        "quantum_backend_execution_created_flag": { "const": false },
        "quantum_advantage_evidence_created_flag": { "const": false },
        "allowed_static_metadata_refs": { "$ref": "#/$defs/string_array" },
        "forbidden_quantum_execution_effects": { "$ref": "#/$defs/string_array" }
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "source_file_id",
        "source_file_version",
        "semantic_task_id",
        "roadmap_pr_label",
        "consumes_pr97_expansion_plan_flag",
        "pr97_plan_path",
        "row_family_id",
        "row_family_class",
        "display_label",
        "canonical_order",
        "source_file_mode",
        "source_file_lifecycle_status",
        "source_file_path",

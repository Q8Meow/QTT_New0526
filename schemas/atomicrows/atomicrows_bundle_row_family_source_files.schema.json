        "boundary_id": { "const": "ATOMICROWS_ROW_FAMILY_SOURCE_OWNER_APPROVAL_BOUNDARY" },
        "owner_approval_required_before_builder_execution": { "const": true },
        "owner_approval_required_before_hash_freeze": { "const": true },
        "owner_approval_required_before_final_readiness": { "const": true },
        "owner_override_satisfies_internal_workflow_only_flag": { "const": true },

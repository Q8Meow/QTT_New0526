        "connector_semantic_requirement_class": { "$ref": "#/$defs/requirement_class" },
        "replay_paper_requirement_class": { "$ref": "#/$defs/requirement_class" },
        "live_order_requirement_class": { "$ref": "#/$defs/requirement_class" },
        "owner_approval_requirement_class": { "const": "OWNER_APPROVAL_REQUIRED_BEFORE_ROW_MATERIALIZATION" },

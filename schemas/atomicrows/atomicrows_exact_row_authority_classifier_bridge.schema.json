    "field_fill_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/field_fill_rule" },
      "minItems": 10,
      "uniqueItems": true
    },
    "row_field_doctrine": { "$ref": "#/$defs/row_field_doctrine" },
    "canonical_row_fill_architecture": { "$ref": "#/$defs/canonical_row_fill_architecture" },
    "future_row_file_strategy": { "$ref": "#/$defs/future_row_file_strategy" },
    "future_row_id_law": { "$ref": "#/$defs/future_row_id_law" },
    "future_exact_row_schema_doctrine": { "$ref": "#/$defs/future_exact_row_schema_doctrine" },
    "recovery_pr_sequence_doctrine": { "$ref": "#/$defs/recovery_pr_sequence_doctrine" },
    "agent_eligibility_governance": { "$ref": "#/$defs/agent_eligibility_governance" },

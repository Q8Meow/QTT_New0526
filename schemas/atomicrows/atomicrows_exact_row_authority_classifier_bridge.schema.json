    "artifact_version": { "const": "v1" },
    "repair_scope": { "const": "ATOMICROWS_4183_EXACT_ROW_MATERIALIZATION_GAP_REPAIR" },
    "authority_class": { "const": "STATIC_REPAIR_BRIDGE_NOT_EXACT_ROWS_NOT_BUNDLE_NOT_SHA_NOT_FREEZE" },
    "gate_mode": { "const": "BRIDGE_READY_EXACT_ROWS_NOT_CREATED" },
    "target_total_row_count": { "const": 4183 },
    "target_total_row_count_status": { "const": "PLANNING_ONLY_UNTIL_EXACT_ROWS_GENERATED" },
    "exact_rows_created_by_this_pr": { "const": false },
    "bundle_created_by_this_pr": { "const": false },
    "sha_created_by_this_pr": { "const": false },
    "freeze_created_by_this_pr": { "const": false },
    "final_readiness_created_by_this_pr": { "const": false },

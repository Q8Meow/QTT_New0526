    "bundle_created_by_this_pr",
    "sha_created_by_this_pr",
    "freeze_created_by_this_pr",
    "final_readiness_created_by_this_pr",
    "pr97_state",
    "pr98_state",
    "pr99_state",
    "pr100_state",
    "authority_classes",
    "field_authority_handling",
    "field_fill_rules",
    "row_field_doctrine",
    "canonical_row_fill_architecture",
    "future_row_file_strategy",
    "future_row_id_law",
    "future_exact_row_schema_doctrine",
    "recovery_pr_sequence_doctrine",
    "agent_eligibility_governance",

    "depends_on_parameter_stack_role_taxonomy": {
      "$ref": "#/$defs/depends_on_parameter_stack_role_taxonomy"
    },
    "depends_on_parameter_stack_completeness_gate": {
      "$ref": "#/$defs/depends_on_parameter_stack_completeness_gate"
    },
    "required_stack_roles": {
      "const": [
        "SIGNAL",
        "SCORING",
        "NORMALIZATION",
        "RISK",
        "EXECUTION",
        "CAPITAL",
        "LATENCY",
        "ERROR_GUARD",
        "QUANTUM_ADVISORY"
      ]
    },
    "role_interface_contracts": {

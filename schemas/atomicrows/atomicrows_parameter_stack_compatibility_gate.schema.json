{
  "$schema": "json-schema-draft-2020-12",
  "$id": "qtt-local-schemas-atomicrows-parameter-stack-compatibility-gate",
  "title": "AtomicRows Parameter Stack Compatibility Gate",
  "description": "Static deterministic AtomicRows parameter-stack compatibility gate. It consumes the role taxonomy and completeness gate without stack scoring, stack ranking, stack selection, candidate generation, trade-context routing, optimizer arbitration, replay or paper execution, runtime authority, live authority, order authority, source retrieval, source acceptance, connector semantic binding, profit evidence, or quantum backend evidence.",

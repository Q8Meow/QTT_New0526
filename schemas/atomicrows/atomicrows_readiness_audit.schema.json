{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/schemas/atomicrows/atomicrows_readiness_audit.schema.json",
  "title": "Static AtomicRows Readiness Blocker Audit Schema",
  "description": "Static/non-mutating audit contract for the current AtomicRows blocked state. It inspects only canonical bundle and hash path presence and creates no AtomicRows bundle, hash, rows, completion claim, blocker reduction, runtime authority, source authority, connector authority, order authority, freeze authority, or profit evidence.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fixture_id": { "const": "SYNTHETIC_PR27_ATOMICROWS_READINESS_BLOCKED_FIXTURE" },
    "fixture_version": { "const": "PR27_ATOMICROWS_READINESS_BLOCKED_FIXTURE_V1" },
    "fixture_authority_class": { "const": "SYNTHETIC_NON_AUTHORITATIVE_FIXTURE_NOT_ATOMICROWS_BUNDLE_AUTHORITY" },
    "schema_authority_class": { "const": "STATIC_SCHEMA_CONTRACT_ONLY_NOT_ATOMICROWS_AUTHORITY" },
    "surface_kind": { "const": "ATOMICROWS_READINESS_BLOCKER_AUDIT_STATIC" },
    "mode": { "const": "SOURCE_REQUIRED" },
    "execution": { "const": "DISABLED" },
    "deterministic_output": { "const": true },
    "audit_status": { "const": "BLOCKED_PENDING_ATOMICROWS_BUNDLE_AUTHORITY" },
    "atomicrows_authority_state": { "$ref": "#/$defs/authority_state" },
    "readiness_scope_flags": { "$ref": "#/$defs/readiness_scope_flags" },
    "forbidden_action_flags": { "$ref": "#/$defs/forbidden_action_flags" },
    "no_claim_flags": { "$ref": "#/$defs/no_claim_flags" },
    "validation_hook_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": "ATOMICROWS_READINESS_STATIC_NON_MUTATING_AUDIT" }
    }
  },
  "required": [
    "fixture_id",
    "fixture_version",
    "fixture_authority_class",
    "schema_authority_class",
    "surface_kind",
    "mode",
    "execution",
    "deterministic_output",
    "audit_status",
    "atomicrows_authority_state",
    "readiness_scope_flags",
    "forbidden_action_flags",
    "no_claim_flags",
    "validation_hook_ids"

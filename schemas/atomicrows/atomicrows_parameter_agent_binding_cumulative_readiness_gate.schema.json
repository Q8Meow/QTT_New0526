    "fixture_id": { "const": "SYNTHETIC_ATOMICROWS_PARAMETER_AGENT_BINDING_CUMULATIVE_READINESS_GATE_FIXTURE" },
    "fixture_version": { "const": "ATOMICROWS_PARAMETER_AGENT_BINDING_CUMULATIVE_READINESS_GATE_FIXTURE_V1" },
    "fixture_authority_class": { "const": "SYNTHETIC_NON_AUTHORITATIVE_FIXTURE_NOT_BINDING_READINESS_AUTHORITY" },
    "schema_authority_class": { "const": "STATIC_SCHEMA_CONTRACT_ONLY_NOT_BINDING_READINESS_AUTHORITY" },
    "surface_kind": { "const": "ATOMICROWS_PARAMETER_AGENT_BINDING_CUMULATIVE_READINESS_GATE_STATIC" },
    "mode": { "const": "SOURCE_REQUIRED" },
    "execution": { "const": "DISABLED" },
    "deterministic_output": { "const": true },
    "generated_at_utc": { "const": "STATIC_DETERMINISTIC_NO_WALL_CLOCK" },
    "validation_hook_ids": {

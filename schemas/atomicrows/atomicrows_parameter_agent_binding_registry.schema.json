{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/schemas/atomicrows/atomicrows_parameter_agent_binding_registry.schema.json",
  "title": "AtomicRows Parameter-Agent Binding Registry",
  "description": "Static deterministic AtomicRows parameter-agent binding registry contract. It declares the canonical parameter-family, row, and pattern binding surface for QTT agent roles and consumer classes without creating an AtomicRows bundle, bundle hash, source acceptance, connector binding, runtime receipt, live receipt, order authority, quantum backend artifact, dashboard runtime UI, or profit evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_name",
    "registry_model",
    "authority_class",
    "source_master_plan",
    "canonical_source_for_parameter_agent_assignment",
    "final_expected_row_coverage",
    "deterministic_output",
    "owner_global_override_authority",
    "owner_override_satisfies_all_qtt_internal_requirements",
    "chatgpt_authority_over_owner",
    "codex_authority_over_owner",
    "qtt_agent_authority_over_owner",
    "validator_authority_over_owner",
    "generated_report_authority_over_owner",
    "static_gate_authority_over_owner",
    "uses_pr_number_as_authority",
    "binding_statuses",
    "agent_roles",
    "consumer_classes",
    "agent_use_scopes",
    "lifecycle_statuses",
    "owner_override_tokens",
    "authority_boundary",
    "bindings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_name": { "const": "AtomicRowsParameterAgentBindingRegistry" },
    "registry_model": { "const": "PARAMETER_AGENT_BINDING_REGISTRY" },
    "authority_class": { "const": "STATIC_PARAMETER_AGENT_BINDING_REGISTRY_ONLY_NOT_ATOMICROWS_BUNDLE_AUTHORITY" },
    "source_master_plan": { "const": "docs/master_plan/QTT_MasterPlan_Current.md" },
    "canonical_source_for_parameter_agent_assignment": { "const": true },
    "final_expected_row_coverage": { "type": "string" },
    "deterministic_output": { "const": true },
    "owner_global_override_authority": { "const": true },
    "owner_override_satisfies_all_qtt_internal_requirements": { "const": true },
    "chatgpt_authority_over_owner": { "const": false },
    "codex_authority_over_owner": { "const": false },
    "qtt_agent_authority_over_owner": { "const": false },
    "validator_authority_over_owner": { "const": false },
    "generated_report_authority_over_owner": { "const": false },
    "static_gate_authority_over_owner": { "const": false },
    "uses_pr_number_as_authority": { "const": false },
    "binding_statuses": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding_status" }
    },
    "agent_roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent_role" }
    },
    "consumer_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_class" }
    },
    "agent_use_scopes": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent_use_scope" }
    },
    "lifecycle_statuses": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycle_status" }
    },
    "owner_override_tokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/owner_override_token" }
    },
    "authority_boundary": { "$ref": "#/$defs/authority_boundary" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/binding" }
    },
    "fixture_id": { "type": "string" },
    "fixture_version": { "type": "string" },
    "fixture_authority_class": { "type": "string" },
    "schema_authority_class": { "type": "string" },
    "surface_kind": { "type": "string" },
    "mode": { "type": "string" },
    "execution": { "type": "string" },
    "validation_hook_ids": {
      "type": "array",
      "items": { "const": "ATOMICROWS_PARAMETER_AGENT_BINDING_REGISTRY_STATIC_VALIDATION" }
    },
    "assignment_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/assignment_check" }
    }
  },
  "$defs": {
    "binding_status": {
      "enum": [
        "ACTIVE_BINDING",
        "OWNER_APPROVED_BINDING",
        "OWNER_GLOBAL_OVERRIDE_BINDING",
        "RESEARCH_ONLY_BINDING",
        "REPLAY_PAPER_BINDING",
        "OPTIMIZER_BINDING",
        "RUNTIME_BINDING",
        "LIVE_BINDING",
        "QUANTUM_BACKEND_BINDING",
        "QUARANTINED_BINDING",
        "RETIRED_BINDING",
        "BLOCKED_PENDING_OWNER_APPROVAL",
        "BLOCKED_PENDING_AGENT_ASSIGNMENT",
        "BLOCKED_PENDING_LIFECYCLE_STATUS",
        "BLOCKED_PENDING_RECEIPTS"
      ]
    },
    "agent_role": {
      "enum": [
        "OWNER",
        "ORCHESTRATOR_AGENT",
        "MASTER_PLAN_AGENT",
        "ATOMICROWS_AGENT",
        "ATOMICROWS_RESEARCH_AGENT",
        "ATOMICROWS_LIFECYCLE_AGENT",
        "SOURCE_EVIDENCE_AGENT",
        "CONNECTOR_AGENT",
        "RUNTIME_RESOLVER_AGENT",
        "REPLAY_AGENT",
        "PAPER_AGENT",
        "DUAL_RESULT_REVIEW_AGENT",
        "OPTIMIZER_AGENT",
        "RISK_AGENT",
        "SIZING_AGENT",
        "EXECUTION_LATENCY_AGENT",
        "ORDER_ROUTER_AGENT",
        "LIVE_CANARY_AGENT",
        "QUANTUM_RESEARCH_AGENT",
        "QUANTUM_BACKEND_AGENT",
        "DASHBOARD_AGENT",
        "GOVERNANCE_AGENT",
        "VALIDATION_AGENT",
        "COMPLIANCE_MARKER_AGENT",
        "OWNER_APPROVAL_REQUEST_AGENT"
      ]
    },
    "consumer_class": {
      "enum": [
        "INVENTORY_INDEX",
        "RESEARCH_TRIAGE",
        "SOURCE_EVIDENCE_RETRIEVAL",
        "RANGE_VALIDATION",
        "REPLAY_CANDIDATE_SELECTION",
        "PAPER_CANDIDATE_SELECTION",
        "OPTIMIZER_SEARCH",
        "OPTIMIZER_DEFAULTS",
        "RISK_MODEL_INPUT",
        "SIZING_MODEL_INPUT",
        "QUANTUM_CIRCUIT_CONSTRUCTION",
        "QUANTUM_BACKEND_EXECUTION",
        "RUNTIME_RESOLVER_INPUT",
        "LIVE_ORDER_ROUTING",
        "LIVE_EXECUTION"
      ]
    },
    "agent_use_scope": {
      "enum": [
        "INVENTORY_ONLY",
        "RESEARCH_ONLY",
        "SOURCE_EVIDENCE_ONLY",
        "RANGE_VALIDATION_ONLY",
        "REPLAY_ONLY",
        "PAPER_ONLY",
        "REPLAY_PAPER_ONLY",
        "OPTIMIZER_ONLY",
        "RISK_ONLY",
        "SIZING_ONLY",
        "RUNTIME_ONLY",
        "LIVE_ONLY",
        "QUANTUM_RESEARCH_ONLY",
        "QUANTUM_BACKEND_ONLY",
        "OWNER_APPROVED_SCOPE",
        "OWNER_GLOBAL_OVERRIDE_SCOPE",
        "QUARANTINE_REVIEW_ONLY",
        "RETIREMENT_AUDIT_ONLY"
      ]
    },
    "lifecycle_status": {
      "enum": [
        "INVENTORY_ONLY",
        "RESEARCH_CANDIDATE",
        "SOURCE_EVIDENCE_REQUIRED",
        "RANGE_VALIDATED_STATIC_ONLY",
        "REPLAY_PAPER_CANDIDATE",
        "REPLAY_PAPER_VALIDATED",
        "OPTIMIZER_ELIGIBLE",
        "RUNTIME_ELIGIBLE",
        "LIVE_ELIGIBLE",
        "QUARANTINED_UNPROVEN",
        "RETIRED_NOT_USEFUL"
      ]
    },
    "owner_override_token": {
      "enum": [
        "OWNER_APPROVED",
        "OWNER_APPROVED_OVERRIDE",
        "OWNER_GLOBAL_OVERRIDE",
        "OWNER_OVERRIDE_SATISFIED",
        "AGENT_ASSIGNMENT_OWNER_APPROVED",
        "OWNER_APPROVED_NOT_EXTERNALLY_VERIFIED",
        "OWNER_APPROVED_UNVERIFIED",
        "OWNER_RISK_ACCEPTED",
        "OWNER_ASSUMED_RESPONSIBILITY",
        "OWNER_WAIVED_REQUIREMENT",
        "ROW_COMPLETION_OWNER_APPROVED"
      ]
    },
    "final_qtt_internal_status": {
      "enum": [
        "ACTIVE_BINDING",
        "OWNER_APPROVED_BINDING",
        "OWNER_GLOBAL_OVERRIDE_BINDING",
        "RESEARCH_ONLY_BINDING",
        "REPLAY_PAPER_BINDING",
        "OPTIMIZER_BINDING",
        "RUNTIME_BINDING",
        "LIVE_BINDING",
        "QUANTUM_BACKEND_BINDING",
        "QUARANTINED_BINDING",
        "RETIRED_BINDING",
        "BLOCKED_PENDING_OWNER_APPROVAL",
        "BLOCKED_PENDING_AGENT_ASSIGNMENT",
        "BLOCKED_PENDING_LIFECYCLE_STATUS",
        "BLOCKED_PENDING_RECEIPTS",
        "OWNER_OVERRIDE_SATISFIED",
        "OWNER_APPROVED",
        "OWNER_GLOBAL_OVERRIDE",
        "AGENT_ASSIGNMENT_OWNER_APPROVED"
      ]
    },
    "string_list": {
      "type": "array",
      "items": { "type": "string" }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_runtime_artifact_created",
        "real_live_artifact_created",
        "real_order_artifact_created",
        "real_quantum_backend_artifact_created",
        "real_profit_artifact_created",
        "creates_source_acceptance",
        "creates_connector_binding",
        "creates_runtime_receipts",
        "creates_live_receipts",
        "creates_order_receipts",
        "creates_cash_receipts",
        "creates_atomicrows_bundle",
        "creates_atomicrows_bundle_sha",
        "creates_sha_freeze_authority",
        "creates_dashboard_runtime_ui",
        "creates_live_trading_execution",
        "fetches_private_account_state",
        "materializes_secrets",
        "clones_external_repos",
        "installs_packages",
        "reduces_blockers",
        "validator_authority_over_owner",
        "codex_authority_over_owner",
        "qtt_agent_authority_over_owner",
        "chatgpt_authority_over_owner",
        "generated_report_authority_over_owner",
        "static_gate_authority_over_owner"
      ],
      "properties": {
        "real_runtime_artifact_created": { "const": false },
        "real_live_artifact_created": { "const": false },
        "real_order_artifact_created": { "const": false },
        "real_quantum_backend_artifact_created": { "const": false },
        "real_profit_artifact_created": { "const": false },
        "creates_source_acceptance": { "const": false },
        "creates_connector_binding": { "const": false },
        "creates_runtime_receipts": { "const": false },
        "creates_live_receipts": { "const": false },
        "creates_order_receipts": { "const": false },
        "creates_cash_receipts": { "const": false },
        "creates_atomicrows_bundle": { "const": false },
        "creates_atomicrows_bundle_sha": { "const": false },
        "creates_sha_freeze_authority": { "const": false },
        "creates_dashboard_runtime_ui": { "const": false },
        "creates_live_trading_execution": { "const": false },
        "fetches_private_account_state": { "const": false },
        "materializes_secrets": { "const": false },
        "clones_external_repos": { "const": false },
        "installs_packages": { "const": false },
        "reduces_blockers": { "const": false },
        "validator_authority_over_owner": { "const": false },
        "codex_authority_over_owner": { "const": false },
        "qtt_agent_authority_over_owner": { "const": false },
        "chatgpt_authority_over_owner": { "const": false },
        "generated_report_authority_over_owner": { "const": false },
        "static_gate_authority_over_owner": { "const": false }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "binding_status",
        "binding_authority_basis",
        "owner_override_allowed",
        "owner_override_applied",
        "owner_override_satisfaction_basis",
        "owner_approved_value",
        "parameter_family",
        "atomic_parameter_row_id",
        "row_pattern_id",
        "owning_agent_role",
        "authorized_agent_roles",
        "blocked_agent_roles",
        "authorized_agent_ids",
        "blocked_agent_ids",
        "authorized_consumer_classes",
        "blocked_consumer_classes",
        "agent_use_scope",
        "requires_lifecycle_status_at_least",
        "requires_receipts",
        "requires_owner_override_when_missing",
        "runtime_use_allowed",
        "live_use_allowed",
        "optimizer_use_allowed",
        "quantum_backend_use_allowed",
        "replay_paper_use_allowed",
        "research_use_allowed",
        "source_evidence_use_allowed",
        "binding_notes",
        "final_qtt_internal_status",
        "blocks_qtt_when_owner_override_present"
      ],
      "properties": {
        "binding_id": { "type": "string" },
        "binding_status": { "$ref": "#/$defs/binding_status" },
        "binding_authority_basis": { "$ref": "#/$defs/owner_override_token" },
        "owner_override_allowed": { "type": "boolean" },
        "owner_override_applied": { "type": "boolean" },
        "owner_override_satisfaction_basis": { "anyOf": [{ "$ref": "#/$defs/owner_override_token" }, { "type": "null" }] },
        "owner_approved_value": { "type": ["string", "null"] },
        "parameter_family": { "type": ["string", "null"] },
        "atomic_parameter_row_id": { "type": ["string", "null"] },
        "row_pattern_id": { "type": ["string", "null"] },
        "owning_agent_role": { "anyOf": [{ "$ref": "#/$defs/agent_role" }, { "type": "null" }] },
        "authorized_agent_roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/agent_role" }
        },
        "blocked_agent_roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/agent_role" }
        },
        "authorized_agent_ids": { "$ref": "#/$defs/string_list" },
        "blocked_agent_ids": { "$ref": "#/$defs/string_list" },
        "authorized_consumer_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_class" }
        },
        "blocked_consumer_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_class" }
        },
        "agent_use_scope": { "$ref": "#/$defs/agent_use_scope" },
        "requires_lifecycle_status_at_least": { "anyOf": [{ "$ref": "#/$defs/lifecycle_status" }, { "type": "null" }] },
        "requires_receipts": { "$ref": "#/$defs/string_list" },
        "requires_owner_override_when_missing": { "type": "boolean" },
        "runtime_use_allowed": { "type": "boolean" },
        "live_use_allowed": { "type": "boolean" },
        "optimizer_use_allowed": { "type": "boolean" },
        "quantum_backend_use_allowed": { "type": "boolean" },
        "replay_paper_use_allowed": { "type": "boolean" },
        "research_use_allowed": { "type": "boolean" },
        "source_evidence_use_allowed": { "type": "boolean" },
        "binding_notes": { "type": "string" },
        "final_qtt_internal_status": { "$ref": "#/$defs/final_qtt_internal_status" },
        "blocks_qtt_when_owner_override_present": { "type": "boolean" }
      }
    },
    "assignment_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "parameter_family",
        "atomic_parameter_row_id",
        "row_pattern_id",
        "agent_role",
        "agent_id",
        "owner_override_token",
        "expected_decision"
      ],
      "properties": {
        "check_id": { "type": "string" },
        "parameter_family": { "type": ["string", "null"] },
        "atomic_parameter_row_id": { "type": ["string", "null"] },
        "row_pattern_id": { "type": ["string", "null"] },
        "agent_role": { "$ref": "#/$defs/agent_role" },
        "agent_id": { "type": ["string", "null"] },
        "owner_override_token": { "type": ["string", "null"] },
        "expected_decision": {
          "enum": [
            "ALLOWED_BY_BINDING",
            "BLOCKED_MISSING_BINDING",
            "OWNER_OVERRIDE_SATISFIED"
          ]
        }
      }
    },
    "parameter_agent_binding_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_type",
        "deterministic_output",
        "generated_at_utc",
        "binding_count",
        "parameter_family_binding_count",
        "row_level_binding_count",
        "pattern_level_binding_count",
        "agent_role_count",
        "agent_id_count",
        "authorized_agent_role_binding_count",
        "blocked_agent_role_binding_count",
        "authorized_consumer_class_binding_count",
        "blocked_consumer_class_binding_count",
        "owner_approved_binding_count",
        "owner_global_override_binding_count",
        "owner_override_satisfied_binding_count",
        "missing_binding_normal_blocked_count",
        "missing_binding_owner_override_satisfied_count",
        "runtime_binding_count",
        "live_binding_count",
        "quantum_backend_binding_count",
        "real_runtime_artifact_created",
        "real_live_artifact_created",
        "real_order_artifact_created",
        "real_quantum_backend_artifact_created",
        "real_profit_artifact_created",
        "bundle_file_present",
        "bundle_sha_present",
        "uses_pr_number_as_authority",
        "final_ready",
        "authority_boundary_all_false"
      ],
      "properties": {
        "report_type": { "const": "ATOMICROWS_PARAMETER_AGENT_BINDING_REPORT" },
        "deterministic_output": { "const": true },
        "generated_at_utc": { "const": "STATIC_DETERMINISTIC_NO_WALL_CLOCK" },
        "binding_count": { "type": "integer" },
        "parameter_family_binding_count": { "type": "integer" },
        "row_level_binding_count": { "type": "integer" },
        "pattern_level_binding_count": { "type": "integer" },
        "agent_role_count": { "type": "integer" },
        "agent_id_count": { "type": "integer" },
        "authorized_agent_role_binding_count": { "type": "integer" },
        "blocked_agent_role_binding_count": { "type": "integer" },
        "authorized_consumer_class_binding_count": { "type": "integer" },
        "blocked_consumer_class_binding_count": { "type": "integer" },
        "owner_approved_binding_count": { "type": "integer" },
        "owner_global_override_binding_count": { "type": "integer" },
        "owner_override_satisfied_binding_count": { "type": "integer" },
        "missing_binding_normal_blocked_count": { "type": "integer" },
        "missing_binding_owner_override_satisfied_count": { "type": "integer" },
        "runtime_binding_count": { "type": "integer" },
        "live_binding_count": { "type": "integer" },
        "quantum_backend_binding_count": { "type": "integer" },
        "real_runtime_artifact_created": { "type": "boolean" },
        "real_live_artifact_created": { "type": "boolean" },
        "real_order_artifact_created": { "type": "boolean" },
        "real_quantum_backend_artifact_created": { "type": "boolean" },
        "real_profit_artifact_created": { "type": "boolean" },
        "bundle_file_present": { "type": "boolean" },
        "bundle_sha_present": { "type": "boolean" },
        "uses_pr_number_as_authority": { "type": "boolean" },
        "final_ready": { "type": "boolean" },
        "authority_boundary_all_false": { "type": "boolean" }
      }
    }
  }
}

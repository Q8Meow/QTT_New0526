    },
    "execution": {
      "const": "DISABLED"
    },
    "execution_superiority_evidence_claim_created": {
      "const": false
    },
    "existing_pr_patterns_used_for_style_only": {
      "const": true
    },
    "final_ready": {
      "const": false
    },
    "fixture_authority_class": {
      "minLength": 1,
      "type": "string"
    },
    "fixture_id": {
      "minLength": 1,
      "type": "string"

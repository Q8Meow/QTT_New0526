    },
    "algorithm_formula_family_registry_used_for_family_validation": {
      "const": true
    },
    "alpha_evidence_claim_created": {
      "const": false
    },
    "architecture_emphasis": {
      "const": "INSTITUTIONAL_AGENT_ALGORITHM_BINDING_REGISTRY_NOT_LOOSE_LIST"
    },
    "binding_generation_policy": {
      "const": "ONE_BINDING_PER_ALGORITHM_AUTHORIZED_AGENT_ROLE_PAIR_FROM_ALGORITHM_REGISTRY"
    },
    "bundle_file_present": {
      "const": false
    },
    "bundle_sha_present": {
      "const": false
    },
    "chatgpt_authority_over_owner": {
      "const": false
    },
    "codex_authority_over_owner": {

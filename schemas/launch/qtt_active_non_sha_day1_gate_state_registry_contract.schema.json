{
  "$schema": "json-schema-draft-2020-12",
  "$id": "qtt-local-schemas-active-non-sha-day1-gate-state-registry-contract",
  "title": "QTT Active Non-SHA Day-1 Gate State Registry Contract",
  "description": "Central active non-SHA Day-1 gate state registry. This contract records blocked and guard-active gate state only; it does not create final readiness, launch authority, runtime/live/order/source/connector/runtime-cash/backend/profit authority, replay/paper/optimizer/neural/quantum execution, or profit/latency/execution/quantum-advantage evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "authority_class",
    "current_gate_registry_state",
    "current_sha_system_dormancy_state_required",
    "current_final_readiness_dependency_policy_state_required",
    "sha_dormancy_system_excluded_from_active_gate_ids",
    "sha_required_for_day1_final_readiness",
    "sha_dormancy_is_day1_gate_blocker",
    "sha_absence_is_day1_gate_blocker",
    "sha_presence_is_final_readiness_evidence",
    "current_pr_flips_any_gate",
    "current_pr_marks_any_gate_satisfied",
    "current_pr_creates_final_readiness",
    "current_pr_creates_day1_launch_authority",
    "current_pr_creates_runtime_live_order_source_connector_runtime_cash_backend_profit_authority",
    "current_pr_creates_replay_paper_optimizer_neural_quantum_backend_execution",
    "current_pr_claims_profit_latency_execution_quantum_advantage_evidence",
    "source_facts_accepted_by_this_pr",
    "connector_semantics_bound_by_this_pr",
    "runtime_cash_receipts_created_by_this_pr",
    "order_fill_account_receipts_created_by_this_pr",
    "qubo_qaoa_vqe_ising_annealing_backend_simulator_execution_created_by_this_pr",
    "active_non_sha_gate_ids",
    "excluded_non_participating_subsystems",
    "gate_records",
    "positive_evidence_gates_currently_blocking_final_readiness",
    "guard_gates_active_and_unviolated",
    "quantum_backend_gate_conditional_not_required_for_non_backend_day1",
    "quantum_backend_gate_blocks_unauthorized_backend_simulator_provider_execution",
    "quantum_backend_gate_does_not_block_static_quantum_metadata_or_planning",
    "future_prs_must_flip_one_gate_state_at_a_time",
    "future_prs_must_materialize_only_one_artifact_or_capability_at_a_time",
    "registry_is_not_final_readiness",
    "registry_is_not_live_authority",
    "registry_is_not_profit_evidence",
    "registry_is_not_quantum_advantage_evidence",
    "validator_contract"
  ],
  "properties": {
    "contract_id": { "const": "QTT_ACTIVE_NON_SHA_DAY1_GATE_STATE_REGISTRY_CONTRACT" },
    "contract_version": { "const": "v1" },
    "authority_class": {
      "const": "DAY1_GATE_STATE_REGISTRY_CONTROL_PLANE_NOT_FINAL_READINESS_NOT_RUNTIME_NOT_LIVE"
    },
    "current_gate_registry_state": {
      "const": "ACTIVE_NON_SHA_DAY1_GATE_STATE_REGISTRY_ESTABLISHED_ALL_POSITIVE_EVIDENCE_GATES_BLOCKED_GUARDS_ACTIVE"
    },
    "current_sha_system_dormancy_state_required": {
      "const": "SHA_SYSTEM_DORMANT_NON_PARTICIPATING_OWNER_CONTROLLED"
    },
    "current_final_readiness_dependency_policy_state_required": {
      "const": "FINAL_READINESS_DEPENDENCY_POLICY_ACTIVE_NON_SHA_GATES_ONLY"
    },
    "sha_dormancy_system_excluded_from_active_gate_ids": { "const": true },
    "sha_required_for_day1_final_readiness": { "const": false },
    "sha_dormancy_is_day1_gate_blocker": { "const": false },
    "sha_absence_is_day1_gate_blocker": { "const": false },
    "sha_presence_is_final_readiness_evidence": { "const": false },
    "current_pr_flips_any_gate": { "const": false },
    "current_pr_marks_any_gate_satisfied": { "const": false },
    "current_pr_creates_final_readiness": { "const": false },
    "current_pr_creates_day1_launch_authority": { "const": false },
    "current_pr_creates_runtime_live_order_source_connector_runtime_cash_backend_profit_authority": {
      "const": false
    },
    "current_pr_creates_replay_paper_optimizer_neural_quantum_backend_execution": {
      "const": false
    },
    "current_pr_claims_profit_latency_execution_quantum_advantage_evidence": {
      "const": false
    },
    "source_facts_accepted_by_this_pr": { "const": false },
    "connector_semantics_bound_by_this_pr": { "const": false },
    "runtime_cash_receipts_created_by_this_pr": { "const": false },
    "order_fill_account_receipts_created_by_this_pr": { "const": false },
    "qubo_qaoa_vqe_ising_annealing_backend_simulator_execution_created_by_this_pr": {
      "const": false
    },
    "active_non_sha_gate_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/activeGateId" },
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true
    },
    "excluded_non_participating_subsystems": {
      "type": "array",
      "items": { "const": "SHA_DORMANCY_SYSTEM" },
      "minItems": 1,
      "uniqueItems": true
    },
    "gate_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/gateRecord" },
      "minItems": 18,
      "maxItems": 18
    },
    "positive_evidence_gates_currently_blocking_final_readiness": { "const": true },
    "guard_gates_active_and_unviolated": { "const": true },
    "quantum_backend_gate_conditional_not_required_for_non_backend_day1": {
      "const": true
    },
    "quantum_backend_gate_blocks_unauthorized_backend_simulator_provider_execution": {
      "const": true
    },
    "quantum_backend_gate_does_not_block_static_quantum_metadata_or_planning": {
      "const": true
    },
    "future_prs_must_flip_one_gate_state_at_a_time": { "const": true },
    "future_prs_must_materialize_only_one_artifact_or_capability_at_a_time": {
      "const": true
    },
    "registry_is_not_final_readiness": { "const": true },
    "registry_is_not_live_authority": { "const": true },
    "registry_is_not_profit_evidence": { "const": true },
    "registry_is_not_quantum_advantage_evidence": { "const": true },
    "validator_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_name",
        "success_marker",
        "schema_path",
        "generated_report_path",
        "creates_final_readiness",
        "creates_day1_launch_authority",
        "creates_runtime_live_order_source_connector_cash_backend_profit_quantum_authority"
      ],
      "properties": {
        "validator_name": {
          "const": "validate_qtt_active_non_sha_day1_gate_state_registry_contract.py"
        },
        "success_marker": {
          "const": "QTT_ACTIVE_NON_SHA_DAY1_GATE_STATE_REGISTRY_OK"
        },
        "schema_path": {
          "const": "schemas/launch/qtt_active_non_sha_day1_gate_state_registry_contract.schema.json"
        },
        "generated_report_path": {
          "const": "docs/master_plan/generated/QttActiveNonShaDay1GateStateRegistry.report.json"
        },
        "creates_final_readiness": { "const": false },
        "creates_day1_launch_authority": { "const": false },
        "creates_runtime_live_order_source_connector_cash_backend_profit_quantum_authority": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "activeGateId": {
      "enum": [
        "OWNER_DAY1_LAUNCH_APPROVAL",
        "ACCEPTED_SOURCE_EVIDENCE_FOR_TARGET_FIELDS",
        "CONNECTOR_SEMANTIC_BINDINGS_FOR_TARGET_FIELDS",
        "FRESH_SOURCE_REVALIDATION_STATE",
        "RUNTIME_CASH_COMPONENT_FIELD_MAP",
        "RUNTIME_CASH_RECEIPTS_WHEN_REQUIRED",
        "REPLAY_AND_PAPER_RESULTS_WHEN_REQUIRED",
        "DUAL_RESULT_REVIEW_WHEN_REQUIRED",
        "OWNER_LIVE_PROMOTION_REVIEW_WHEN_REQUIRED",
        "RISK_LIMIT_AND_EXPOSURE_GATES",
        "LIVE_PREFLIGHT_MATRIX",
        "ORDER_ROUTER_SAFETY_GATES",
        "KILL_SWITCH_AND_ROLLBACK_GATES",
        "EXECUTION_RECEIPT_BOUNDARY",
        "QUANTUM_BACKEND_AUTHORITY_GATE",
        "QUANTUM_ADVANTAGE_NO_CLAIM_GATE",
        "PROFIT_NO_CLAIM_GATE",
        "LATENCY_AND_EXECUTION_EVIDENCE_NO_FABRICATION_GATE"
      ]
    },
    "gateClass": {
      "enum": [
        "OWNER_DECISION_GATE",
        "REQUIRED_POSITIVE_EVIDENCE_GATE",
        "REQUIRED_POSITIVE_RECEIPT_GATE",
        "REQUIRED_STATIC_CONTRACT_GATE",
        "REQUIRED_RUNTIME_RECEIPT_GATE",
        "REQUIRED_REPLAY_PAPER_RESULT_GATE",
        "REQUIRED_REVIEW_GATE",
        "REQUIRED_PREFLIGHT_GATE",
        "REQUIRED_SAFETY_GUARD_GATE",
        "REQUIRED_NO_CLAIM_GUARD_GATE",
        "CONDITIONAL_AUTHORITY_GUARD_GATE"
      ]
    },
    "gateState": {
      "enum": [
        "BLOCKED_AWAITING_OWNER_APPROVAL",
        "BLOCKED_AWAITING_ACCEPTED_SOURCE_EVIDENCE",
        "BLOCKED_AWAITING_CONNECTOR_SEMANTIC_BINDING",
        "BLOCKED_AWAITING_FRESH_SOURCE_REVALIDATION",
        "BLOCKED_AWAITING_LAUNCH_SCOPED_RUNTIME_CASH_COMPONENT_FIELD_MAP",
        "BLOCKED_AWAITING_RUNTIME_CASH_RECEIPT",
        "BLOCKED_AWAITING_REPLAY_AND_PAPER_RESULTS",
        "BLOCKED_AWAITING_DUAL_RESULT_REVIEW",
        "BLOCKED_AWAITING_OWNER_LIVE_PROMOTION_REVIEW",
        "BLOCKED_AWAITING_RISK_LIMIT_AND_EXPOSURE_GATES",
        "BLOCKED_AWAITING_LIVE_PREFLIGHT_MATRIX",
        "BLOCKED_AWAITING_ORDER_ROUTER_SAFETY_GATES",
        "BLOCKED_AWAITING_KILL_SWITCH_AND_ROLLBACK_GATES",
        "GUARD_ACTIVE_NO_EXECUTION_RECEIPT_REQUIRED_THIS_PR",
        "GUARD_ACTIVE_NO_UNAUTHORIZED_QUANTUM_BACKEND_EXECUTION",
        "GUARD_ACTIVE_NO_QUANTUM_ADVANTAGE_CLAIM",
        "GUARD_ACTIVE_NO_PROFIT_CLAIM",
        "GUARD_ACTIVE_NO_LATENCY_OR_EXECUTION_SUPERIORITY_CLAIM",
        "SATISFIED_BY_CANONICAL_RECEIPT",
        "NON_PARTICIPATING_EXCLUDED"
      ]
    },
    "evaluationMode": {
      "enum": [
        "POSITIVE_EVIDENCE_BLOCKER",
        "POSITIVE_RECEIPT_BLOCKER",
        "STATIC_CONTRACT_BLOCKER",
        "RUNTIME_RECEIPT_BLOCKER",
        "REPLAY_PAPER_RESULT_BLOCKER",
        "REVIEW_BLOCKER",
        "PREFLIGHT_BLOCKER",
        "SAFETY_PRECONDITION_BLOCKER",
        "ACTIVE_GUARD_UNVIOLATED",
        "CONDITIONAL_AUTHORITY_GUARD_NONBLOCKING_UNLESS_SCOPE_REQUIRES",
        "EXCLUDED_NON_PARTICIPATING"
      ]
    },
    "gateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "gate_class",
        "current_state",
        "evaluation_mode",
        "currently_blocks_final_readiness",
        "current_pr_may_flip",
        "future_flip_pr_must_be_separate",
        "future_materialization_must_be_separate_from_unrelated_gate_flips",
        "future_materialization_may_enable_only_one_artifact_or_capability_at_a_time",
        "future_required_artifact_or_receipt",
        "future_flip_pr_family",
        "guard_active_and_unviolated",
        "conditional_on_future_launch_scope",
        "conditional_blocks_final_readiness_if_selected_stack_requires_true_quantum_backend",
        "true_quantum_backend_required_for_non_backend_day1_launch_scope",
        "blocks_unauthorized_backend_simulator_provider_execution",
        "blocks_static_quantum_metadata_or_planning",
        "creates_authority_in_this_pr",
        "creates_evidence_in_this_pr",
        "executes_runtime_in_this_pr",
        "notes"
      ],
      "properties": {
        "gate_id": { "$ref": "#/$defs/activeGateId" },
        "gate_class": { "$ref": "#/$defs/gateClass" },
        "current_state": { "$ref": "#/$defs/gateState" },
        "evaluation_mode": { "$ref": "#/$defs/evaluationMode" },
        "currently_blocks_final_readiness": { "type": "boolean" },
        "current_pr_may_flip": { "const": false },
        "future_flip_pr_must_be_separate": { "const": true },
        "future_materialization_must_be_separate_from_unrelated_gate_flips": {
          "const": true
        },
        "future_materialization_may_enable_only_one_artifact_or_capability_at_a_time": {
          "const": true
        },
        "future_required_artifact_or_receipt": { "type": "string" },
        "future_flip_pr_family": { "type": "string" },
        "guard_active_and_unviolated": { "type": "boolean" },
        "conditional_on_future_launch_scope": { "type": "boolean" },
        "conditional_blocks_final_readiness_if_selected_stack_requires_true_quantum_backend": {
          "type": "boolean"
        },
        "true_quantum_backend_required_for_non_backend_day1_launch_scope": {
          "type": "boolean"
        },
        "blocks_unauthorized_backend_simulator_provider_execution": {
          "type": "boolean"
        },
        "blocks_static_quantum_metadata_or_planning": { "type": "boolean" },
        "creates_authority_in_this_pr": { "const": false },
        "creates_evidence_in_this_pr": { "const": false },
        "executes_runtime_in_this_pr": { "const": false },
        "notes": { "type": "string" }
      }
    }
  }
}

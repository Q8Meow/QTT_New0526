{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/schemas/master_plan/master_plan_implementation_coverage_ledger.schema.json",
  "title": "Master Plan Implementation Coverage Ledger",
  "description": "Regenerable static coverage ledger derived from a stable PR tracking table and repo files only. This schema creates no source fact authority, connector semantic authority, runtime authority, order authority, AtomicRows authority, blocker reduction, live authority, or profit evidence.",
  "type": "object",
  "properties": {
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "coverage_summary": {
      "$ref": "#/$defs/coverage_summary"
    },
    "future_pr_tracking_policy": {
      "$ref": "#/$defs/future_pr_tracking_policy"
    },
    "generated_at_policy": {
      "const": "DETERMINISTIC_NO_WALLCLOCK_TIMESTAMP"
    },
    "generated_by_tool": {
      "const": "tools/build_master_plan_implementation_coverage_ledger.py"
    },
    "ledger_schema_version": {
      "const": "PR47_MASTER_PLAN_IMPLEMENTATION_COVERAGE_LEDGER_V1"
    },
    "ledger_type": {
      "const": "MASTER_PLAN_IMPLEMENTATION_COVERAGE_LEDGER"
    },
    "master_plan_section_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/master_plan_section_record"
      }
    },
    "pr_records": {
      "type": "array",
      "minItems": 49,
      "maxItems": 49,
      "items": {
        "$ref": "#/$defs/pr_record"
      }
    },
    "review_required_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_required_record"
      }
    },
    "source_master_plan_path": {
      "const": "docs/master_plan/QTT_MasterPlan_Current.md"
    },
    "source_repository_path": {
      "const": "."
    },
    "validation_marker_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation_marker_record"
      }
    }
  },
  "required": [
    "authority",
    "coverage_summary",
    "future_pr_tracking_policy",
    "generated_at_policy",
    "generated_by_tool",
    "ledger_schema_version",
    "ledger_type",
    "master_plan_section_records",
    "pr_records",
    "review_required_records",
    "source_master_plan_path",
    "source_repository_path",
    "validation_marker_records"
  ],
  "additionalProperties": false,
  "$defs": {
    "authority": {
      "type": "object",
      "properties": {
        "authority_class": {
          "const": "NON_AUTHORITATIVE_IMPLEMENTATION_COVERAGE_LEDGER"
        },
        "derived_from": {
          "const": "stable_pr_tracking_table_and_repo_files"
        },
        "ledger_is_master_plan_authority": {
          "const": false
        },
        "ledger_is_source_fact_authority": {
          "const": false
        },
        "ledger_is_connector_semantic_authority": {
          "const": false
        },
        "ledger_is_runtime_authority": {
          "const": false
        },
        "ledger_is_order_authority": {
          "const": false
        },
        "ledger_is_atomicrows_authority": {
          "const": false
        },
        "ledger_is_profit_evidence": {
          "const": false
        },
        "ledger_may_select_next_pr_without_master_plan_crosscheck": {
          "const": false
        },
        "owner_review_required_for_uncertain_mapping": {
          "const": true
        }
      },
      "required": [
        "authority_class",
        "derived_from",
        "ledger_is_master_plan_authority",
        "ledger_is_source_fact_authority",
        "ledger_is_connector_semantic_authority",
        "ledger_is_runtime_authority",
        "ledger_is_order_authority",
        "ledger_is_atomicrows_authority",
        "ledger_is_profit_evidence",
        "ledger_may_select_next_pr_without_master_plan_crosscheck",
        "owner_review_required_for_uncertain_mapping"
      ],
      "additionalProperties": false
    },
    "authority_boundary": {
      "type": "object",
      "properties": {
        "boundary_class": {
          "const": "STATIC_LEDGER_RECORD_ONLY_NO_AUTHORITY"
        },
        "creates_atomicrows_bundle": {
          "const": false
        },
        "creates_atomicrows_hash": {
          "const": false
        },
        "creates_canary_eligibility": {
          "const": false
        },
        "creates_dual_result_review_decision": {
          "const": false
        },
        "creates_live_eligibility": {
          "const": false
        },
        "creates_live_reachability": {
          "const": false
        },
        "creates_network_io": {
          "const": false
        },
        "creates_order_authority": {
          "const": false
        },
        "creates_owner_live_promotion_approval": {
          "const": false
        },
        "creates_profit_evidence": {
          "const": false
        },
        "creates_real_accepted_source_evidence_packets": {
          "const": false
        },
        "creates_replay_or_paper_result_packets": {
          "const": false
        },
        "creates_runtime_cash_receipt": {
          "const": false
        },
        "creates_runtime_resolver_snapshot": {
          "const": false
        },
        "creates_source_fact_acceptance": {
          "const": false
        },
        "executes_canary": {
          "const": false
        },
        "executes_replay_or_paper": {
          "const": false
        },
        "merges_replay_paper_results": {
          "const": false
        },
        "populates_production_connector_semantics": {
          "const": false
        },
        "reduces_blockers": {
          "const": false
        },
        "retrieves_source_evidence": {
          "const": false
        }
      },
      "required": [
        "boundary_class",
        "creates_atomicrows_bundle",
        "creates_atomicrows_hash",
        "creates_canary_eligibility",
        "creates_dual_result_review_decision",
        "creates_live_eligibility",
        "creates_live_reachability",
        "creates_network_io",
        "creates_order_authority",
        "creates_owner_live_promotion_approval",
        "creates_profit_evidence",
        "creates_real_accepted_source_evidence_packets",
        "creates_replay_or_paper_result_packets",
        "creates_runtime_cash_receipt",
        "creates_runtime_resolver_snapshot",
        "creates_source_fact_acceptance",
        "executes_canary",
        "executes_replay_or_paper",
        "merges_replay_paper_results",
        "populates_production_connector_semantics",
        "reduces_blockers",
        "retrieves_source_evidence"
      ],
      "additionalProperties": false
    },
    "coverage_summary": {
      "type": "object",
      "properties": {
        "atomicrows_bundle_present": {
          "const": false
        },
        "atomicrows_sha_present": {
          "const": false
        },
        "deterministic_stable_pr_tracking_table_only": {
          "const": true
        },
        "master_plan_section_record_count": {
          "type": "integer",
          "minimum": 1
        },
        "no_authority_claims_preserved": {
          "const": true
        },
        "pr_1_through_37_review_required_count": {
          "type": "integer",
          "minimum": 37,
          "maximum": 37
        },
        "review_required_record_count": {
          "type": "integer",
          "minimum": 37
        },
        "strong_pr_38_through_46_record_count": {
          "type": "integer",
          "minimum": 9,
          "maximum": 9
        },
        "total_pr_records": {
          "type": "integer",
          "minimum": 49,
          "maximum": 49
        },
        "unknown_unmapped_pr_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "validation_marker_record_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "atomicrows_bundle_present",
        "atomicrows_sha_present",
        "deterministic_stable_pr_tracking_table_only",
        "master_plan_section_record_count",
        "no_authority_claims_preserved",
        "pr_1_through_37_review_required_count",
        "review_required_record_count",
        "strong_pr_38_through_46_record_count",
        "total_pr_records",
        "unknown_unmapped_pr_record_count",
        "validation_marker_record_count"
      ],
      "additionalProperties": false
    },
    "future_pr_tracking_policy": {
      "type": "object",
      "properties": {
        "applies_to": {
          "const": "EVERY_FUTURE_IMPLEMENTATION_PR"
        },
        "future_pr_must_add_or_regenerate_ledger_coverage": {
          "const": true
        },
        "ledger_does_not_replace_master_plan_crosscheck": {
          "const": true
        },
        "ledger_may_not_select_next_pr_without_master_plan_crosscheck": {
          "const": true
        },
        "missing_or_uncertain_mapping_must_be_review_required": {
          "const": true
        },
        "policy_id": {
          "const": "PR47_FUTURE_IMPLEMENTATION_PR_LEDGER_TRACKING_POLICY"
        },
        "required_future_pr_fields": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "applies_to",
        "future_pr_must_add_or_regenerate_ledger_coverage",
        "ledger_does_not_replace_master_plan_crosscheck",
        "ledger_may_not_select_next_pr_without_master_plan_crosscheck",
        "missing_or_uncertain_mapping_must_be_review_required",
        "policy_id",
        "required_future_pr_fields"
      ],
      "additionalProperties": false
    },
    "master_plan_section_record": {
      "type": "object",
      "properties": {
        "current_authority_state": {
          "const": "STATIC_ONLY_NON_AUTHORITATIVE_NO_RUNTIME_LIVE_ORDER_ATOMICROWS_OR_PROFIT_AUTHORITY"
        },
        "generated_report_if_any": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementing_pr_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "implementation_status": {
          "$ref": "#/$defs/implementation_status"
        },
        "next_allowed_consumer_if_known": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remaining_blockers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "review_required_flag": {
          "type": "boolean"
        },
        "section_id": {
          "type": "string"
        },
        "section_title_or_anchor": {
          "type": "string"
        },
        "validator_marker_if_any": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "current_authority_state",
        "generated_report_if_any",
        "implementing_pr_numbers",
        "implementation_status",
        "next_allowed_consumer_if_known",
        "remaining_blockers",
        "review_required_flag",
        "section_id",
        "section_title_or_anchor",
        "validator_marker_if_any"
      ],
      "additionalProperties": false
    },
    "pr_record": {
      "type": "object",
      "properties": {
        "atomicrows_bundle_created_flag": {
          "const": false
        },
        "atomicrows_sha_created_flag": {
          "const": false
        },
        "authority_boundary": {
          "$ref": "#/$defs/authority_boundary"
        },
        "branch_name_if_known": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocker_reduction_created_flag": {
          "const": false
        },
        "canary_eligibility_created_flag": {
          "const": false
        },
        "canary_execution_created_flag": {
          "const": false
        },
        "connector_semantics_populated_flag": {
          "const": false
        },
        "created_or_changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dual_result_review_decision_created_flag": {
          "const": false
        },
        "generated_report_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementation_status": {
          "$ref": "#/$defs/implementation_status"
        },
        "implemented_subject": {
          "type": "string"
        },
        "live_eligibility_created_flag": {
          "const": false
        },
        "live_reachability_created_flag": {
          "const": false
        },
        "local_commit_if_known": {
          "type": [
            "string",
            "null"
          ]
        },
        "master_plan_anchor_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "master_plan_section_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merge_commit_if_known": {
          "type": [
            "string",
            "null"
          ]
        },
        "network_io_created_flag": {
          "const": false
        },
        "order_authority_created_flag": {
          "const": false
        },
        "owner_live_promotion_approval_created_flag": {
          "const": false
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "pr_title_or_subject": {
          "type": "string"
        },
        "profit_claim_created_flag": {
          "const": false
        },
        "replay_or_paper_execution_created_flag": {
          "const": false
        },
        "replay_paper_result_packets_created_flag": {
          "const": false
        },
        "result_merge_created_flag": {
          "const": false
        },
        "review_status": {
          "$ref": "#/$defs/review_status"
        },
        "runtime_authority_created_flag": {
          "const": false
        },
        "runtime_cash_receipt_created_flag": {
          "const": false
        },
        "runtime_resolver_snapshot_created_flag": {
          "const": false
        },
        "source_fact_acceptance_created_flag": {
          "const": false
        },
        "source_retrieval_created_flag": {
          "const": false
        },
        "test_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validator_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "atomicrows_bundle_created_flag",
        "atomicrows_sha_created_flag",
        "authority_boundary",
        "branch_name_if_known",
        "blocker_reduction_created_flag",
        "canary_eligibility_created_flag",
        "canary_execution_created_flag",
        "connector_semantics_populated_flag",
        "created_or_changed_paths",
        "dual_result_review_decision_created_flag",
        "generated_report_paths",
        "implementation_status",
        "implemented_subject",
        "live_eligibility_created_flag",
        "live_reachability_created_flag",
        "local_commit_if_known",
        "master_plan_anchor_terms",
        "master_plan_section_ids",
        "merge_commit_if_known",
        "network_io_created_flag",
        "order_authority_created_flag",
        "owner_live_promotion_approval_created_flag",
        "pr_number",
        "pr_title_or_subject",
        "profit_claim_created_flag",
        "replay_or_paper_execution_created_flag",
        "replay_paper_result_packets_created_flag",
        "result_merge_created_flag",
        "review_status",
        "runtime_authority_created_flag",
        "runtime_cash_receipt_created_flag",
        "runtime_resolver_snapshot_created_flag",
        "source_fact_acceptance_created_flag",
        "source_retrieval_created_flag",
        "test_paths",
        "validation_markers",
        "validator_tools"
      ],
      "additionalProperties": false
    },
    "review_required_record": {
      "type": "object",
      "properties": {
        "local_evidence_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner_review_required": {
          "const": true
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        },
        "record_type": {
          "const": "PR_SECTION_MAPPING_REVIEW"
        },
        "review_record_id": {
          "type": "string"
        }
      },
      "required": [
        "local_evidence_paths",
        "owner_review_required",
        "pr_number",
        "reason",
        "record_type",
        "review_record_id"
      ],
      "additionalProperties": false
    },
    "validation_marker_record": {
      "type": "object",
      "properties": {
        "authority_state": {
          "const": "STATIC_VALIDATION_MARKER_ONLY_NOT_AUTHORITY"
        },
        "creates_authority_flag": {
          "const": false
        },
        "generated_report_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "producing_pr_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "review_required_flag": {
          "type": "boolean"
        },
        "validation_marker": {
          "type": "string"
        },
        "validator_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "authority_state",
        "creates_authority_flag",
        "generated_report_paths",
        "producing_pr_numbers",
        "review_required_flag",
        "validation_marker",
        "validator_tools"
      ],
      "additionalProperties": false
    },
    "implementation_status": {
      "enum": [
        "STATIC_CONTRACT_IMPLEMENTED",
        "STATIC_GATE_IMPLEMENTED",
        "TRACKING_ONLY",
        "REVIEW_REQUIRED",
        "UNKNOWN_UNMAPPED"
      ]
    },
    "review_status": {
      "enum": [
        "VERIFIED",
        "PARTIAL_LOCAL_GIT_EVIDENCE",
        "SECTION_MAPPING_REQUIRES_OWNER_REVIEW",
        "UNKNOWN_REQUIRES_OWNER_REVIEW"
      ]
    }
  }
}

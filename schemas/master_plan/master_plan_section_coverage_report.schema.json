    "route_map": { "$ref": "#/$defs/route_map" },
    "route_map_summary": { "$ref": "#/$defs/route_map_summary" },
    "authority_boundary": { "$ref": "#/$defs/authority_boundary" },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser_visible_section_count",
        "registry_entry_count",
        "sections_with_specific_capability_count",
        "sections_using_default_research_route_count",
        "status_counts",
        "coverage_class_counts",
        "blocked_or_future_entries_routed",
        "authority_boundary_all_false",
        "final_ready"
      ],
      "properties": {
        "parser_visible_section_count": { "type": "integer" },
        "registry_entry_count": { "type": "integer" },
        "sections_with_specific_capability_count": { "type": "integer" },
        "sections_using_default_research_route_count": { "type": "integer" },

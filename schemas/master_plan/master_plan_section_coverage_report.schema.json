          "const": "docs/master_plan/generated/MasterPlanSectionCoverageReport.json"
        },
        "controller_decision_reference": {
          "const": "docs/roadmap/QTT_Roadmap_Execution_State_Controller_v1_0.json#/roadmap_range_currentization/1"

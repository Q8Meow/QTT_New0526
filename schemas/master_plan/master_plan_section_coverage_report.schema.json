  "properties": {
    "report_type": { "const": "MASTER_PLAN_SECTION_COVERAGE_REPORT" },
    "report_version": { "const": "MASTER_PLAN_SECTION_COVERAGE_REPORT_V1" },
    "deterministic_output": { "const": true },
    "generated_by": { "const": "tools/build_master_plan_section_coverage_report.py" },
    "generated_at_utc": { "const": "STATIC_DETERMINISTIC_NO_WALL_CLOCK" },
    "source_documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_plan",
        "registry",
        "master_plan_line_count",
        "master_plan_file_size_bytes",
        "master_plan_section_count",
        "master_plan_required_markers"
      ],
      "properties": {
        "master_plan": { "const": "docs/master_plan/QTT_MasterPlan_Current.md" },
        "registry": {
          "const": "docs/master_plan/completion/QTTSectionCoverageRegistry.yaml"
        },
        "master_plan_line_count": { "type": "integer" },
        "master_plan_file_size_bytes": { "type": "integer" },
        "master_plan_section_count": { "type": "integer" },
        "master_plan_required_markers": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_name",
        "schema_version",
        "coverage_model",
        "entry_count"
      ],
      "properties": {
        "registry_name": { "const": "QTTSectionCoverageRegistry" },
        "schema_version": { "const": 1 },
        "coverage_model": { "const": "SECTION_CAPABILITY_COVERAGE_ROUTING" },

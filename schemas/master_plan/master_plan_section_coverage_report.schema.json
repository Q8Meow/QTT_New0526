      "enum": [
        "EXECUTABLE_IMPLEMENTATION",
        "STATIC_CONTRACT",
        "SOURCE_EVIDENCE_DEPENDENT",
        "RUNTIME_RECEIPT_DEPENDENT",
        "OWNER_APPROVAL_DEPENDENT",
        "POLICY_ONLY",
        "RESEARCH_CANDIDATE",
        "QUARANTINE_REQUIRED",
        "RETIRED_NOT_USEFUL"
      ]

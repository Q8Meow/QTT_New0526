        "no_runtime_live_order_profit_authority_created_flag": { "const": true },
        "no_source_connector_replay_paper_authority_created_flag": { "const": true },
        "no_quantum_backend_or_simulator_execution_created_flag": { "const": true },
        "no_master_plan_text_mutation_flag": { "const": true }

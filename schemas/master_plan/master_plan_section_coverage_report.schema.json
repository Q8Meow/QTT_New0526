{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/master_plan/master_plan_section_coverage_report.schema.json",
  "title": "MasterPlanSectionCoverageReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_type",
    "report_version",
    "deterministic_output",
    "generated_by",
    "generated_at_utc",
    "source_documents",
    "registry",
    "route_map",
    "route_map_summary",
    "authority_boundary",
    "coverage_summary",
    "coverage_entries",
    "section_coverage"

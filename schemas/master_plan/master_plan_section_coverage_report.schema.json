    "current_status": {
      "enum": [
        "NOT_STARTED",
        "PARTIAL",
        "STATIC_CONTRACT_IMPLEMENTED",
        "BLOCKED_SOURCE_EVIDENCE",
        "BLOCKED_REPLAY_PAPER_EVIDENCE",
        "BLOCKED_RUNTIME_RECEIPT",
        "BLOCKED_OWNER_APPROVAL",
        "RESEARCH_ROUTED",
        "QUARANTINED_UNPROVEN",
        "RETIRED_NOT_USEFUL",
        "COMPLETE_VERIFIED"
      ]

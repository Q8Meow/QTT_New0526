{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/schemas/connectors/order_intent_execution_router_scaffolding.schema.json",
  "title": "Static Order Intent Execution Router Scaffolding Schema",
  "description": "Static/offline scaffold for typed order-intent placeholders and execution-router gate placeholders. It creates no source retrieval, source acceptance execution, connector semantic binding, private-state fetch, live signer path, venue write connectivity, final order release, or order execution authority.",

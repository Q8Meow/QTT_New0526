{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtt.local/schemas/connectors/order_intent_execution_router_scaffolding.schema.json",
  "title": "Static Order Intent Execution Router Scaffolding Schema",
  "description": "Static/offline scaffold for typed order-intent placeholders and execution-router gate placeholders. It creates no source retrieval, source acceptance execution, connector semantic binding, private-state fetch, live signer path, venue write connectivity, final order release, or order execution authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fixture_id": { "const": "SYNTHETIC_PR25_ORDER_INTENT_EXECUTION_ROUTER_SCAFFOLD_FIXTURE" },
    "fixture_version": { "const": "PR25_ORDER_INTENT_EXECUTION_ROUTER_FIXTURE_V1" },
    "fixture_authority_class": { "const": "SYNTHETIC_NON_AUTHORITATIVE_FIXTURE_NOT_ORDER_AUTHORITY_NOT_SOURCE_FACT" },
    "mode": { "const": "SOURCE_REQUIRED" },
    "execution": { "const": "DISABLED" },
    "schema_authority_class": { "const": "STATIC_SCHEMA_CONTRACT_ONLY_NOT_ORDER_EXECUTION_AUTHORITY" },
    "surface_kind": { "const": "ORDER_INTENT_EXECUTION_ROUTER_STATIC_SCAFFOLD" },
    "deterministic_output": { "const": true },
    "runtime_resolver_snapshot_reference": { "const": "UNBOUND" },
    "contains_runtime_resolver_snapshot": { "const": false },
    "contains_replay_result_packet": { "const": false },
    "contains_paper_result_packet": { "const": false },
    "contains_runtime_cash_receipt": { "const": false },
    "scope_flags": { "$ref": "#/$defs/scope_flags" },
    "forbidden_action_flags": { "$ref": "#/$defs/false_flag_map" },
    "fixture_no_claim_flags": { "$ref": "#/$defs/false_flag_map" },
    "order_intent_placeholders": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/order_intent_placeholder" }
    },
    "execution_router_gate_placeholders": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/execution_router_gate_placeholder" }
    },
    "validation_hook_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "fixture_id",
    "fixture_version",
    "fixture_authority_class",
    "mode",
    "execution",
    "schema_authority_class",
    "surface_kind",
    "deterministic_output",
    "runtime_resolver_snapshot_reference",
    "contains_runtime_resolver_snapshot",
    "contains_replay_result_packet",
    "contains_paper_result_packet",
    "contains_runtime_cash_receipt",
    "scope_flags",
    "forbidden_action_flags",
    "fixture_no_claim_flags",
    "order_intent_placeholders",
    "execution_router_gate_placeholders",
    "validation_hook_ids"
  ],
  "$defs": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z0-9_:.-]+$"
    },
    "source_required": { "const": "SOURCE_REQUIRED" },
    "unbound": { "const": "UNBOUND" },
    "disabled": { "const": "DISABLED" },
    "false_flag_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "const": false }
    },
    "scope_flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_required": { "const": true },
        "execution_disabled": { "const": true },
        "scaffold_only": { "const": true },
        "deterministic_static_fixture_only": { "const": true },
        "synthetic_records_only": { "const": true },
        "order_intent_placeholder_only": { "const": true },
        "execution_router_gate_placeholder_only": { "const": true },
        "final_order_submission_authority_disabled": { "const": true },
        "accepted_source_evidence_required_before_semantic_binding": { "const": true },
        "accepted_source_evidence_present": { "const": false },
        "source_retrieval_allowed": { "const": false },
        "source_acceptance_allowed": { "const": false },
        "connector_binding_allowed": { "const": false },
        "connector_semantic_binding_allowed": { "const": false },
        "runtime_use_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "live_use_allowed": { "const": false },
        "private_state_fetch_allowed": { "const": false },
        "order_execution_allowed": { "const": false },
        "profit_claim_allowed": { "const": false }
      },
      "required": [
        "source_required",
        "execution_disabled",
        "scaffold_only",
        "deterministic_static_fixture_only",
        "synthetic_records_only",
        "order_intent_placeholder_only",
        "execution_router_gate_placeholder_only",
        "final_order_submission_authority_disabled",
        "accepted_source_evidence_required_before_semantic_binding",
        "accepted_source_evidence_present",
        "source_retrieval_allowed",
        "source_acceptance_allowed",
        "connector_binding_allowed",
        "connector_semantic_binding_allowed",
        "runtime_use_allowed",
        "runtime_execution_allowed",
        "live_use_allowed",
        "private_state_fetch_allowed",
        "order_execution_allowed",
        "profit_claim_allowed"
      ]
    },
    "source_required_order_semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order_intent_semantics": { "$ref": "#/$defs/source_required" },
        "order_type_semantics": { "$ref": "#/$defs/source_required" },
        "order_side_semantics": { "$ref": "#/$defs/source_required" },
        "order_quantity_semantics": { "$ref": "#/$defs/source_required" },
        "order_price_semantics": { "$ref": "#/$defs/source_required" },
        "order_time_in_force_semantics": { "$ref": "#/$defs/source_required" },
        "order_lifecycle_semantics": { "$ref": "#/$defs/source_required" },
        "router_gate_semantics": { "$ref": "#/$defs/source_required" },
        "final_order_release_semantics": { "$ref": "#/$defs/source_required" },
        "live_signer_path_semantics": { "$ref": "#/$defs/source_required" },
        "venue_write_connectivity_semantics": { "$ref": "#/$defs/source_required" }
      },
      "required": [
        "order_intent_semantics",
        "order_type_semantics",
        "order_side_semantics",
        "order_quantity_semantics",
        "order_price_semantics",
        "order_time_in_force_semantics",
        "order_lifecycle_semantics",
        "router_gate_semantics",
        "final_order_release_semantics",
        "live_signer_path_semantics",
        "venue_write_connectivity_semantics"
      ]
    },
    "order_intent_placeholder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent_contract_type": { "const": "VENUE_NEUTRAL_ORDER_INTENT_PLACEHOLDER_CONTRACT" },
        "intent_contract_id": { "$ref": "#/$defs/record_id" },
        "schema_state": { "const": "SCAFFOLD_ONLY" },
        "intent_state": { "const": "PLACEHOLDER_ONLY_NOT_RUNTIME_INTENT" },
        "semantic_binding_state": { "$ref": "#/$defs/unbound" },
        "runtime_state": { "$ref": "#/$defs/disabled" },
        "source_required_order_intent_fields": { "$ref": "#/$defs/source_required_order_semantics" },
        "venue_reference": { "$ref": "#/$defs/unbound" },
        "market_reference": { "$ref": "#/$defs/unbound" },
        "contract_reference": { "$ref": "#/$defs/unbound" },
        "event_reference": { "$ref": "#/$defs/unbound" },
        "connector_reference": { "$ref": "#/$defs/unbound" },
        "order_payload_reference": { "$ref": "#/$defs/unbound" },
        "risk_gate_reference": { "$ref": "#/$defs/unbound" },
        "execution_router_reference": { "$ref": "#/$defs/unbound" },
        "order_intent_runtime_allowed": { "const": false },
        "order_execution_allowed": { "const": false },
        "order_submission_allowed": { "const": false },
        "final_order_release_allowed": { "const": false },
        "contains_order_instruction": { "const": false },
        "contains_order_receipt": { "const": false },
        "contains_order_submission_payload": { "const": false },
        "contains_accepted_source_fact": { "const": false }
      },
      "required": [
        "intent_contract_type",
        "intent_contract_id",
        "schema_state",
        "intent_state",
        "semantic_binding_state",
        "runtime_state",
        "source_required_order_intent_fields",
        "venue_reference",
        "market_reference",
        "contract_reference",
        "event_reference",
        "connector_reference",
        "order_payload_reference",
        "risk_gate_reference",
        "execution_router_reference",
        "order_intent_runtime_allowed",
        "order_execution_allowed",
        "order_submission_allowed",
        "final_order_release_allowed",
        "contains_order_instruction",
        "contains_order_receipt",
        "contains_order_submission_payload",
        "contains_accepted_source_fact"
      ]
    },
    "execution_router_gate_placeholder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "router_contract_type": { "const": "EXECUTION_ROUTER_GATE_PLACEHOLDER_CONTRACT" },
        "router_contract_id": { "$ref": "#/$defs/record_id" },
        "router_state": { "const": "GATE_PLACEHOLDER_ONLY_NOT_EXECUTABLE" },
        "semantic_binding_state": { "$ref": "#/$defs/unbound" },
        "runtime_state": { "$ref": "#/$defs/disabled" },
        "source_required_order_intent_fields": { "$ref": "#/$defs/source_required_order_semantics" },
        "order_intent_contract_reference": { "$ref": "#/$defs/unbound" },
        "risk_gate_reference": { "$ref": "#/$defs/unbound" },
        "connector_capability_reference": { "$ref": "#/$defs/unbound" },
        "venue_reference": { "$ref": "#/$defs/unbound" },
        "venue_write_connectivity_reference": { "$ref": "#/$defs/unbound" },
        "live_signer_path_reference": { "$ref": "#/$defs/unbound" },
        "final_order_release_reference": { "$ref": "#/$defs/unbound" },
        "gate_evaluation_allowed": { "const": false },
        "final_order_submission_authority_present": { "const": false },
        "final_order_release_allowed": { "const": false },
        "order_execution_allowed": { "const": false },
        "order_submission_allowed": { "const": false },
        "order_cancel_allowed": { "const": false },
        "order_reduce_allowed": { "const": false },
        "order_close_allowed": { "const": false },
        "order_replace_allowed": { "const": false },
        "order_amend_allowed": { "const": false },
        "live_signer_path_present": { "const": false },
        "venue_write_connectivity_present": { "const": false },
        "contains_order_instruction": { "const": false },
        "contains_order_receipt": { "const": false }
      },
      "required": [
        "router_contract_type",
        "router_contract_id",
        "router_state",
        "semantic_binding_state",
        "runtime_state",
        "source_required_order_intent_fields",
        "order_intent_contract_reference",
        "risk_gate_reference",
        "connector_capability_reference",
        "venue_reference",
        "venue_write_connectivity_reference",
        "live_signer_path_reference",
        "final_order_release_reference",
        "gate_evaluation_allowed",
        "final_order_submission_authority_present",
        "final_order_release_allowed",
        "order_execution_allowed",
        "order_submission_allowed",
        "order_cancel_allowed",
        "order_reduce_allowed",
        "order_close_allowed",
        "order_replace_allowed",
        "order_amend_allowed",
        "live_signer_path_present",
        "venue_write_connectivity_present",
        "contains_order_instruction",
        "contains_order_receipt"
      ]
    }
  }
}

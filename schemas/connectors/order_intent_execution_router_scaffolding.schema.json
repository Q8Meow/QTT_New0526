    "fixture_version": { "const": "PR25_ORDER_INTENT_EXECUTION_ROUTER_FIXTURE_V1" },
    "fixture_authority_class": { "const": "SYNTHETIC_NON_AUTHORITATIVE_FIXTURE_NOT_ORDER_AUTHORITY_NOT_SOURCE_FACT" },
    "mode": { "const": "SOURCE_REQUIRED" },
    "execution": { "const": "DISABLED" },
    "schema_authority_class": { "const": "STATIC_SCHEMA_CONTRACT_ONLY_NOT_ORDER_EXECUTION_AUTHORITY" },
    "surface_kind": { "const": "ORDER_INTENT_EXECUTION_ROUTER_STATIC_SCAFFOLD" },
    "deterministic_output": { "const": true },
    "runtime_resolver_snapshot_reference": { "const": "UNBOUND" },
    "contains_runtime_resolver_snapshot": { "const": false },
    "contains_replay_result_packet": { "const": false },
    "contains_paper_result_packet": { "const": false },
    "contains_runtime_cash_receipt": { "const": false },
    "scope_flags": { "$ref": "#/$defs/scope_flags" },
    "forbidden_action_flags": { "$ref": "#/$defs/forbidden_action_flags" },
    "fixture_no_claim_flags": { "$ref": "#/$defs/fixture_no_claim_flags" },
    "order_intent_placeholders": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/order_intent_placeholder" }
    },
    "execution_router_gate_placeholders": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/execution_router_gate_placeholder" }
    },
    "validation_hook_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "fixture_id",
    "fixture_version",
    "fixture_authority_class",
    "mode",
    "execution",
    "schema_authority_class",
    "surface_kind",
    "deterministic_output",
    "runtime_resolver_snapshot_reference",
    "contains_runtime_resolver_snapshot",

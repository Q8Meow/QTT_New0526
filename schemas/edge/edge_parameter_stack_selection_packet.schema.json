        "COMPATIBILITY_INCOMPLETE_DUPLICATE_INTERFACE",
        "COMPATIBILITY_INCOMPATIBLE_AUTHORITY_TRANSITION",
        "COMPATIBILITY_INCOMPATIBLE_SOURCE_FACT_BOUNDARY",
        "COMPATIBILITY_INCOMPATIBLE_CONNECTOR_SEMANTIC_BOUNDARY",
